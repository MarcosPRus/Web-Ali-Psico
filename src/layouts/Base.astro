---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
}
const props = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead {...props} />
  </head>
  <body>
    <a href="#contenido" class="skip-link">Saltar al contenido</a>
    <!-- Recortes dibujados a mano para fotos en arco: cima descentrada, lados que ondulan, base que no es recta -->
    <svg class="recortes" width="0" height="0" aria-hidden="true" focusable="false">
      <clipPath id="arco-mano" clipPathUnits="objectBoundingBox">
        <path d="M0.04,0.965 C0.01,0.84 0.045,0.66 0.02,0.47 C0.0,0.24 0.13,0.035 0.42,0.018 C0.76,0.0 0.985,0.15 0.975,0.39 C0.968,0.56 0.998,0.78 0.968,0.958 C0.88,0.995 0.64,0.978 0.46,0.99 C0.27,1.0 0.11,0.988 0.04,0.965 Z" />
      </clipPath>
      <clipPath id="arco-mano-inv" clipPathUnits="objectBoundingBox">
        <path d="M0.035,0.04 C0.11,0.008 0.33,0.022 0.52,0.012 C0.7,0.002 0.9,0.016 0.965,0.035 C0.99,0.2 0.958,0.38 0.98,0.55 C1.0,0.78 0.86,0.968 0.56,0.984 C0.25,0.999 0.02,0.86 0.022,0.62 C0.024,0.42 0.004,0.22 0.035,0.04 Z" />
      </clipPath>
    </svg>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />

    <script>
      // Aparición suave al hacer scroll (respeta "reducir movimiento")
      const els = document.querySelectorAll<HTMLElement>("[data-reveal]");
      if (!("IntersectionObserver" in window)) {
        els.forEach((el) => el.classList.add("is-in"));
      } else {
        const io = new IntersectionObserver(
          (entries) =>
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add("is-in");
                io.unobserve(e.target);
              }
            }),
          { rootMargin: "0px 0px -8% 0px", threshold: 0.08 },
        );
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
