---
interface Props {
  class?: string;
  tone?: "ink" | "light";
}
const { class: className, tone = "ink" } = Astro.props;
---

<span class:list={["logo", `tone-${tone}`, className]}>
  <span class="name">Alicia Lozano</span>
  <span class="role">— Psicóloga</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    font-size: 1.25rem;
    line-height: 1;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .name {
    font-weight: 700;
  }
  .role {
    font-weight: 400;
    color: var(--gris);
  }
  .tone-light .role {
    color: #bdbdbd;
  }
  @media (max-width: 26rem) {
    .role {
      display: none;
    }
  }
</style>
