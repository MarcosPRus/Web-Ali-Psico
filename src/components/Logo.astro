---
/**
 * Logo «ali · PSICOLOGÍA» (guía de octubre de 2026, carpeta «Logo ali»).
 * - horizontal + color: cabecera y menú móvil. Firma en morado (--lilac-ink, #815799)
 *   en lugar del terracota original; «PSICOLOGÍA» en tinta 2.
 * - apilado + light: pie sobre fondo vino. Colores originales de la versión
 *   «sobre-vino» (firma papel, PSICOLOGÍA rubor).
 */
import logo from "./logo-ali.json";

interface Props {
  class?: string;
  variant?: "horizontal" | "apilado";
  tone?: "color" | "light";
}
const { class: className, variant = "horizontal", tone = "color" } = Astro.props;

const src = variant === "apilado" ? logo.apiladoVino : logo.horizontal;
const fills =
  tone === "light"
    ? { firma: "#fcf9f4", psicologia: "#f2c6b6" }
    : { firma: "var(--lilac-ink)", psicologia: "var(--ink-2)" };
---

<span class:list={["logo", `v-${variant}`, className]}>
  <svg viewBox={src.viewBox} role="img" aria-label="Alicia Lozano · Psicología">
    <path fill={fills.firma} d={src.firma} />
    <path fill={fills.psicologia} d={src.psicologia} />
  </svg>
</span>

<style>
  .logo {
    display: inline-flex;
    line-height: 0;
  }
  svg {
    display: block;
    height: auto;
  }
  /* Guía: horizontal mínimo 150 px de ancho; apilado mínimo 90 px */
  .v-horizontal svg {
    width: 9.6rem;
  }
  .v-apilado svg {
    width: 7.5rem;
  }
</style>
