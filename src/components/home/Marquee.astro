---
interface Props {
  items?: string[];
}
const {
  items = [
    "Ansiedad",
    "Autoestima",
    "Gestión emocional",
    "Relaciones",
    "Trastornos de la conducta alimentaria",
    "Imagen corporal",
    "Psiconutrición",
    "Terapia online",
  ],
} = Astro.props;
---

<div class="marquee" aria-hidden="true">
  <div class="track">
    {
      [0, 1].map(() => (
        <ul>
          {items.map((it, i) => (
            <li>
              <span class:list={[i % 2 && "it"]}>{it}</span>
              <span class="dot" />
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</div>

<style>
  .marquee {
    position: relative;
    /* una cinta de esmalte cobalto moteado */
    background: var(--moteado-claro) center / 260px, var(--cobalto);
    color: var(--esmalte);
    padding-block: 1.1rem;
    rotate: -1.6deg;
    margin-inline: -2rem;
    box-shadow: var(--vidriado), 0 20px 40px -24px rgb(36 57 127 / 0.6);
    z-index: 2;
    overflow: hidden;
  }
  .track {
    display: flex;
    width: max-content;
    animation: marquee 48s linear infinite;
  }
  .marquee:hover .track {
    animation-play-state: paused;
  }
  ul {
    display: flex;
    list-style: none;
    padding: 0;
  }
  li {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding-right: 2rem;
    font-family: var(--serif);
    font-size: clamp(1.4rem, 1rem + 1.6vw, 2.4rem);
    font-weight: 330;
    white-space: nowrap;
    letter-spacing: -0.01em;
  }
  .it {
    font-style: italic;
    color: var(--mantequilla);
  }
  /* una gota de esmalte, nunca un punto perfecto */
  .dot {
    width: 0.42em;
    height: 0.36em;
    border-radius: 55% 45% 60% 40% / 50% 60% 40% 50%;
    background: var(--naranja);
  }
  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }
</style>
