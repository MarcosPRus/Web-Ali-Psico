---
import Media from "../art/Media.astro";
import Shape from "../art/Shape.astro";
import Seal from "../Seal.astro";
import Icon from "../Icon.astro";
---

<section class="hero">
  <div class="blob" aria-hidden="true"></div>
  <div class="container wide grid">
    <div class="copy">
      <p class="eyebrow" data-reveal>Psicóloga sanitaria · Sevilla y online</p>
      <h1 data-reveal style="--d:1">
        Hacer las paces con la&nbsp;comida <em class="nw">y con tu cuerpo</em>.
      </h1>
      <p class="lead" data-reveal style="--d:2">
        Soy Alicia, psicóloga especializada en trastornos de la conducta alimentaria e imagen corporal. Te acompaño a
        salir de la guerra con la comida, sin dietas y sin juicios.
      </p>
      <div class="cta" data-reveal style="--d:3">
        <a href="/contacto" class="btn">Pide tu primera cita <Icon name="arrow" class="arrow" /></a>
        <a href="/sobre-mi" class="btn ghost">Conóceme</a>
      </div>
      <ul class="places" data-reveal style="--d:4" aria-label="Dónde paso consulta">
        <li><Icon name="pin" size={16} /> Tomares</li>
        <li><Icon name="pin" size={16} /> Dos Hermanas</li>
        <li><Icon name="pin" size={16} /> Mairena</li>
        <li><Icon name="video" size={16} /> Online</li>
      </ul>
    </div>

    <div class="visual" data-reveal style="--d:2">
      <Shape name="sun" color="var(--butter)" size="clamp(7rem, 14vw, 11rem)" class="sun" />
      <Media
        scene="retrato"
        shape="arch"
        ratio="4 / 5"
        loading="eager"
        alt="Ilustración provisional: retrato de Alicia"
        class="portrait"
      />
      <Shape name="sprig" color="var(--sage-ink)" size="clamp(4rem, 7vw, 6rem)" class="sprig float" style="--t:10s;--r:12deg" />
      <Shape name="star" color="var(--terracotta)" size="clamp(2.5rem, 4vw, 3.4rem)" class="star float" style="--t:7s" />
      <Seal class="seal" size="clamp(7rem, 11vw, 9.5rem)"><span>a</span></Seal>
      <p class="note">
        <span class="script">“No tienes que hacerlo sola.”</span>
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    margin-top: calc(-1 * var(--header-h));
    padding-top: calc(var(--header-h) + clamp(2rem, 5vw, 4.5rem));
    padding-bottom: clamp(4rem, 8vw, 7rem);
    overflow: clip;
  }
  .blob {
    position: absolute;
    width: min(62rem, 110vw);
    aspect-ratio: 1;
    right: -18rem;
    top: -16rem;
    border-radius: 47% 53% 42% 58% / 52% 38% 62% 48%;
    background: radial-gradient(circle at 40% 45%, color-mix(in oklab, var(--lilac) 70%, var(--blush)), color-mix(in oklab, var(--lilac) 25%, var(--oat)) 70%);
    opacity: 0.75;
    animation: morph 24s ease-in-out infinite alternate;
    z-index: -1;
  }
  @keyframes morph {
    to {
      border-radius: 58% 42% 55% 45% / 42% 58% 42% 58%;
      transform: rotate(12deg) scale(1.05);
    }
  }
  .grid {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }
  .copy {
    display: grid;
    gap: 1.6rem;
    justify-items: start;
  }
  h1 {
    max-width: 13ch;
  }
  .nw {
    white-space: nowrap;
  }
  .lead {
    max-width: 40ch;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .places {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    font-size: 0.92rem;
    color: var(--ink-2);
    margin-top: 0.5rem;
  }
  .places li {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .places :global(.icon) {
    color: var(--terracotta-ink);
  }

  .visual {
    position: relative;
    width: min(100%, 30rem);
    justify-self: center;
    margin-right: clamp(0rem, 3vw, 2rem);
  }
  .visual :global(.portrait) {
    box-shadow: var(--shadow);
  }
  .visual :global(.sun) {
    position: absolute;
    top: -2.5rem;
    right: -3rem;
    animation: spin 40s linear infinite;
    z-index: -1;
  }
  .visual :global(.sprig) {
    position: absolute;
    right: -2.5rem;
    bottom: 22%;
  }
  .visual :global(.star) {
    position: absolute;
    left: -1.2rem;
    top: 18%;
  }
  .visual :global(.seal) {
    position: absolute;
    left: -3.5rem;
    bottom: -2.5rem;
  }
  .visual :global(.seal .core span) {
    font-size: 1.1em;
  }
  .note {
    position: absolute;
    right: -1.5rem;
    bottom: -1.4rem;
    padding: 0.85rem 1.2rem;
    border-radius: 999px;
    background: var(--paper);
    box-shadow: var(--shadow);
    font-size: 1.15rem;
    rotate: -3deg;
  }

  @media (max-width: 60rem) {
    .grid {
      grid-template-columns: 1fr;
    }
    .visual {
      width: min(80%, 24rem);
      margin: 2rem auto 1rem;
    }
    .visual :global(.seal) {
      left: -2rem;
    }
    .note {
      right: -0.5rem;
      font-size: 1rem;
    }
  }
  @media (max-width: 40rem) {
    .visual :global(.seal) {
      display: none;
    }
  }
</style>
