---
import Media from "../art/Media.astro";
import Shape from "../art/Shape.astro";
import Seal from "../Seal.astro";
import Icon from "../Icon.astro";
import Gato from "../art/Gato.astro";
---

<section class="hero">
  <div class="charco" aria-hidden="true"></div>
  <div class="container wide grid">
    <div class="copy">
      <p class="eyebrow" data-reveal>Psicóloga sanitaria · Sevilla y online</p>
      <h1 data-reveal style="--d:1">
        Un espacio para <span class="nw">hacer las paces</span> <em class="sonrisa">contigo</em>.
      </h1>
      <p class="lead" data-reveal style="--d:2">
        Soy Alicia, psicóloga sanitaria. Te acompaño cuando la ansiedad, la autoestima o tus relaciones pesan más de la
        cuenta, y estoy especializada en la relación con la comida y con el cuerpo. Sin juicios y a tu ritmo.
      </p>
      <div class="cta" data-reveal style="--d:3">
        <a href="/contacto" class="btn">Pide tu primera cita <Icon name="arrow" class="arrow" /></a>
        <a href="/sobre-mi" class="btn ghost">Conóceme</a>
      </div>
      <ul class="places" data-reveal style="--d:4" aria-label="Dónde paso consulta">
        <li><Icon name="pin" size={16} /> Tomares</li>
        <li><Icon name="pin" size={16} /> Dos Hermanas</li>
        <li><Icon name="pin" size={16} /> Mairena</li>
        <li><Icon name="video" size={16} /> Online</li>
      </ul>
    </div>

    <div class="visual" data-reveal style="--d:2">
      <span class="motas" aria-hidden="true"></span>
      <Media
        src="/img/ali-retrato.webp"
        shape="arch"
        ratio="4 / 5"
        loading="eager"
        alt="Alicia Lozano, psicóloga, sonriendo en su despacho"
        class="portrait"
      />
      <Shape name="flower" color="var(--lengua)" size="clamp(3.4rem, 6vw, 4.6rem)" class="flor float" style="--t:11s;--r:-8deg" />
      <Gato quien="maddy" size="clamp(5.5rem, 9vw, 7.5rem)" class="maddy" />
      <Seal class="seal" size="clamp(6.5rem, 10vw, 8.5rem)" text="psicología sanitaria ● sin juicios ● a tu ritmo ● " color="var(--cobalto)"><span>a</span></Seal>
      <p class="note mano">No tienes que hacerlo sola ♥</p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    margin-top: calc(-1 * var(--header-h));
    padding-top: calc(var(--header-h) + clamp(2rem, 5vw, 4.5rem));
    padding-bottom: clamp(4rem, 8vw, 7rem);
    overflow: clip;
  }
  /* un charco de esmalte celadón, como el del cuenco de flores caladas */
  .charco {
    position: absolute;
    width: min(56rem, 105vw);
    aspect-ratio: 1.1;
    right: -16rem;
    top: -14rem;
    border-radius: 47% 53% 42% 58% / 52% 38% 62% 48%;
    background: radial-gradient(circle at 38% 42%, var(--celadon-claro) 0 40%, color-mix(in oklab, var(--celadon) 70%, var(--bizcocho)) 75%);
    opacity: 0.9;
    animation: morph 26s ease-in-out infinite alternate;
    z-index: -1;
  }
  @keyframes morph {
    to {
      border-radius: 58% 42% 55% 45% / 42% 58% 42% 58%;
      transform: rotate(10deg) scale(1.04);
    }
  }
  .grid {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }
  .copy {
    display: grid;
    gap: 1.6rem;
    justify-items: start;
  }
  h1 {
    max-width: 15ch;
  }
  .nw {
    white-space: nowrap;
  }
  .lead {
    max-width: 40ch;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .places {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    font-size: 0.92rem;
    color: var(--ink-2);
    margin-top: 0.5rem;
  }
  .places li {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .places :global(.icon) {
    color: var(--cobalto);
  }

  .visual {
    position: relative;
    width: min(100%, 30rem);
    justify-self: center;
    margin-right: clamp(0rem, 3vw, 2rem);
  }
  /* el retrato es el jarrón del arco: borde de esmalte blanco */
  .visual :global(.portrait) {
    border: 0.7rem solid var(--esmalte);
    box-shadow: var(--shadow), inset 0 0 0 1px var(--line);
  }
  /* moteado de cobalto, como la tetera de Ali */
  .motas {
    position: absolute;
    width: 58%;
    aspect-ratio: 1;
    right: -14%;
    top: -9%;
    border-radius: 52% 48% 45% 55% / 48% 55% 45% 52%;
    background: var(--moteado) center / 150px, var(--esmalte);
    box-shadow: inset 0 0 0 1px var(--line);
    z-index: -1;
    rotate: 8deg;
  }
  .visual :global(.flor) {
    position: absolute;
    right: -1.6rem;
    top: 34%;
  }
  .visual :global(.maddy) {
    position: absolute;
    right: -2.2rem;
    bottom: -1.2rem;
    filter: drop-shadow(0 10px 14px rgb(29 26 30 / 0.18));
  }
  .visual :global(.seal) {
    position: absolute;
    left: -3.2rem;
    bottom: 12%;
  }
  .visual :global(.seal .core span) {
    font-size: 1.1em;
    color: var(--cobalto);
  }
  .note {
    position: absolute;
    left: 12%;
    bottom: -2.6rem;
    padding: 0.7rem 1.15rem;
    border-radius: var(--radius-pill);
    background: var(--esmalte);
    box-shadow: var(--shadow);
    font-size: 1.1rem;
    rotate: -3deg;
    color: var(--ciruela);
    white-space: nowrap;
  }

  @media (max-width: 60rem) {
    .grid {
      grid-template-columns: 1fr;
    }
    .visual {
      width: min(80%, 24rem);
      margin: 2rem auto 1rem;
    }
    .visual :global(.seal) {
      left: -2rem;
    }
    .note {
      left: 4%;
      font-size: 1rem;
    }
    .visual :global(.maddy) {
      right: -1.2rem;
    }
  }
  @media (max-width: 40rem) {
    .visual :global(.seal) {
      display: none;
    }
  }
</style>
