---
/**
 * Carrusel de reseñas de Google (anonimizadas: solo la inicial).
 * Los textos están en src/data/resenas.ts.
 * Sin autoplay: se mueve con los botones, deslizando o con las flechas del teclado.
 */
import SectionHead from "../SectionHead.astro";
import Icon from "../Icon.astro";
import Shape from "../art/Shape.astro";
import { RESENAS, GOOGLE } from "../../data/resenas";

const tones = ["blush", "lilac", "butter", "sage", "paper"];
const star = "M12 2.6l2.8 6 6.5.7-4.9 4.4 1.4 6.5L12 16.9l-5.8 3.3 1.4-6.5-4.9-4.4 6.5-.7z";
---

<section class="section resenas" aria-labelledby="resenas-title">
  <Shape name="flower" color="var(--butter)" size="7rem" class="r-flower" />
  <div class="container wide">
    <div class="head">
      <SectionHead eyebrow="Reseñas en Google">
        <span id="resenas-title">Lo que cuentan <em>otras personas</em></span>
        <Fragment slot="lead">
          Algunas de las reseñas que han dejado en Google. Solo mostramos la inicial, para cuidar su privacidad.
        </Fragment>
      </SectionHead>

      <div class="score" data-reveal style="--d:1">
        <p class="nota">
          <span class="num">{GOOGLE.nota}</span>
          <span class="stars" role="img" aria-label={`${GOOGLE.nota} de 5 estrellas`}>
            {[1, 2, 3, 4, 5].map(() => <svg viewBox="0 0 24 24" aria-hidden="true"><path d={star} /></svg>)}
          </span>
        </p>
        <p class="total">Media en Google, con {GOOGLE.total}</p>
        <a href={GOOGLE.url} class="link" target="_blank" rel="noopener">
          Ver todas en Google <Icon name="arrow-up-right" size={16} />
        </a>
      </div>
    </div>

    <div class="carousel" role="region" aria-roledescription="carrusel" aria-label="Reseñas de Google" data-carousel data-reveal>
      <ul class="track" tabindex="0">
        {
          RESENAS.map((r, i) => (
            <li class={`tone-${tones[i % tones.length]}`} role="group" aria-label={`Reseña ${i + 1} de ${RESENAS.length}`}>
              <figure>
                <span class="stars" role="img" aria-label={`${r.estrellas} de 5 estrellas`}>
                  {[1, 2, 3, 4, 5].map((n) => (
                    <svg viewBox="0 0 24 24" aria-hidden="true" class:list={[n > r.estrellas && "off"]}>
                      <path d={star} />
                    </svg>
                  ))}
                </span>
                <blockquote>
                  <p>{r.texto}</p>
                </blockquote>
                <figcaption>
                  <span class="ini" aria-hidden="true">{r.inicial}</span>
                  <span>
                    <strong>{r.inicial}.</strong>
                    <small>Reseña en Google</small>
                  </span>
                </figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
      <div class="controls">
        <button type="button" class="nav prev" data-prev aria-label="Reseña anterior">
          <Icon name="arrow" size={20} />
        </button>
        <button type="button" class="nav" data-next aria-label="Reseña siguiente">
          <Icon name="arrow" size={20} />
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((c) => {
    const track = c.querySelector<HTMLElement>(".track")!;
    const prev = c.querySelector<HTMLButtonElement>("[data-prev]")!;
    const next = c.querySelector<HTMLButtonElement>("[data-next]")!;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const step = () => {
      const card = track.querySelector("li")!;
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      return card.getBoundingClientRect().width + gap;
    };
    const update = () => {
      prev.disabled = track.scrollLeft < 4;
      next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
    };
    const go = (dir: number) => track.scrollBy({ left: dir * step(), behavior: reduce ? "auto" : "smooth" });
    prev.addEventListener("click", () => go(-1));
    next.addEventListener("click", () => go(1));
    track.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
    update();
  });
</script>

<style>
  .resenas {
    overflow: clip;
  }
  .resenas :global(.r-flower) {
    position: absolute;
    right: clamp(-2rem, -1vw, 0rem);
    top: clamp(2rem, 5vw, 4rem);
    rotate: 18deg;
    opacity: 0.8;
  }
  .head {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1.5rem 3rem;
    align-items: end;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .head :global(.section-head) {
    margin-bottom: 0;
  }

  /* Nota media */
  .score {
    display: grid;
    gap: 0.35rem;
    justify-items: start;
    padding: 1.25rem 1.5rem;
    border-radius: 1.6rem 1.6rem 1.6rem 0.4rem;
    background: var(--paper);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .nota {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }
  .num {
    font-family: var(--serif);
    font-size: var(--step-3);
    font-weight: 350;
    line-height: 1;
  }
  .total {
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  .score .link {
    font-size: var(--step--1);
    color: var(--terracotta-ink);
    margin-top: 0.35rem;
  }

  .stars {
    display: inline-flex;
    gap: 0.1rem;
  }
  .stars svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: var(--terracotta);
  }
  .stars svg.off,
  li .stars svg.off {
    fill: color-mix(in oklab, var(--ink) 18%, transparent);
  }

  /* Carrusel */
  .track {
    --gap: 1.25rem;
    list-style: none;
    display: flex;
    gap: var(--gap);
    margin: 0;
    padding: 0.5rem 0 1.5rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    border-radius: var(--radius);
  }
  .track::-webkit-scrollbar {
    display: none;
  }
  .track:focus-visible {
    outline: 2px solid var(--terracotta-ink);
    outline-offset: 4px;
  }
  .track li {
    flex: 0 0 calc((100% - 2 * var(--gap)) / 3);
    scroll-snap-align: start;
    display: flex;
    background: var(--bg);
    border-radius: 1.6rem 1.6rem 1.6rem 0.4rem;
    box-shadow: inset 0 0 0 1px var(--line), 0 14px 30px -24px rgb(47 33 39 / 0.55);
  }
  .track li:nth-child(even) {
    border-radius: 1.6rem 1.6rem 0.4rem 1.6rem;
  }
  .tone-blush { --bg: var(--blush); }
  .tone-lilac { --bg: var(--lilac); }
  .tone-butter { --bg: #f6e2ac; }
  .tone-sage { --bg: #cfd8c4; }
  .tone-paper { --bg: #fff; }

  figure {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 1.1rem;
    margin: 0;
    padding: clamp(1.5rem, 2.5vw, 2rem);
    width: 100%;
  }
  li .stars svg {
    width: 1rem;
    height: 1rem;
    fill: var(--terracotta-ink);
  }
  blockquote {
    margin: 0;
    position: relative;
  }
  blockquote p {
    font-family: var(--serif);
    font-size: clamp(1.05rem, 0.98rem + 0.3vw, 1.2rem);
    font-weight: 350;
    line-height: 1.5;
  }
  blockquote p::before {
    content: "“";
    font-style: italic;
    color: var(--terracotta-ink);
    margin-right: 0.05em;
  }
  blockquote p::after {
    content: "”";
    font-style: italic;
    color: var(--terracotta-ink);
  }
  figcaption {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid color-mix(in oklab, var(--ink) 12%, transparent);
  }
  .ini {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    background: var(--ink);
    color: var(--oat);
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.25rem;
    line-height: 1;
  }
  figcaption strong {
    display: block;
    font-weight: 600;
    line-height: 1.2;
  }
  figcaption small {
    display: block;
    font-size: var(--step--1);
    color: var(--ink-2);
  }

  .controls {
    display: flex;
    justify-content: flex-end;
    gap: 0.6rem;
  }
  .nav {
    display: grid;
    place-items: center;
    width: 3.1rem;
    height: 3.1rem;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1.5px var(--ink);
    transition: background-color 0.3s, color 0.3s, opacity 0.3s, transform 0.4s var(--ease);
  }
  .nav.prev :global(svg) {
    rotate: 180deg;
  }
  .nav:hover:not(:disabled) {
    background: var(--ink);
    color: var(--oat);
    transform: translateY(-2px);
  }
  .nav:focus-visible {
    outline: 2px solid var(--terracotta-ink);
    outline-offset: 3px;
  }
  .nav:disabled {
    opacity: 0.3;
    cursor: default;
  }

  @media (max-width: 60rem) {
    .head {
      grid-template-columns: 1fr;
      align-items: start;
    }
    .score {
      justify-self: start;
    }
    .track li {
      flex-basis: calc((100% - var(--gap)) / 2);
    }
  }
  @media (max-width: 36rem) {
    .track li {
      flex-basis: 86%;
    }
    .controls {
      justify-content: center;
    }
  }
</style>
