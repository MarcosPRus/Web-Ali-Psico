---
import Shape from "../art/Shape.astro";
const items = [
  {
    t: "Cercanía y responsabilidad",
    p: "Un trato humano y cercano, con el compromiso, la ética y el rigor que merece tu proceso.",
    s: "leaf",
    c: "var(--sage)",
  },
  {
    t: "Con evidencia",
    p: "Terapia cognitivo-conductual, ACT, DBT y autocompasión: herramientas que han demostrado funcionar.",
    s: "sun",
    c: "var(--butter)",
  },
  {
    t: "Con perspectiva de género",
    p: "Entendemos cómo la presión estética y los mandatos sociales atraviesan tu forma de mirarte.",
    s: "flower",
    c: "var(--lilac)",
  },
  {
    t: "A tu ritmo",
    p: "Sin prisas y sin juicios. Tú marcas el paso; yo pongo el mapa y la linterna.",
    s: "pebble",
    c: "var(--rose)",
  },
] as const;
---

<section class="section approach on-dark" aria-labelledby="approach-title">
  <Shape name="sun" color="var(--terracotta)" size="30rem" class="bg-sun" />
  <div class="container wide">
    <div class="top">
      <div data-reveal>
        <p class="eyebrow">Mi enfoque</p>
        <h2 id="approach-title">Una terapia que <em>te trata con cuidado</em></h2>
      </div>
      <blockquote data-reveal style="--d:1">
        <p>“Lo que te pasa tiene sentido. Entender de dónde viene es el primer paso para poder cambiarlo.”</p>
      </blockquote>
    </div>

    <ul class="grid">
      {
        items.map((it, i) => (
          <li data-reveal style={`--d:${i}`}>
            <div class="head">
              <span class="num">0{i + 1}</span>
              <Shape name={it.s} color={it.c} size="3rem" />
            </div>
            <h3>{it.t}</h3>
            <p>{it.p}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .approach {
    overflow: hidden;
    border-radius: var(--radius-xl);
    margin-inline: clamp(0.5rem, 1.5vw, 1.5rem);
  }
  .approach :global(.bg-sun) {
    position: absolute;
    left: -10rem;
    bottom: -14rem;
    opacity: 0.18;
    animation: spin 90s linear infinite;
  }
  .top {
    position: relative;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 2rem 5rem;
    align-items: end;
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }
  .top h2 {
    margin-top: 1rem;
  }
  blockquote {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 300;
    font-size: var(--step-2);
    line-height: 1.35;
    color: var(--blush);
    padding-left: 1.5rem;
    border-left: 2px solid var(--terracotta);
  }
  .grid {
    position: relative;
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }
  li {
    display: grid;
    gap: 0.9rem;
    align-content: start;
    padding: 1.75rem 1.5rem 2rem;
    border-radius: var(--radius-lg);
    background: color-mix(in oklab, var(--oat) 6%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--oat) 14%, transparent);
    transition: background-color 0.5s, transform 0.6s var(--ease);
  }
  li:hover {
    background: color-mix(in oklab, var(--oat) 11%, transparent);
    transform: translateY(-4px);
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }
  .num {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.1rem;
    color: var(--blush);
  }
  h3 {
    font-size: var(--step-2);
  }
  li p {
    color: color-mix(in oklab, var(--oat) 78%, transparent);
    font-size: 0.98rem;
  }
  @media (max-width: 64rem) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
    .top {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 36rem) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
