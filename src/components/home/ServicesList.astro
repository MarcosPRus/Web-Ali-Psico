---
import { getCollection } from "astro:content";
import Icon from "../Icon.astro";
import Shape from "../art/Shape.astro";

const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
const shapes = ["sun", "flower", "leaf", "blob", "pebble", "star"] as const;
---

<section class="section services" id="servicios" aria-labelledby="serv-title">
  <div class="container wide grid">
    <div class="intro" data-reveal>
      <p class="eyebrow">Cómo te puedo ayudar</p>
      <h2 id="serv-title">Terapia para lo que <em>te está costando</em></h2>
      <p class="lead">
        Terapia individual para adolescentes y personas adultas, con una especialización en trastornos de la conducta
        alimentaria e imagen corporal.
      </p>
      <a href="/servicios" class="btn ghost">Ver cómo trabajo <Icon name="arrow" class="arrow" /></a>
    </div>

    <ul class="list">
      {
        services.map((s, i) => (
          <li data-reveal style={`--d:${i % 3};--accent:var(--${s.data.accent === "blush" ? "rose" : s.data.accent})`}>
            <a href={`/servicios#${s.id}`}>
              <Shape name={shapes[i % shapes.length]} color="var(--accent)" size="1.9rem" class="bullet" />
              <span class="text">
                <span class="title">{s.data.title}</span>
                <span class="short">{s.data.short}</span>
              </span>
              <Icon name="arrow" size={20} class="go" />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr 1.35fr;
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: start;
  }
  .intro {
    position: sticky;
    top: 7rem;
    display: grid;
    gap: 1.4rem;
    justify-items: start;
  }
  .list {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .list li {
    border-bottom: 1px solid var(--line);
  }
  .list a {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.4rem 1rem;
    text-decoration: none;
    border-radius: var(--radius);
    isolation: isolate;
  }
  .list a::before {
    content: "";
    position: absolute;
    inset: 0.35rem 0;
    z-index: -1;
    border-radius: var(--radius);
    background: var(--paper);
    opacity: 0;
    transform: scaleX(0.96);
    transition: opacity 0.4s, transform 0.5s var(--ease);
  }
  .list a:hover::before,
  .list a:focus-visible::before {
    opacity: 1;
    transform: none;
  }
  .list :global(.bullet) {
    transition: transform 0.8s var(--ease);
  }
  .list a:hover :global(.bullet) {
    transform: rotate(90deg) scale(1.1);
  }
  .text {
    flex: 1;
    display: grid;
    gap: 0.25rem;
  }
  .title {
    font-family: var(--serif);
    font-size: var(--step-2);
    line-height: 1.15;
    letter-spacing: -0.015em;
  }
  .short {
    color: var(--ink-2);
    font-size: 0.98rem;
  }
  .list :global(.go) {
    opacity: 0.35;
    transition: opacity 0.3s, transform 0.5s var(--ease);
  }
  .list a:hover :global(.go) {
    opacity: 1;
    transform: translateX(4px);
  }
  @media (max-width: 56rem) {
    .grid {
      grid-template-columns: 1fr;
    }
    .intro {
      position: static;
    }
  }
  @media (max-width: 30rem) {
    .list a {
      padding-inline: 0.25rem;
      gap: 0.9rem;
    }
    .list :global(.go) {
      display: none;
    }
  }
</style>
