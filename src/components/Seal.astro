---
/** Sello circular con texto girando (decorativo). */
interface Props {
  text?: string;
  size?: string;
  class?: string;
  color?: string;
  bg?: string;
}
const {
  text = "psicología sin juicios ✺ TCA ✺ imagen corporal ✺ ",
  size = "9rem",
  class: className,
  color = "var(--ink)",
  bg = "var(--paper)",
} = Astro.props;
const id = "seal" + Math.random().toString(36).slice(2, 7);
---

<div class:list={["seal", className]} style={`--size:${size};--c:${color};--bg:${bg}`} aria-hidden="true">
  <svg viewBox="0 0 200 200">
    <defs>
      <path id={id} d="M100,100 m-74,0 a74,74 0 1,1 148,0 a74,74 0 1,1 -148,0" />
    </defs>
    <circle cx="100" cy="100" r="98" fill="var(--bg)" />
    <text>
      <textPath href={`#${id}`}>{text}</textPath>
    </text>
  </svg>
  <span class="core"><slot>✺</slot></span>
</div>

<style>
  .seal {
    position: relative;
    width: var(--size);
    aspect-ratio: 1;
    color: var(--c);
  }
  svg {
    width: 100%;
    height: 100%;
    animation: spin 22s linear infinite;
  }
  text {
    font-family: var(--sans);
    font-size: 13.7px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    fill: currentColor;
  }
  .core {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-family: var(--serif);
    font-size: calc(var(--size) * 0.26);
    font-style: italic;
    color: var(--cobalto);
  }
</style>
