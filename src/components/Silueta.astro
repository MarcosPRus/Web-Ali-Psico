---
/**
 * Maddy y Furi como siluetas que viven en las cornisas de la web.
 * Siempre decorativas (aria-hidden). El padre las coloca con `class`/`style`;
 * la base de la silueta es su borde inferior: se apoya sobre la cornisa
 * (la cola puede colgar por debajo).
 *
 *   <Silueta gato="furi" />                 sentado, mueve la cola y parpadea
 *   <Silueta gato="maddy" />                tumbada, respira y deja la cola colgando
 *   <Silueta gato="furi" pose="asomado" />  cabeza y patitas asomando por un borde
 *
 * Furi: negro entero, cabeza grande y redonda, ojos amarillo verdoso con brillo;
 *       nervioso → cola rápida y parpadeo.
 * Maddy: esmoquin (negra con hocico, babero y patas blancas), pelo largo en las
 *        mejillas, ojos cerrados de gusto; serena → respiración y cola lenta.
 */
interface Props {
  gato: "furi" | "maddy";
  pose?: "sentado" | "tumbada" | "asomado";
  size?: string;
  class?: string;
  style?: string;
}
const { gato, pose = gato === "furi" ? "sentado" : "tumbada", size, class: className, style = "" } = Astro.props;
const w = size ?? (pose === "tumbada" ? "10.5rem" : pose === "asomado" ? "5.5rem" : "6.25rem");

// Altura de los ojos de Furi según la pose
const y = pose === "asomado" ? 54 : 52;
---

<span class:list={["silueta", `s-${pose}`, className]} style={`--w:${w};${style}`} aria-hidden="true">
  {
    pose === "sentado" && (
      <svg viewBox="0 0 120 147">
        <path class="cola" d="M96,126 C118,128 124,146 120,162 C118,172 124,180 132,176" />
        <path d="M60,24 C64,23 68,24 72,26 L86,11 Q91,7 91,13 L89,37 C95,44 95,57 88,64 C98,80 106,108 102,130 C100,142 90,147 77,147 L43,147 C30,147 20,142 18,130 C14,108 22,80 32,64 C25,57 25,44 31,37 L29,13 Q29,7 34,11 L48,26 C52,24 56,23 60,24 Z" />
        <path class="oreja-dentro" d="M34,16 L45,28 L35,33 Z M86,16 L75,28 L85,33 Z" />
        <g class="ojos">
          <ellipse class="iris" cx="48" cy={y} rx="7" ry="8" />
          <ellipse class="iris" cx="72" cy={y} rx="7" ry="8" />
          <ellipse cx="48.5" cy={y + 1} rx="4" ry="5.5" />
          <ellipse cx="72.5" cy={y + 1} rx="4" ry="5.5" />
          <circle class="brillo" cx="50.5" cy={y - 2} r="1.8" />
          <circle class="brillo" cx="74.5" cy={y - 2} r="1.8" />
        </g>
        <path class="nariz" d="M57,63 h6 l-3,3 z" />
        <path class="dedos" d="M42,140 v6 M54,140 v6 M66,140 v6 M78,140 v6" />
      </svg>
    )
  }
  {
    pose === "tumbada" && (
      <svg viewBox="0 0 200 110">
        <path class="cola" d="M168,98 C180,106 176,126 180,140 C183,150 176,158 167,154" />
        <path class="respira" d="M46,110 C40,86 58,58 96,54 C134,50 170,62 182,82 C188,94 186,104 182,110 Z" />
        <path d="M30,50 L25,22 Q25,16 30,19 L47,32 C52,30 60,30 65,32 L82,19 Q87,16 87,22 L83,50 C88,58 88,70 82,79 C76,88 64,92 56,92 C48,92 36,88 30,79 C24,70 25,58 30,50 Z" />
        <path d="M27,70 l-6,4 7,1 -5,5 8,-1 M85,70 l6,4 -7,1 5,5 -8,-1" />
        <path class="oreja-dentro" d="M30,25 L43,33 L33,39 Z M82,25 L69,33 L79,39 Z" />
        <path class="blanco" d="M56,58 C60,58 63,61 64,66 C68,70 70,76 66,80 C62,84 59,82 56,80 C53,82 50,84 46,80 C42,76 44,70 48,66 C49,61 52,58 56,58 Z" />
        <path class="blanco" d="M44,92 C48,86 64,86 68,92 C70,100 64,108 56,110 C48,108 42,100 44,92 Z" />
        <ellipse class="nariz-rosa" cx="56" cy="69" rx="2.8" ry="2.1" />
        <path class="parpado" d="M38,52 q5,4.5 10,0 M64,52 q5,4.5 10,0" />
        <ellipse class="blanco" cx="80" cy="106" rx="11" ry="6" />
        <ellipse class="blanco" cx="101" cy="107" rx="10" ry="5.5" />
      </svg>
    )
  }
  {
    pose === "asomado" && (
      <svg viewBox="0 0 120 80">
        <path d="M60,24 C64,23 68,24 72,26 L86,11 Q91,7 91,13 L89,37 C94,44 96,60 92,80 L28,80 C24,60 26,44 31,37 L29,13 Q29,7 34,11 L48,26 C52,24 56,23 60,24 Z" />
        <path class="oreja-dentro" d="M34,16 L45,28 L35,33 Z M86,16 L75,28 L85,33 Z" />
        <g class="ojos">
          <ellipse class="iris" cx="48" cy={y} rx="7" ry="8" />
          <ellipse class="iris" cx="72" cy={y} rx="7" ry="8" />
          <ellipse cx="48.5" cy={y + 1} rx="4" ry="5.5" />
          <ellipse cx="72.5" cy={y + 1} rx="4" ry="5.5" />
          <circle class="brillo" cx="50.5" cy={y - 2} r="1.8" />
          <circle class="brillo" cx="74.5" cy={y - 2} r="1.8" />
        </g>
        <ellipse cx="38" cy="78" rx="11" ry="7" />
        <ellipse cx="82" cy="78" rx="11" ry="7" />
        <path class="dedos" d="M35,78 v4 M41,78 v4 M79,78 v4 M85,78 v4" />
      </svg>
    )
  }
</span>

<style>
  .silueta {
    position: absolute;
    display: block;
    width: var(--w);
    pointer-events: none;
    z-index: 3;
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    fill: var(--tinta);
  }
  .oreja-dentro {
    fill: #3b2f36;
  }
  .iris {
    fill: var(--ojo);
  }
  .brillo,
  .blanco {
    fill: var(--blanco);
  }
  .nariz {
    fill: #4a3d44;
  }
  .nariz-rosa {
    fill: #e48f9a;
  }
  .dedos {
    fill: none;
    stroke: #2e2e2e;
    stroke-width: 1.6;
    stroke-linecap: round;
  }
  .parpado {
    fill: none;
    stroke: var(--hueso);
    stroke-width: 2.2;
    stroke-linecap: round;
  }
  .ojos {
    transform-box: fill-box;
    transform-origin: center;
    animation: parpadeo 5.5s ease-in-out infinite;
  }
  .respira {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    animation: respira 4.5s ease-in-out infinite;
  }
  .cola {
    fill: none;
    stroke: var(--tinta);
    stroke-linecap: round;
    transform-box: view-box;
  }
  /* Furi: la cola sale por detrás del cuerpo y cuelga de la cornisa, nerviosa */
  .s-sentado .cola {
    stroke-width: 10;
    transform-origin: 96px 126px;
    animation: cola 3.6s ease-in-out infinite;
  }
  /* Maddy: cola gorda colgando, tranquila */
  .s-tumbada .cola {
    stroke-width: 15;
    transform-origin: 170px 100px;
    animation: cola-lenta 6s ease-in-out infinite;
  }
  /* al pasar el ratón por la zona, Furi mueve más rápido la cola */
  :global(:hover) > .s-sentado .cola {
    animation-duration: 1.6s;
  }
</style>
