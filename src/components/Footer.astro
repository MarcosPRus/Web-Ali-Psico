---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import Silueta from "./Silueta.astro";
import { CONTACT, LOCATIONS, NAV } from "../consts";
const year = new Date().getFullYear();
---

<footer class="site-footer on-tinta">
  <Silueta gato="maddy" size="clamp(8rem, 14vw, 11rem)" class="f-maddy" />
  <div class="container">
    <div class="top g12">
      <div class="about">
        <a href="/" class="brand"><Logo tone="light" /></a>
        <p class="muted">
          Psicología sanitaria en Sevilla y online. Especializada en trastornos de la conducta alimentaria e imagen
          corporal.
        </p>
        <div class="social">
          <a href={CONTACT.instagram} target="_blank" rel="noopener" aria-label="Instagram"><Icon name="instagram" /></a>
          <a href={CONTACT.whatsapp} target="_blank" rel="noopener" aria-label="WhatsApp"><Icon name="whatsapp" /></a>
          <a href={`mailto:${CONTACT.email}`} aria-label="Correo electrónico"><Icon name="mail" /></a>
          <a href={CONTACT.phoneHref} aria-label="Teléfono"><Icon name="phone" /></a>
        </div>
      </div>

      <div class="col consultas">
        <h2 class="col-title">Consultas</h2>
        <ul>
          {
            LOCATIONS.map((l) => (
              <li>
                <strong>{l.name}</strong>
                <span>{l.id === "online" ? "Videollamada, desde donde estés" : l.lines[0]}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="col">
        <h2 class="col-title">Contacto</h2>
        <ul>
          <li><a href={CONTACT.phoneHref}>{CONTACT.phone}</a></li>
          <li><a href={`mailto:${CONTACT.email}`} class="email">{CONTACT.email}</a></li>
          <li><a href={CONTACT.whatsapp} target="_blank" rel="noopener">WhatsApp</a></li>
        </ul>
        <h2 class="col-title">Explora</h2>
        <ul>
          {NAV.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        </ul>
      </div>
    </div>

    <p class="crisis">
      Si estás en una situación de crisis, llama al <a href="tel:024">024</a> (atención a la conducta suicida, gratuito
      y 24 h) o al <a href="tel:112">112</a>.
    </p>

    <div class="bottom">
      <p>© {year} Alicia Lozano · {CONTACT.license}</p>
      <ul>
        <li><a href="/aviso-legal">Aviso legal</a></li>
        <li><a href="/privacidad">Privacidad</a></li>
        <li><a href="/cookies">Cookies</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    margin-top: clamp(4rem, 8vw, 7rem);
    padding-top: clamp(4rem, 7vw, 6rem);
    isolation: isolate;
    background: transparent;
  }
  /* la base de la web: borde superior que ondula, sin rectas */
  .site-footer::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--tinta);
    -webkit-mask: var(--m-pie) 0 0 / 100% 100% no-repeat;
    mask: var(--m-pie) 0 0 / 100% 100% no-repeat;
  }
  .site-footer :global(.f-maddy) {
    right: clamp(2rem, 10vw, 9rem);
    bottom: calc(100% - 0.4rem);
  }
  .top {
    row-gap: 3rem;
  }
  .about {
    grid-column: 1 / span 5;
    display: grid;
    gap: 1.25rem;
    align-content: start;
    max-width: 26rem;
  }
  .brand {
    text-decoration: none;
  }
  .col {
    grid-column: span 3;
  }
  .consultas {
    grid-column: 7 / span 3;
  }
  .social {
    display: flex;
    gap: 0.6rem;
  }
  .social a {
    display: grid;
    place-items: center;
    width: 2.9rem;
    height: 2.75rem;
    border-radius: var(--mota);
    box-shadow: inset 0 0 0 1px #555;
    transition: background-color 0.25s, color 0.25s, border-radius 0.5s var(--ease);
  }
  .social a:nth-child(2n) {
    border-radius: var(--mota-b);
  }
  .social a:hover {
    background: var(--blanco);
    color: var(--tinta);
    border-radius: 50%;
  }
  .col-title {
    font-size: var(--t-sm);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--cobalto-suave);
    margin-bottom: 1rem;
    padding-top: 0.9rem;
    background: var(--trazo-gris) 0 0 / 100% 9px no-repeat;
  }
  .col-title:not(:first-child) {
    margin-top: 2rem;
  }
  .col ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .col li {
    display: grid;
  }
  .col li span {
    color: #bdbdbd;
    font-size: var(--t-sm);
  }
  .site-footer a {
    text-decoration-color: transparent;
    transition: text-decoration-color 0.25s;
  }
  .site-footer a:hover {
    text-decoration-color: currentColor;
  }
  .email {
    word-break: break-all;
  }
  .crisis {
    margin-top: 3.5rem;
    padding: 1rem 1.25rem;
    background: #1e1e1e;
    -webkit-mask: var(--m-forma-3) 0 0 / 100% 100% no-repeat;
    mask: var(--m-forma-3) 0 0 / 100% 100% no-repeat;
    color: #d6d6d6;
    font-size: var(--t-sm);
  }
  .crisis a {
    color: var(--blanco);
    font-weight: 700;
    text-decoration-color: currentColor !important;
  }
  .bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 2rem;
    font-size: var(--t-xs);
    color: #bdbdbd;
  }
  .bottom ul {
    list-style: none;
    padding: 0;
    display: flex;
    gap: 1.25rem;
  }
  @media (max-width: 56rem) {
    .about {
      grid-column: 1 / -1;
    }
    .consultas,
    .col {
      grid-column: span 6;
    }
  }
  @media (max-width: 34rem) {
    .consultas,
    .col {
      grid-column: 1 / -1;
    }
  }
</style>
