---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import Shape from "./art/Shape.astro";
import { CONTACT, LOCATIONS, NAV } from "../consts";
const year = new Date().getFullYear();
---

<footer class="site-footer on-dark">
  <Shape name="sun" color="var(--terracotta)" size="22rem" class="f-sun" />
  <div class="container wide">
    <div class="top">
      <div class="about">
        <a href="/"><Logo tone="light" /></a>
        <p class="muted">
          Psicología sanitaria en Sevilla y online. Un espacio para entenderte y hacer las paces contigo, con
          cercanía, evidencia y sin juicios.
        </p>
        <div class="social">
          <a href={CONTACT.instagram} target="_blank" rel="noopener" aria-label="Instagram"><Icon name="instagram" /></a>
          <a href={CONTACT.whatsapp} target="_blank" rel="noopener" aria-label="WhatsApp"><Icon name="whatsapp" /></a>
          <a href={`mailto:${CONTACT.email}`} aria-label="Correo electrónico"><Icon name="mail" /></a>
          <a href={CONTACT.phoneHref} aria-label="Teléfono"><Icon name="phone" /></a>
        </div>
      </div>

      <div class="col">
        <h2 class="col-title">Consultas</h2>
        <ul>
          {
            LOCATIONS.map((l) => (
              <li>
                <strong>{l.name}</strong>
                <span>{l.id === "online" ? "Videollamada, desde donde estés" : l.lines[0]}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="col">
        <h2 class="col-title">Contacto</h2>
        <ul>
          <li><a href={CONTACT.phoneHref}>{CONTACT.phone}</a></li>
          <li><a href={`mailto:${CONTACT.email}`} class="email">{CONTACT.email}</a></li>
          <li><a href={CONTACT.whatsapp} target="_blank" rel="noopener">WhatsApp</a></li>
        </ul>
        <h2 class="col-title">Explora</h2>
        <ul class="inline">
          {NAV.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        </ul>
      </div>
    </div>


    <div class="bottom">
      <p>© {year} Alicia Lozano · {CONTACT.license}</p>
      <ul class="inline">
        <li><a href="/aviso-legal">Aviso legal</a></li>
        <li><a href="/privacidad">Privacidad</a></li>
        <li><a href="/cookies">Cookies</a></li>
      </ul>
    </div>
  </div>
  <p class="giant" aria-hidden="true"><span data-t="Alicia"></span> <em data-t="Lozano"></em></p>
</footer>

<style>
  .site-footer {
    position: relative;
    overflow: hidden;
    padding-top: clamp(4rem, 8vw, 7rem);
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    margin-top: -2rem;
    z-index: 1;
  }
  .site-footer :global(.f-sun) {
    position: absolute;
    right: -6rem;
    top: -7rem;
    opacity: 0.35;
    animation: spin 80s linear infinite;
  }
  .top {
    position: relative;
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr;
    gap: clamp(2rem, 5vw, 5rem);
  }
  .about {
    display: grid;
    gap: 1.4rem;
    align-content: start;
    max-width: 26rem;
  }
  .about a {
    text-decoration: none;
  }
  .social {
    display: flex;
    gap: 0.6rem;
  }
  .social a {
    display: grid;
    place-items: center;
    width: 2.8rem;
    height: 2.8rem;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--oat) 30%, transparent);
    transition: background-color 0.3s, color 0.3s, transform 0.4s var(--ease);
  }
  .social a:hover {
    background: var(--blush);
    color: var(--wine);
    transform: translateY(-3px);
  }
  .col-title {
    font-family: var(--sans);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--blush);
    margin-bottom: 1rem;
  }
  .col-title:not(:first-child) {
    margin-top: 2rem;
  }
  .col ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.7rem;
  }
  .col li {
    display: grid;
  }
  .col li span {
    color: color-mix(in oklab, var(--oat) 70%, transparent);
    font-size: 0.95rem;
  }
  .col strong {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 1.2rem;
  }
  .site-footer a {
    text-decoration-color: transparent;
    transition: color 0.3s, text-decoration-color 0.3s;
  }
  .site-footer a:hover {
    text-decoration-color: currentColor;
  }
  .site-footer a:hover {
    color: var(--blush);
  }
  .email {
    word-break: break-all;
  }
  ul.inline {
    list-style: none;
    padding: 0;
    display: flex !important;
    flex-wrap: wrap;
    gap: 0.4rem 1.2rem;
  }
  .bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 2rem 1rem;
    font-size: 0.9rem;
    color: color-mix(in oklab, var(--oat) 70%, transparent);
  }
  .giant {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(4rem, 17.5vw, 20rem);
    line-height: 0.8;
    letter-spacing: -0.05em;
    white-space: nowrap;
    text-align: center;
    color: color-mix(in oklab, var(--oat) 9%, transparent);
    margin-bottom: -0.12em;
    user-select: none;
  }
  .giant [data-t]::before {
    content: attr(data-t);
  }
  .giant em {
    color: color-mix(in oklab, var(--blush) 22%, transparent);
  }
  @media (max-width: 56rem) {
    .top {
      grid-template-columns: 1fr 1fr;
    }
    .about {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 34rem) {
    .site-footer :global(.f-sun) {
      right: -13rem;
      opacity: 0.25;
    }
    .top {
      grid-template-columns: 1fr;
    }
  }
</style>
