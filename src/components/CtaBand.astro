---
import Icon from "./Icon.astro";
import Silueta from "./Silueta.astro";
import { CONTACT } from "../consts";
interface Props {
  title?: string;
}
const { title } = Astro.props;
---

<section class="cta" aria-labelledby="cta-title">
  <div class="container">
    <div class="panel on-celadon" data-reveal>
      <Silueta gato="furi" pose="asomado" size="clamp(4.5rem, 8vw, 6rem)" class="furi" />
      <div class="copy">
        <p class="eyebrow">Primer paso</p>
        <h2 id="cta-title">{title ? title : <>El primer paso puede ser <em>un mensaje</em>.</>}</h2>
      </div>
      <div class="side">
        <p class="lead">
          Escríbeme sin compromiso. Te respondo personalmente en menos de 48&nbsp;h laborables y, si quieres, hacemos
          una llamada breve para conocernos.
        </p>
        <div class="buttons">
          <a class="btn" href={CONTACT.whatsapp} target="_blank" rel="noopener"><Icon name="whatsapp" /> WhatsApp</a>
          <a class="btn ghost" href="/contacto">Formulario <Icon name="arrow" class="arrow" /></a>
        </div>
        <p class="alt">O llámame al <a href={CONTACT.phoneHref}>{CONTACT.phone}</a></p>
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    padding-top: clamp(5rem, 9vw, 8rem);
  }
  .panel {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: 2rem;
    align-items: end;
    padding: clamp(2.5rem, 6vw, 5rem);
    border-radius: var(--forma-bloque-b);
  }
  /* Furi se asoma por el borde: tímido, pero curioso */
  .panel :global(.furi) {
    left: clamp(2rem, 8vw, 6rem);
    bottom: calc(100% - 0.35rem);
  }
  .copy {
    grid-column: 1 / span 6;
    display: grid;
    gap: 1.25rem;
  }
  .side {
    grid-column: 8 / span 5;
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }
  .buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .ghost {
    --bg: transparent;
  }
  @media (max-width: 52rem) {
    .copy,
    .side {
      grid-column: 1 / -1;
    }
  }
</style>
