---
import Icon from "./Icon.astro";
import Shape from "./art/Shape.astro";
import Gato from "./art/Gato.astro";
import { CONTACT } from "../consts";
interface Props {
  title?: string;
}
const { title } = Astro.props;
---

<section class="cta section" aria-labelledby="cta-title">
  <div class="container wide">
    <div class="panel" data-reveal>
      <Gato quien="furi" pose="asomado" size="clamp(6rem, 10vw, 8rem)" class="furi-asoma" />
      <div class="copy">
        <p class="eyebrow">Primer paso</p>
        <h2 id="cta-title">
          {title ? title : <>El primer paso puede ser <em>un mensaje</em>.</>}
        </h2>
        <p class="lead">
          Escríbeme sin compromiso. Te respondo personalmente en menos de 48&nbsp;h laborables y, si quieres, hacemos una
          llamada breve para conocernos.
        </p>
        <div class="buttons">
          <a class="btn" href={CONTACT.whatsapp} target="_blank" rel="noopener">
            <Icon name="whatsapp" /> WhatsApp
          </a>
          <a class="btn ghost" href="/contacto">
            Formulario de contacto <Icon name="arrow" class="arrow" />
          </a>
        </div>
        <p class="alt">
          O llámame al <a href={CONTACT.phoneHref}>{CONTACT.phone}</a>
        </p>
      </div>
      <div class="art">
        <figure class="foto">
          <img src="/img/gatos/furi-sentado.webp" alt="Furi, el gato negro de Alicia, sentado y mirando con curiosidad" loading="lazy" decoding="async" width="800" height="1158" />
        </figure>
        <p class="furi-nota mano">Dar el primer paso da miedo.<br />A Furi también le costó ♥</p>
        <Shape name="flower" color="var(--lengua)" size="4rem" class="flor float" style="--t:9s" />
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    padding-bottom: calc(var(--section) + 1rem);
  }
  .panel {
    position: relative;
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
    padding: clamp(2rem, 6vw, 5.5rem);
    border-radius: var(--radius-xl);
    background: var(--celadon-claro);
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--celadon-ink) 14%, transparent);
  }
  /* Furi se asoma por el borde de la pieza: tímido, pero curioso */
  .panel :global(.furi-asoma) {
    position: absolute;
    top: 0;
    left: clamp(2rem, 8vw, 6rem);
    translate: 0 -90%;
    z-index: 2;
  }
  .panel :global(.furi-asoma svg) {
    animation: asomarse 6s ease-in-out infinite;
  }
  .panel::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--moteado) right bottom / 170px;
    opacity: 0.18;
    -webkit-mask: radial-gradient(circle at 100% 100%, #000, transparent 55%);
    mask: radial-gradient(circle at 100% 100%, #000, transparent 55%);
    pointer-events: none;
  }
  .copy {
    position: relative;
    display: grid;
    gap: 1.4rem;
    justify-items: start;
  }
  .copy .lead {
    color: var(--ink);
    max-width: 34ch;
  }
  .buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .alt {
    color: var(--ink);
  }
  .art {
    position: relative;
    max-width: 21rem;
    justify-self: center;
    width: 100%;
  }
  .foto {
    margin: 0;
    padding: 0.7rem;
    background: var(--esmalte);
    border-radius: var(--arch);
    box-shadow: var(--shadow);
    rotate: 2deg;
  }
  .foto img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 20%;
    border-radius: var(--arch);
  }
  .furi-nota {
    position: absolute;
    left: -2.5rem;
    bottom: -1.5rem;
    padding: 0.7rem 1.1rem;
    background: var(--esmalte);
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow);
    font-size: 1rem;
    line-height: 1.3;
    color: var(--ciruela);
    rotate: -4deg;
  }
  .art :global(.flor) {
    position: absolute;
    top: -1.4rem;
    right: -1.4rem;
  }
  @media (max-width: 52rem) {
    .panel {
      grid-template-columns: 1fr;
    }
    .art {
      max-width: 15rem;
      grid-row: 1;
      margin-top: 2rem;
    }
    .furi-nota {
      left: -1.5rem;
      font-size: 0.92rem;
    }
  }
</style>
