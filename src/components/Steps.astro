---
const steps = [
  {
    title: "Escríbeme",
    text: "Por WhatsApp, correo o el formulario. Cuéntame solo lo que te apetezca; con un «hola» basta.",
  },
  {
    title: "Hablamos 15 minutos",
    text: "Una llamada breve y gratuita para resolver dudas y ver si encajamos. Sin compromiso.",
  },
  {
    title: "Primera sesión",
    text: "Presencial en Tomares, Dos Hermanas o Mairena, u online. Empezamos a entender tu historia.",
  },
];
---

<ol class="steps">
  {
    steps.map((s, i) => (
      <li data-reveal style={`--d:${i}`}>
        <span class="mota-num">{i + 1}</span>
        <h3>{s.title}</h3>
        <p>{s.text}</p>
      </li>
    ))
  }
</ol>

<style>
  .steps {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--col-gap);
    counter-reset: paso;
  }
  li {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    padding-top: 1.25rem;
    background: var(--trazo) 0 0 / 100% 9px no-repeat;
  }
  li:nth-child(2) .mota-num {
    border-radius: var(--mota-b);
  }
  h3 {
    margin-top: 0.5rem;
  }
  p {
    color: var(--gris);
    max-width: 34ch;
  }
  @media (max-width: 48rem) {
    .steps {
      grid-template-columns: 1fr;
      row-gap: 2rem;
    }
  }
</style>
