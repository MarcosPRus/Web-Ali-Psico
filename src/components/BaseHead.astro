---
import "../styles/global.css";
import { Font } from "astro:assets";
import { SITE_TITLE, SITE_DESCRIPTION, SITE_NAME, CONTACT, LOCATIONS } from "../consts";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
}

const { title, description = SITE_DESCRIPTION, image = "/og.jpg", type = "website" } = Astro.props;
const fullTitle = title ? `${title} · ${SITE_NAME}` : SITE_TITLE;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

// Datos estructurados para Google (ficha de profesional sanitario)
const schema = {
  "@context": "https://schema.org",
  "@type": "Psychologist",
  name: "Alicia Lozano · Psicología",
  description: SITE_DESCRIPTION,
  url: Astro.site?.toString(),
  email: CONTACT.email,
  telephone: CONTACT.phone,
  image: new URL("/og.jpg", Astro.site).toString(),
  areaServed: ["Sevilla", "Tomares", "Dos Hermanas", "Mairena del Aljarafe", "Online"],
  location: LOCATIONS.filter((l) => l.id !== "online").map((l) => ({
    "@type": "Place",
    name: `Consulta ${l.name}`,
    address: { "@type": "PostalAddress", streetAddress: l.lines.join(", "), addressLocality: l.name, addressRegion: "Sevilla", addressCountry: "ES" },
  })),
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="theme-color" content="#f5efe3" />
<link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
<link rel="icon" href="/favicon/favicon.ico" sizes="32x32" />
<link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png" />
<link rel="manifest" href="/favicon/site.webmanifest" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={new URL("rss.xml", Astro.site)} />
<meta name="generator" content={Astro.generator} />

<Font cssVariable="--font-serif" preload={[{ style: "normal" }]} />
<Font cssVariable="--font-sans" preload={[{ style: "normal" }]} />
<Font cssVariable="--font-hand" />

<link rel="canonical" href={canonicalURL} />
<title>{fullTitle}</title>
<meta name="description" content={description} />

<meta property="og:type" content={type} />
<meta property="og:locale" content="es_ES" />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
