---
import type { CollectionEntry } from "astro:content";
import Media from "./art/Media.astro";
import Icon from "./Icon.astro";
interface Props {
  service: CollectionEntry<"services">;
  index?: number;
}
const { service, index = 0 } = Astro.props;
const d = service.data;
---

<article class="card" style={`--accent:var(--${d.accent === "wine" ? "wine" : d.accent});--d:${index % 3}`} data-reveal>
  <div class="art">
    <Media scene={d.scene} src={d.heroImage} ratio="5 / 4" shape="rounded" />
    <span class="num">0{index + 1}</span>
  </div>
  <div class="body">
    <p class="kicker">{d.kicker}</p>
    <h3><a href={`/servicios/${service.id}`}>{d.title}</a></h3>
    <p class="short">{d.short}</p>
    <span class="more" aria-hidden="true">Saber más <Icon name="arrow" size={18} /></span>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 0.75rem 0.75rem 1.6rem;
    border-radius: calc(var(--radius-lg) + 0.5rem);
    background: var(--paper);
    box-shadow: inset 0 0 0 1px var(--line);
    transition: transform 0.6s var(--ease), box-shadow 0.6s var(--ease), background-color 0.4s;
  }
  .card:hover {
    transform: translateY(-6px);
    background: #fff;
    box-shadow: var(--shadow);
  }
  .art {
    position: relative;
  }
  .art :global(.frame) {
    border-radius: var(--radius-lg);
  }
  .art :global(svg) {
    transition: transform 1.2s var(--ease);
  }
  .card:hover .art :global(svg) {
    transform: scale(1.06) rotate(-1deg);
  }
  .num {
    position: absolute;
    left: 1rem;
    top: 1rem;
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    background: var(--paper);
    font-family: var(--serif);
    font-style: italic;
    font-size: 1rem;
  }
  .body {
    display: grid;
    gap: 0.6rem;
    padding-inline: 0.85rem;
    flex: 1;
    align-content: start;
  }
  .kicker {
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--terracotta-ink);
  }
  h3 {
    font-size: var(--step-2);
  }
  h3 a {
    text-decoration: none;
  }
  /* toda la tarjeta clicable */
  h3 a::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .short {
    color: var(--ink-2);
    font-size: 0.98rem;
  }
  .more {
    margin-top: 0.4rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    font-size: 0.95rem;
  }
  .more :global(.icon) {
    transition: transform 0.5s var(--ease);
  }
  .card:hover .more :global(.icon) {
    transform: translateX(6px);
  }
</style>
