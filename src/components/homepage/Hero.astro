---
import Image from "astro/components/Image.astro";
import { ChevronRight } from "@lucide/astro";
---

<section class="section section-hero py-10 sm:py-20 my-0!">
  <div class="container">
    <div class="grid grid-cols-1 md:grid-cols-2 items-center gap-10">
      <div class="text-center sm:text-left">
        <h1>
          Acompañándote a <span
            class="bg-linear-to-r from-[var(--color-main-200)] to-[#e89b96] bg-clip-text text-transparent"
            >sanar tu relación</span
          > con la comida y tu cuerpo.
        </h1>
        <p class="mt-8 mb-10 text-lg">
          Soy <span class="text-main-200 font-medium">Alicia Lozano</span>, psicóloga general sanitaria experta en TCA e insatisfacción corporal. Te ofrezco un espacio seguro, libre de juicios y basado en la evidencia científica para ayudarte a recuperar tu bienestar mental y físico. <br/><br/>
          Terapia <span class="text-main-200 font-medium">online</span> y <span class="text-main-200 font-medium">presencial en Sevilla</span>.
        </p>
        <a
          href="/contacto"
          class="btn bg-[linear-gradient(125deg,var(--color-main-100),var(--color-main-200))] text-white border-0 rounded-xl text-lg py-3 px-6 h-auto shadow-xl hover:shadow-2xl"
          >Reserva tu sesión <ChevronRight /></a
        >
      </div>
      <div>
        <div class="grid">
          <Image
            src="/img/hero-placeholder.jpg"
            alt="Alicia Lozano Consulta"
            format="webp"
            quality="80"
            fetchpriority="high"
            loading="eager"
            width="400"
            height="500"
            class="w-full max-w-[400px] h-auto mx-auto rounded-3xl object-cover [grid-area:1/1/2/2] shadow-2xl"
          />
          <div class="[grid-area:1/1/2/2] mt-auto">
            <div
              class="border-main-200 border-2 rounded-xl p-5 bg-[linear-gradient(-125deg,#FDFBF9_0%,#ffffff_100%)] hidden sm:block sm:max-w-[45%] ml-auto translate-x-4 shadow-lg"
            >
              <p class="text-xl text-black font-semibold">
                Terapia Segura
              </p>
              <p class="text-main-200 my-2">Enfoque libre de juicios</p>
            </div>
            
            <div
              class="bg-white p-4 rounded-xl shadow-lg hidden sm:flex sm:max-w-[60%] text-main-200 text-lg items-center gap-3 -translate-x-4 mt-6"
            >
              <svg class="icon" width="30" height="30">
                <use xlink:href="#star"></use>
              </svg>
              Psicología Basada en Evidencia
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
