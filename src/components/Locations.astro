---
import Icon from "./Icon.astro";
import { LOCATIONS } from "../consts";
const W = 400, H = 340;
const px = (x: number) => (x / 100) * W;
const py = (y: number) => (y / 100) * H;
const sevilla = { x: px(56), y: py(33) };
---

<div class="locations" data-locations data-active="tomares">
  <div class="list">
    <div class="tabs" role="group" aria-label="Elige consulta">
      {
        LOCATIONS.map((l, i) => (
          <button type="button" data-loc={l.id} aria-pressed={i === 0 ? "true" : "false"}>
            <span class="n">{l.name}</span>
            <span class="a">{l.area}</span>
          </button>
        ))
      }
    </div>

    {
      LOCATIONS.map((l, i) => (
        <div class="detail" data-detail={l.id} data-first={i === 0 ? "" : undefined}>
          <div class="ico">
            <Icon name={l.id === "online" ? "video" : "pin"} size={22} />
          </div>
          <div>
            <h3>
              {l.id === "online" ? (
                "Terapia online"
              ) : (
                <>
                  Consulta en <em>{l.name}</em>
                </>
              )}
            </h3>
            <address>
              {l.lines.map((line) => (
                <span>{line}</span>
              ))}
            </address>
            <p class="note">{l.note}</p>
            {l.maps ? (
              <a class="link" href={l.maps} target="_blank" rel="noopener">
                Cómo llegar <Icon name="arrow-up-right" size={16} />
              </a>
            ) : (
              <a class="link" href="/blog/terapia-online-como-funciona">
                Cómo funciona <Icon name="arrow" size={16} />
              </a>
            )}
          </div>
        </div>
      ))
    }
  </div>

  <div class="map" aria-hidden="true">
    <svg viewBox={`0 0 ${W} ${H}`}>
      {/* colinas del Aljarafe */}
      <path d="M-10 90 C 40 60, 110 70, 150 110 C 170 160, 150 250, 90 300 C 50 330, 0 330, -10 320 Z" fill="var(--celadon)" opacity=".9" />
      <path d="M-10 150 C 30 130, 90 140, 110 180 C 120 230, 80 280, 30 300 L -10 300 Z" fill="#bcd7c9" opacity=".7" />
      {/* campiña */}
      <circle cx="330" cy="290" r="90" fill="var(--hueso)" />
      {/* Guadalquivir */}
      <path
        d="M205 -10 C 190 40, 176 70, 196 110 C 214 146, 170 170, 180 210 C 190 250, 150 280, 170 350"
        fill="none"
        stroke="var(--cobalto-suave)"
        stroke-width="16"
        stroke-linecap="round"
      />
      <text x="140" y="262" class="river" transform="rotate(-62 140 262)">Guadalquivir</text>
      {/* caminos */}
      <g stroke="var(--ink)" stroke-opacity=".28" stroke-width="1.6" stroke-dasharray="4 6" fill="none">
        {LOCATIONS.filter((l) => l.id !== "online").map((l) => (
          <path d={`M${sevilla.x} ${sevilla.y} Q ${(sevilla.x + px(l.x)) / 2} ${(sevilla.y + py(l.y)) / 2 + 30} ${px(l.x)} ${py(l.y)}`} />
        ))}
      </g>
      {/* Sevilla */}
      <g transform={`translate(${sevilla.x} ${sevilla.y})`}>
        <circle r="30" fill="var(--blanco)" />
        <path d="M-4 10 V -14 L 0 -20 L 4 -14 V 10 Z M-6 10 H 6 V 13 H -6 Z" fill="var(--tinta)" />
        <circle cy="-22" r="2.4" fill="var(--cobalto)" />
        <text y="28" class="city" text-anchor="middle">Sevilla</text>
      </g>
      {/* pines */}
      {LOCATIONS.map((l) =>
        l.id === "online" ? (
          <g class="pin" data-pin={l.id} transform={`translate(${px(l.x)} ${py(l.y)})`}>
            <circle class="pulse" r="22" />
            <circle r="22" fill="var(--blanco)" stroke="var(--cobalto)" stroke-width="2" stroke-dasharray="3 4" />
            <rect x="-10" y="-7" width="13" height="14" rx="3" fill="var(--cobalto)" />
            <path d="M4 -3 L 11 -7 V 7 L 4 3 Z" fill="var(--cobalto)" />
            <text y="40" text-anchor="middle" class="label">Online</text>
          </g>
        ) : (
          <g class="pin" data-pin={l.id} transform={`translate(${px(l.x)} ${py(l.y)})`}>
            <circle class="pulse" cy="-26" r="16" />
            <path class="drop" d="M0 0 C -12 -14, -14 -20, -14 -26 A 14 14 0 0 1 14 -26 C 14 -20, 12 -14, 0 0 Z" />
            <circle cy="-26" r="5" fill="var(--blanco)" />
            <text y="18" text-anchor="middle" class="label">{l.name}</text>
          </g>
        ),
      )}
    </svg>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-locations]").forEach((root) => {
    const set = (id: string) => {
      root.dataset.active = id;
      root.querySelectorAll<HTMLButtonElement>("[data-loc]").forEach((b) =>
        b.setAttribute("aria-pressed", String(b.dataset.loc === id)),
      );
      root.querySelectorAll<HTMLElement>("[data-detail]").forEach((d) => (d.hidden = d.dataset.detail !== id));
      root.querySelectorAll<SVGGElement>("[data-pin]").forEach((p) => p.classList.toggle("on", p.dataset.pin === id));
    };
    root.querySelectorAll<HTMLButtonElement>("[data-loc]").forEach((b) =>
      b.addEventListener("click", () => set(b.dataset.loc!)),
    );
    root.querySelectorAll<SVGGElement>("[data-pin]").forEach((p) =>
      p.addEventListener("click", () => set(p.dataset.pin!)),
    );
    set(root.dataset.active || "tomares");
  });
</script>

<style>
  .locations {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: center;
  }
  .tabs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.6rem;
    margin-bottom: 1.25rem;
  }
  .tabs button {
    display: grid;
    text-align: left;
    gap: 0.1rem;
    padding: 0.95rem 1.25rem;
    background: var(--o-pill-1) 0 0 / 100% 100% no-repeat, var(--bg-c, transparent);
    -webkit-mask: var(--m-pill-1) 0 0 / 100% 100% no-repeat;
    mask: var(--m-pill-1) 0 0 / 100% 100% no-repeat;
    transition: background-color 0.3s, color 0.3s;
  }
  .tabs button:nth-child(2),
  .tabs button:nth-child(4) {
    background-image: var(--o-pill-2);
    -webkit-mask-image: var(--m-pill-2);
    mask-image: var(--m-pill-2);
  }
  .tabs button:nth-child(3) {
    background-image: var(--o-pill-3);
    -webkit-mask-image: var(--m-pill-3);
    mask-image: var(--m-pill-3);
  }
  .tabs button:hover {
    --bg-c: var(--hueso);
  }
  .tabs button[aria-pressed="true"] {
    background-image: none;
    background-color: var(--tinta);
    color: var(--blanco);
  }
  .tabs button:focus-visible {
    -webkit-mask: none;
    mask: none;
  }
  .tabs .n {
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.15;
  }
  .tabs .a {
    font-size: var(--t-xs);
    opacity: 0.75;
  }
  .detail {
    display: flex;
    gap: 1.1rem;
    padding: 1.6rem;
    -webkit-mask: var(--m-forma-2) 0 0 / 100% 100% no-repeat;
    mask: var(--m-forma-2) 0 0 / 100% 100% no-repeat;
    background: var(--hueso);
    animation: pop 0.5s var(--ease);
  }
  .detail[hidden] {
    display: none;
  }
  @media (scripting: none) {
    .detail[hidden] {
      display: flex;
    }
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }
  .ico {
    flex: none;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 2.8rem;
    border-radius: var(--mota);
    background: var(--cobalto);
    color: var(--blanco);
  }
  .detail h3 {
    margin-bottom: 0.6rem;
  }
  .detail h3 em {
    font-style: normal;
    color: var(--cobalto);
  }
  address {
    font-style: normal;
    display: grid;
  }
  .note {
    margin-block: 0.8rem 1rem;
    color: var(--gris);
    font-size: var(--t-sm);
  }
  .map {
    position: relative;
    -webkit-mask: var(--m-forma-2) 0 0 / 100% 100% no-repeat;
    mask: var(--m-forma-2) 0 0 / 100% 100% no-repeat;
    background: var(--blanco);
    overflow: hidden;
    aspect-ratio: 400 / 340;
  }
  /* contorno dibujado a mano por encima del mapa */
  .map::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: var(--o-forma-2) 0 0 / 100% 100% no-repeat;
  }
  .map svg {
    width: 100%;
    height: 100%;
  }
  .map .river {
    font-size: 11px;
    font-weight: 500;
    fill: var(--cobalto);
  }
  .map .city {
    font-size: 14px;
    font-weight: 700;
    fill: var(--tinta);
  }
  .pin {
    cursor: pointer;
  }
  .pin .drop {
    fill: var(--tinta);
    transition: fill 0.3s;
  }
  .pin .label {
    font-family: var(--sans);
    font-size: 11.5px;
    font-weight: 700;
    fill: var(--tinta);
  }
  .pin .pulse {
    fill: var(--cobalto);
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }
  .pin.on .drop {
    fill: var(--cobalto);
  }
  .pin.on .pulse {
    animation: pulse 2s var(--ease) infinite;
  }
  @keyframes pulse {
    0% {
      opacity: 0.4;
      transform: scale(0.6);
    }
    100% {
      opacity: 0;
      transform: scale(2.2);
    }
  }
  @media (max-width: 56rem) {
    .locations {
      grid-template-columns: 1fr;
    }
    .map {
      order: -1;
    }
  }
</style>
