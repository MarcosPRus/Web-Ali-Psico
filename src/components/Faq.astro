---
import Icon from "./Icon.astro";
interface Props {
  items: { q: string; a: string }[];
  name?: string;
}
const { items, name = "faq" } = Astro.props;
---

<div class="faq">
  {
    items.map((it, i) => (
      <details name={name} open={i === 0} data-reveal style={`--d:${i}`}>
        <summary>
          <span>{it.q}</span>
          <span class="toggle">
            <Icon name="plus" size={20} />
          </span>
        </summary>
        <div class="answer">
          <p>{it.a}</p>
        </div>
      </details>
    ))
  }
</div>

<style>
  .faq {
    display: grid;
    gap: 0.75rem;
  }
  details {
    border-radius: var(--radius);
    background: var(--paper);
    box-shadow: inset 0 0 0 1px var(--line);
    transition: background-color 0.4s, box-shadow 0.4s;
  }
  details[open] {
    background: #fff;
    box-shadow: var(--shadow);
  }
  summary {
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.25rem;
    padding: 1.25rem 1.4rem;
    cursor: pointer;
    font-family: var(--serif);
    font-size: var(--step-1);
    font-weight: 400;
    line-height: 1.3;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .toggle {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 52% 48% 55% 45% / 48% 54% 46% 52%;
    background: var(--sand);
    transition: transform 0.5s var(--ease), background-color 0.3s;
  }
  details[open] .toggle {
    transform: rotate(135deg);
    background: var(--blush);
  }
  .answer {
    padding: 0 1.4rem 1.4rem;
    color: var(--ink-2);
    max-width: 60ch;
  }
  @supports (interpolate-size: allow-keywords) {
    details {
      interpolate-size: allow-keywords;
    }
    details::details-content {
      height: 0;
      overflow: clip;
      transition: height 0.5s var(--ease), content-visibility 0.5s allow-discrete;
    }
    details[open]::details-content {
      height: auto;
    }
  }
</style>
