---
import Icon from "./Icon.astro";
interface Props {
  items: { q: string; a: string }[];
  name?: string;
}
const { items, name = "faq" } = Astro.props;
---

<div class="faq">
  {
    items.map((it, i) => (
      <details name={name} open={i === 0} data-reveal style={`--d:${i}`}>
        <summary>
          <span>{it.q}</span>
          <span class="toggle">
            <Icon name="plus" size={20} />
          </span>
        </summary>
        <div class="answer">
          <p>{it.a}</p>
        </div>
      </details>
    ))
  }
</div>

<style>
  .faq {
    display: grid;
    padding-top: 2px;
    background: var(--trazo) 0 0 / 100% 9px no-repeat;
  }
  details {
    background: var(--trazo-fino) 0 100% / 100% 7px no-repeat;
  }
  summary {
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.25rem;
    padding: 1.35rem 0;
    cursor: pointer;
    font-size: var(--t-lg);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.01em;
    transition: color 0.25s;
  }
  summary:hover {
    color: var(--cobalto);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .toggle {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.5rem;
    height: 2.3rem;
    border-radius: var(--mota);
    box-shadow: inset 0 0 0 1.5px currentColor;
    rotate: -4deg;
    transition: transform 0.5s var(--ease), background-color 0.3s, color 0.3s;
  }
  details[open] .toggle {
    transform: rotate(135deg);
    background: var(--cobalto);
    color: var(--blanco);
    box-shadow: none;
  }
  .answer {
    padding: 0 3.5rem 1.5rem 0;
    color: var(--gris);
    max-width: 62ch;
  }
  @supports (interpolate-size: allow-keywords) {
    details {
      interpolate-size: allow-keywords;
    }
    details::details-content {
      height: 0;
      overflow: clip;
      transition: height 0.5s var(--ease), content-visibility 0.5s allow-discrete;
    }
    details[open]::details-content {
      height: auto;
    }
  }
</style>
