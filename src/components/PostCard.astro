---
import type { CollectionEntry } from "astro:content";
import Portada from "./Portada.astro";
interface Props {
  post: CollectionEntry<"blog">;
  index?: number;
}
const { post, index = 0 } = Astro.props;
const d = post.data;
const date = d.pubDate.toLocaleDateString("es-ES", { day: "numeric", month: "long", year: "numeric" });
const minutes = Math.max(2, Math.round((post.body ?? "").split(/\s+/).length / 200));
const formas = ["--forma-1", "--forma-2", "--forma-3", "--forma-4"];
---

<article class="post" data-reveal style={`--d:${index % 3}`}>
  <Portada src={d.heroImage} alt={d.title} category={d.category} forma={formas[index % 4]} class="thumb" />
  <div class="meta">
    <span class="cat">{d.category}</span>
    <span aria-hidden="true">·</span>
    <time datetime={d.pubDate.toISOString()}>{date}</time>
    <span aria-hidden="true">·</span>
    <span>{minutes} min</span>
  </div>
  <h3><a href={`/blog/${post.id}`}>{d.title}</a></h3>
</article>

<style>
  .post {
    position: relative;
    display: grid;
    gap: 0.9rem;
    align-content: start;
  }
  .post:hover :global(.thumb img),
  .post:hover :global(.thumb .etiqueta) {
    transform: scale(1.04);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-size: var(--t-xs);
    color: var(--gris);
  }
  .cat {
    font-weight: 700;
    color: var(--cobalto);
  }
  h3 a {
    text-decoration: none;
    background: linear-gradient(currentColor 0 0) 0 100% / 0 2px no-repeat;
    transition: background-size 0.5s var(--ease);
  }
  .post:hover h3 a {
    background-size: 100% 2px;
  }
  h3 a::after {
    content: "";
    position: absolute;
    inset: 0;
  }
</style>
