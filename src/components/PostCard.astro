---
import type { CollectionEntry } from "astro:content";
import Portada from "./Portada.astro";
interface Props {
  post: CollectionEntry<"blog">;
  index?: number;
}
const { post, index = 0 } = Astro.props;
const d = post.data;
const formas = ["--forma-1", "--forma-2", "--forma-3", "--forma-4"];
---

<article class="post" data-reveal style={`--d:${index % 3}`}>
  <Portada src={d.heroImage} alt={d.title} category={d.category} forma={formas[index % 4]} class="thumb" />
  <h3><a href={`/blog/${post.id}`}>{d.title}</a></h3>
</article>

<style>
  .post {
    position: relative;
    display: grid;
    gap: 0.9rem;
    align-content: start;
  }
  .post:hover :global(.thumb img),
  .post:hover :global(.thumb .etiqueta) {
    transform: scale(1.04);
  }
  h3 a {
    text-decoration: none;
    background: var(--trazo-fino) 0 100% / 0 7px no-repeat;
    padding-bottom: 0.2em;
    transition: background-size 0.5s var(--ease);
  }
  .post:hover h3 a {
    background-size: 100% 7px;
  }
  h3 a::after {
    content: "";
    position: absolute;
    inset: 0;
  }
</style>
