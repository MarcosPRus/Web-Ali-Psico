---
import type { CollectionEntry } from "astro:content";
import Media from "./art/Media.astro";
interface Props {
  post: CollectionEntry<"blog">;
  index?: number;
  featured?: boolean;
}
const { post, index = 0, featured = false } = Astro.props;
const d = post.data;
const date = d.pubDate.toLocaleDateString("es-ES", { day: "numeric", month: "long", year: "numeric" });
const words = (post.body ?? "").split(/\s+/).length;
const minutes = Math.max(2, Math.round(words / 200));
---

<article class:list={["post", featured && "featured"]} data-reveal style={`--d:${index % 3}`}>
  <Media scene={d.scene} src={d.heroImage} ratio={featured ? "4 / 3" : "4 / 3"} class="thumb" />
  <div class="meta">
    <span class="cat">{d.category}</span>
    <span>·</span>
    <time datetime={d.pubDate.toISOString()}>{date}</time>
    <span>·</span>
    <span>{minutes} min</span>
  </div>
  <h3><a href={`/blog/${post.id}`}>{d.title}</a></h3>
  {featured && <p class="desc">{d.description}</p>}
</article>

<style>
  .post {
    position: relative;
    display: grid;
    gap: 1rem;
    align-content: start;
  }
  .post :global(.thumb) {
    border-radius: var(--radius-lg);
  }
  .post :global(.thumb svg) {
    transition: transform 1.2s var(--ease);
  }
  .post:hover :global(.thumb svg) {
    transform: scale(1.07);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  .cat {
    font-weight: 600;
    color: var(--terracotta-ink);
  }
  h3 {
    font-size: var(--step-2);
    line-height: 1.15;
  }
  .featured h3 {
    font-size: var(--step-3);
  }
  h3 a {
    text-decoration: none;
    background: linear-gradient(currentColor 0 0) 0 100% / 0 1px no-repeat;
    transition: background-size 0.6s var(--ease);
  }
  .post:hover h3 a {
    background-size: 100% 1px;
  }
  h3 a::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .desc {
    color: var(--ink-2);
    max-width: 50ch;
  }
</style>
