---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import InfoBar from "./InfoBar.astro";
import Silueta from "./Silueta.astro";
import { NAV, CONTACT } from "../consts";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) => path === href || path.startsWith(href + "/");
---

<InfoBar />
<header class="site-header" data-header>
  <div class="container bar">
    <a href="/" class="brand" aria-label="Alicia Lozano, psicóloga: inicio">
      <Logo />
    </a>

    <nav class="nav" aria-label="Principal">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a href="/contacto" class="btn dark small">Pedir cita</a>
    </nav>

    <button class="burger" popovertarget="mobile-menu" aria-label="Abrir menú">
      <Icon name="menu" size={24} />
    </button>
  </div>
</header>

<div id="mobile-menu" popover class="mobile-menu on-cobalto" data-menu>
  <div class="mm-top container">
    <a href="/" class="brand"><Logo tone="light" /></a>
    <button class="burger close" popovertarget="mobile-menu" popovertargetaction="hide" aria-label="Cerrar menú">
      <Icon name="close" size={24} />
    </button>
  </div>
  <nav class="container mm-nav" aria-label="Menú móvil">
    <ul>
      <li style="--i:0"><a href="/">Inicio</a></li>
      {
        NAV.map((item, i) => (
          <li style={`--i:${i + 1}`}>
            <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <div class="container mm-foot">
    <div class="mm-cornisa">
      <Silueta gato="maddy" size="9rem" class="mm-maddy" />
      <a href={CONTACT.whatsapp} class="btn light" target="_blank" rel="noopener">
        <Icon name="whatsapp" /> Escríbeme por WhatsApp
      </a>
    </div>
    <p>
      <a href={CONTACT.phoneHref}>{CONTACT.phone}</a><br />
      <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
    </p>
  </div>
</div>

<script>
  const header = document.querySelector("[data-header]");
  const onScroll = () => header?.classList.toggle("is-scrolled", window.scrollY > 40);
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  const menu = document.querySelector<HTMLElement>("[data-menu]");
  menu?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => {
      try {
        menu.hidePopover();
      } catch {}
    }),
  );
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(255 255 255 / 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition: box-shadow 0.3s;
  }
  .site-header.is-scrolled {
    box-shadow: 0 1px 0 var(--linea);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    min-height: 5rem;
    transition: min-height 0.3s var(--ease);
  }
  .is-scrolled .bar {
    min-height: 4.25rem;
  }
  .brand {
    text-decoration: none;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .nav ul {
    display: flex;
    gap: 1.75rem;
    list-style: none;
    padding: 0;
  }
  .nav ul a {
    position: relative;
    font-size: var(--t-sm);
    font-weight: 500;
    text-decoration: none;
    padding-block: 0.4rem;
  }
  /* subrayado que se dibuja como una pincelada */
  .nav ul a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    border-radius: 2px 1px 3px 1px;
    background: var(--cobalto);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s var(--ease);
  }
  .nav ul a:hover::after,
  .nav ul a[aria-current="page"]::after {
    transform: scaleX(1);
  }
  .nav ul a[aria-current="page"] {
    color: var(--cobalto);
  }
  .burger {
    display: none;
    width: 3rem;
    height: 3rem;
    place-items: center;
    border-radius: var(--mota);
    box-shadow: inset 0 0 0 2px currentColor;
  }
  @media (max-width: 54rem) {
    .nav {
      display: none;
    }
    .burger {
      display: grid;
    }
  }

  /* Menú móvil: un bloque cobalto a pantalla completa */
  .mobile-menu {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    overflow: hidden;
    display: none;
    flex-direction: column;
    opacity: 0;
    transition: opacity 0.35s var(--ease), display 0.35s allow-discrete, overlay 0.35s allow-discrete;
  }
  .mobile-menu:popover-open {
    display: flex;
    opacity: 1;
  }
  @starting-style {
    .mobile-menu:popover-open {
      opacity: 0;
    }
  }
  .mm-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 5rem;
  }
  .mm-top .brand {
    color: var(--blanco);
  }
  .mm-nav {
    flex: 1;
    display: flex;
    align-items: center;
  }
  .mm-nav ul {
    list-style: none;
    padding: 0;
  }
  .mm-nav a {
    font-size: clamp(2.5rem, 12vw, 4rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1.1;
    text-decoration: none;
  }
  .mm-nav a[aria-current="page"] {
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 0.15em;
  }
  .mobile-menu:popover-open .mm-nav li {
    animation: mm-in 0.6s var(--ease) both;
    animation-delay: calc(var(--i) * 55ms + 60ms);
  }
  @keyframes mm-in {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
  }
  .mm-foot {
    padding-bottom: 2rem;
    display: grid;
    gap: 1.25rem;
  }
  .mm-cornisa {
    position: relative;
    justify-self: start;
    margin-top: 4rem;
  }
  .mobile-menu :global(.mm-maddy) {
    left: calc(100% - 7.2rem);
    bottom: calc(100% - 0.3rem);
  }
  .mm-foot p a {
    text-decoration: none;
    color: var(--cobalto-suave);
  }
</style>
