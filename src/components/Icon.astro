---
/** Iconos de línea propios (trazo 1.6, esquinas redondeadas). */
type Name =
  | "arrow"
  | "arrow-up-right"
  | "phone"
  | "mail"
  | "whatsapp"
  | "instagram"
  | "pin"
  | "video"
  | "clock"
  | "check"
  | "plus"
  | "menu"
  | "close"
  | "calendar"
  | "euro";
interface Props {
  name: Name;
  size?: number | string;
  class?: string;
  label?: string;
}
const { name, size = 20, class: className, label } = Astro.props;
---

<svg
  class:list={["icon", className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
>
  {name === "arrow" && <path d="M4 12h15M13 6l6 6-6 6" />}
  {name === "arrow-up-right" && <path d="M7 17 17 7M8 7h9v9" />}
  {name === "phone" && (
    <path d="M5 4h3.5l1.8 4.4-2.2 1.4a11 11 0 0 0 6.1 6.1l1.4-2.2L20 15.5V19a1.5 1.5 0 0 1-1.6 1.5A16.5 16.5 0 0 1 3.5 5.6 1.5 1.5 0 0 1 5 4Z" />
  )}
  {name === "mail" && (
    <>
      <rect x="3" y="5" width="18" height="14" rx="3" />
      <path d="m4 7 8 6 8-6" />
    </>
  )}
  {name === "whatsapp" && (
    <>
      <path d="M4 20l1.3-3.9A8 8 0 1 1 8 18.8Z" />
      <path d="M9 9.2c0 3 2.8 5.8 5.8 5.8l1.2-1.4-1.9-.9-.8.8a4 4 0 0 1-2.8-2.8l.8-.8-.9-1.9Z" />
    </>
  )}
  {name === "instagram" && (
    <>
      <rect x="3.5" y="3.5" width="17" height="17" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.2" cy="6.8" r=".6" fill="currentColor" />
    </>
  )}
  {name === "pin" && (
    <>
      <path d="M12 21s7-6.2 7-12a7 7 0 0 0-14 0c0 5.8 7 12 7 12Z" />
      <circle cx="12" cy="9" r="2.5" />
    </>
  )}
  {name === "video" && (
    <>
      <rect x="3" y="6" width="13" height="12" rx="3" />
      <path d="m16 10.5 5-3v9l-5-3" />
    </>
  )}
  {name === "clock" && (
    <>
      <circle cx="12" cy="12" r="8.5" />
      <path d="M12 7.5V12l3 2" />
    </>
  )}
  {name === "check" && <path d="m5 12.5 4.5 4.5L19 7.5" />}
  {name === "plus" && <path d="M12 5v14M5 12h14" />}
  {name === "menu" && <path d="M4 8h16M4 16h16" />}
  {name === "close" && <path d="M6 6l12 12M18 6 6 18" />}
  {name === "calendar" && (
    <>
      <rect x="3.5" y="5" width="17" height="15" rx="3" />
      <path d="M3.5 10h17M8 3v4M16 3v4" />
    </>
  )}
  {name === "euro" && <path d="M17 6.5A6.5 6.5 0 1 0 17 17.5M5 10.5h8M5 13.5h8" />}
</svg>

<style>
  .icon {
    flex: none;
  }
</style>
