---
/**
 * Cabecera de página interior: migas, antetítulo, titular grande y entradilla.
 * Si recibe `src`, muestra una foto en forma de arco a la derecha.
 * (`scene`, `tone` y `compact` se aceptan por compatibilidad y no cambian nada.)
 */
interface Props {
  eyebrow?: string;
  src?: string;
  alt?: string;
  crumbs?: { href?: string; label: string }[];
  scene?: string;
  tone?: string;
  compact?: boolean;
}
const { eyebrow, src, alt = "", crumbs = [] } = Astro.props;
---

<section class:list={["page-hero", src && "con-foto"]}>
  <div class="container g12">
    <div class="copy">
      {
        crumbs.length > 0 && (
          <nav aria-label="Migas de pan" class="crumbs" data-reveal>
            <a href="/">Inicio</a>
            {crumbs.map((c) => (
              <>
                <span aria-hidden="true">/</span>
                {c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
              </>
            ))}
          </nav>
        )
      }
      {eyebrow && <p class="eyebrow" data-reveal>{eyebrow}</p>}
      <h1 data-reveal style="--d:1"><slot /></h1>
      {Astro.slots.has("lead") && <p class="lead" data-reveal style="--d:2"><slot name="lead" /></p>}
      {Astro.slots.has("actions") && <div class="actions" data-reveal style="--d:3"><slot name="actions" /></div>}
    </div>
    {
      src && (
        <div class="visual" data-reveal style="--d:2">
          <img src={src} alt={alt} loading="eager" width="800" height="1000" />
        </div>
      )
    }
  </div>
</section>

<style>
  .page-hero {
    padding-block: clamp(2.5rem, 5vw, 4.5rem) clamp(3rem, 6vw, 5rem);
  }
  .g12 {
    align-items: end;
    row-gap: 2rem;
  }
  .copy {
    grid-column: 1 / span 10;
    display: grid;
    gap: 1.4rem;
    justify-items: start;
  }
  .con-foto .copy {
    grid-column: 1 / span 7;
  }
  h1 {
    max-width: 16ch;
  }
  .lead {
    max-width: 48ch;
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: var(--t-sm);
    color: var(--gris);
  }
  .crumbs a {
    text-decoration: none;
  }
  .crumbs a:hover {
    text-decoration: underline;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .visual {
    grid-column: 9 / span 4;
  }
  .visual img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    clip-path: var(--arco);
    background: var(--hueso);
  }
  @media (max-width: 56rem) {
    .copy,
    .con-foto .copy,
    .visual {
      grid-column: 1 / -1;
    }
    .visual {
      max-width: 20rem;
    }
  }
</style>
