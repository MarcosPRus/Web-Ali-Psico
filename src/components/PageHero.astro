---
import Media from "./art/Media.astro";
import Shape from "./art/Shape.astro";
import type { Scene } from "./art/Art.astro";

interface Props {
  eyebrow?: string;
  scene?: Scene;
  src?: string;
  alt?: string;
  crumbs?: { href?: string; label: string }[];
  tone?: "lilac" | "blush" | "sage" | "butter";
  compact?: boolean;
}
const { eyebrow, scene, src, alt = "", crumbs = [], tone = "blush", compact = false } = Astro.props;
const toneVar = { lilac: "var(--lilac)", blush: "var(--blush)", sage: "#cfd8c4", butter: "#f6e2ac" }[tone];
---

<section class:list={["page-hero", compact && "compact", !scene && !src && "no-art"]} style={`--tone:${toneVar}`}>
  <div class="bg" aria-hidden="true"></div>
  <div class="container wide grid">
    <div class="copy">
      {
        crumbs.length > 0 && (
          <nav aria-label="Migas de pan" class="crumbs" data-reveal>
            <a href="/">Inicio</a>
            {crumbs.map((c) => (
              <>
                <span aria-hidden="true">/</span>
                {c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
              </>
            ))}
          </nav>
        )
      }
      {eyebrow && <p class="eyebrow" data-reveal>{eyebrow}</p>}
      <h1 data-reveal style="--d:1"><slot /></h1>
      {Astro.slots.has("lead") && <p class="lead" data-reveal style="--d:2"><slot name="lead" /></p>}
      {Astro.slots.has("actions") && <div class="actions" data-reveal style="--d:3"><slot name="actions" /></div>}
    </div>
    {
      (scene || src) && (
        <div class="visual" data-reveal style="--d:2">
          <Media scene={scene} src={src} alt={alt} shape="arch" ratio="4 / 5" loading="eager" />
          <Shape name="star" color="var(--terracotta)" size="3.2rem" class="star float" style="--t:8s" />
          <Shape name="sun" color="var(--butter)" size="7rem" class="sun" />
        </div>
      )
    }
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    margin-top: calc(-1 * var(--header-h));
    padding-top: calc(var(--header-h) + clamp(2rem, 4vw, 3.5rem));
    padding-bottom: clamp(3rem, 7vw, 6rem);
    overflow: clip;
  }
  .bg {
    position: absolute;
    inset: 0 0 auto 0;
    height: 100%;
    background: radial-gradient(60% 80% at 85% 20%, var(--tone), transparent 70%),
      radial-gradient(40% 50% at 0% 0%, color-mix(in oklab, var(--tone) 50%, transparent), transparent 70%);
    opacity: 0.8;
    z-index: -1;
  }
  .grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }
  .no-art .grid {
    grid-template-columns: 1fr;
  }
  .copy {
    display: grid;
    gap: 1.4rem;
    justify-items: start;
  }
  h1 {
    max-width: 16ch;
  }
  .compact h1 {
    font-size: var(--step-4);
  }
  .lead {
    max-width: 44ch;
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  .crumbs a {
    text-decoration: none;
  }
  .crumbs a:hover {
    text-decoration: underline;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .visual {
    position: relative;
    width: min(100%, 24rem);
    justify-self: center;
  }
  .visual :global(.frame) {
    box-shadow: var(--shadow);
  }
  .visual :global(.star) {
    position: absolute;
    left: -1.4rem;
    top: 14%;
  }
  .visual :global(.sun) {
    position: absolute;
    right: -2.5rem;
    bottom: -2rem;
    z-index: -1;
    animation: spin 50s linear infinite;
  }
  @media (max-width: 56rem) {
    .grid {
      grid-template-columns: 1fr;
    }
    .visual {
      width: min(70%, 18rem);
    }
  }
</style>
