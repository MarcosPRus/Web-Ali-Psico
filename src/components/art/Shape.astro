---
/** Formas recortadas decorativas (siempre decorativas: aria-hidden). */
type Name = "leaf" | "sun" | "star" | "blob" | "sprig" | "squiggle" | "pebble" | "flower";
interface Props {
  name: Name;
  color?: string;
  size?: string;
  class?: string;
  style?: string;
}
const { name, color = "var(--terracotta)", size = "6rem", class: className, style = "" } = Astro.props;

// sol festoneado: 14 ondas alrededor de un círculo
const sun = (() => {
  const n = 14, R = 50, r = 42, pts: string[] = [];
  for (let i = 0; i < n * 2; i++) {
    const a = (Math.PI * i) / n;
    const rad = i % 2 === 0 ? R : r;
    pts.push(`${(60 + rad * Math.cos(a)).toFixed(1)} ${(60 + rad * Math.sin(a)).toFixed(1)}`);
  }
  let d = `M${pts[0]}`;
  for (let i = 1; i < pts.length; i += 2) d += ` Q${pts[i]} ${pts[(i + 1) % pts.length]}`;
  return d + "Z";
})();

// estrella de 8 puntas redondeada (✺)
const star = (() => {
  const n = 8, pts: string[] = [];
  for (let i = 0; i < n * 2; i++) {
    const a = (Math.PI * i) / n - Math.PI / 2;
    const rad = i % 2 === 0 ? 56 : 20;
    pts.push(`${(60 + rad * Math.cos(a)).toFixed(1)},${(60 + rad * Math.sin(a)).toFixed(1)}`);
  }
  return `M${pts.join("L")}Z`;
})();
---

<svg
  class:list={["shape", className]}
  viewBox="0 0 120 120"
  style={`width:${size};height:auto;color:${color};${style}`}
  aria-hidden="true"
  fill="currentColor"
>
  {name === "leaf" && <path d="M8 60 C 30 22, 80 14, 112 60 C 80 106, 30 98, 8 60 Z" />}
  {name === "sun" && <path d={sun} />}
  {name === "star" && <path d={star} stroke="currentColor" stroke-width="10" stroke-linejoin="round" />}
  {name === "blob" && (
    <path d="M60 6 C 92 4, 116 30, 112 62 C 110 94, 86 116, 56 114 C 24 112, 4 88, 8 58 C 10 30, 30 8, 60 6 Z" />
  )}
  {name === "pebble" && <path d="M16 70 C 10 40, 40 18, 72 22 C 104 26, 116 54, 104 80 C 92 104, 26 104, 16 70 Z" />}
  {name === "sprig" && (
    <g>
      <path d="M60 116 C 58 80, 62 40, 72 6" stroke="currentColor" stroke-width="4" fill="none" stroke-linecap="round" />
      <path d="M60 92 C 44 90, 30 78, 26 64 C 42 64, 56 74, 60 92 Z" />
      <path d="M62 72 C 76 70, 90 58, 94 44 C 78 44, 64 54, 62 72 Z" />
      <path d="M64 50 C 50 48, 38 36, 36 22 C 50 24, 62 34, 64 50 Z" />
      <path d="M70 26 C 80 22, 88 12, 88 2 C 78 6, 70 14, 70 26 Z" />
    </g>
  )}
  {name === "squiggle" && (
    <path
      d="M6 70 C 20 40, 34 40, 40 60 S 60 84, 70 56 S 96 30, 114 52"
      stroke="currentColor"
      stroke-width="8"
      fill="none"
      stroke-linecap="round"
    />
  )}
  {name === "flower" && (
    <g>
      {[0, 60, 120, 180, 240, 300].map((r) => (
        <ellipse cx="60" cy="30" rx="18" ry="28" transform={`rotate(${r} 60 60)`} />
      ))}
      <circle cx="60" cy="60" r="16" fill="var(--butter)" />
    </g>
  )}
</svg>

<style>
  .shape {
    display: block;
    flex: none;
  }
</style>
