---
/**
 * Ilustraciones "recortadas" (papel recortado, estilo collage) que hacen de
 * imágenes provisionales. Todas son SVG: pesan casi nada y escalan perfecto.
 *
 * Para usar una foto real en su lugar, usa <Media src="/img/tu-foto.jpg" />
 * en vez de <Media scene="..." />.
 */
export type Scene =
  | "retrato"
  | "mesa"
  | "espejo"
  | "sol"
  | "jardin"
  | "abrazo"
  | "pantalla"
  | "jarrones"
  | "taza"
  | "ventana";

interface Props {
  scene: Scene;
  label?: string;
  class?: string;
}
const { scene, label, class: className } = Astro.props;
const u = Math.random().toString(36).slice(2, 8);

const C = {
  oat: "#f5efe3",
  paper: "#fdfbf6",
  sand: "#e9e0d0",
  clay: "#d9ccb6",
  skin: "#e6bd9c",
  ink: "#1d1a1e",
  wine: "#4f3242",
  terra: "#e8913f",
  terraD: "#a8463c",
  blush: "#f2c3c4",
  rose: "#e48f9a",
  lilac: "#c2d3e1",
  lilac2: "#7f93c9",
  lilacD: "#2f4aa8",
  sage: "#a9cfbf",
  sageD: "#4f8a7c",
  butter: "#f0e08e",
};

const leaf = "M0 0 C 18 -22, 52 -26, 80 0 C 52 26, 18 22, 0 0 Z";
---

<svg
  class:list={["art", className]}
  viewBox="0 0 400 500"
  preserveAspectRatio="xMidYMid slice"
  xmlns="http://www.w3.org/2000/svg"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
>
  <defs>
    <linearGradient id={`g1${u}`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color={C.butter} />
      <stop offset="1" stop-color={C.blush} />
    </linearGradient>
    <linearGradient id={`g2${u}`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color={C.lilac} />
      <stop offset="1" stop-color={C.blush} />
    </linearGradient>
    <radialGradient id={`g3${u}`} cx=".3" cy=".25" r=".9">
      <stop offset="0" stop-color="#fff" stop-opacity=".55" />
      <stop offset=".6" stop-color="#fff" stop-opacity="0" />
    </radialGradient>
  </defs>

  {/* ───────────── Retrato (provisional para la foto de Ali) ───────────── */}
  {scene === "retrato" && (
    <g>
      <rect width="400" height="500" fill={C.blush} />
      <circle cx="268" cy="150" r="104" fill={C.butter} />
      <g transform="translate(24 430) rotate(-58)" fill={C.sageD}>
        <path d={leaf} transform="scale(1.9)" />
      </g>
      <g transform="translate(360 330) rotate(-128)" fill={C.sage}>
        <path d={leaf} transform="scale(1.5)" />
      </g>
      {/* hombros */}
      <path d="M22 500 C 30 420, 96 384, 200 378 C 304 384, 370 420, 378 500 Z" fill={C.terra} />
      {/* pelo de fondo */}
      <path d="M128 250 C 118 170, 160 132, 206 134 C 258 136, 290 176, 280 250 C 286 310, 282 360, 262 392 L 142 392 C 122 360, 120 310, 128 250 Z" fill={C.wine} />
      {/* cuello */}
      <path d="M170 290 L230 290 L236 380 Q200 404 164 380 Z" fill={C.skin} />
      <path d="M170 318 Q200 340 230 318 L231 330 Q200 350 169 330 Z" fill="#d9a888" />
      {/* escote */}
      <path d="M150 382 Q200 420 250 382 Q244 376 236 374 Q200 404 164 374 Q156 376 150 382 Z" fill={C.oat} />
      {/* cara */}
      <ellipse cx="202" cy="236" rx="58" ry="72" fill={C.skin} />
      {/* flequillo / raya */}
      <path d="M142 232 C 140 180, 172 156, 210 158 C 246 160, 266 186, 262 226 C 250 196, 230 184, 206 186 C 186 196, 168 214, 142 232 Z" fill={C.wine} />
      {/* moño */}
      <circle cx="250" cy="138" r="30" fill={C.wine} />
      {/* pendientes */}
      <circle cx="145" cy="262" r="6" fill={C.butter} />
      <circle cx="259" cy="262" r="6" fill={C.butter} />
      <g stroke={C.wine} stroke-width="3" fill="none" stroke-linecap="round">
        <path d="M170 244 q 8 6 16 0" /><path d="M218 244 q 8 6 16 0" />
      </g>
      {/* mejillas */}
      <ellipse cx="176" cy="262" rx="12" ry="7" fill={C.rose} opacity=".55" />
      <ellipse cx="228" cy="262" rx="12" ry="7" fill={C.rose} opacity=".55" />
      <path d="M188 286 Q202 294 216 286" stroke={C.terraD} stroke-width="3" fill="none" stroke-linecap="round" />
    </g>
  )}

  {/* ───────────── Mesa: bodegón con limón y pera ───────────── */}
  {scene === "mesa" && (
    <g>
      <rect width="400" height="500" fill={C.lilac} />
      <circle cx="318" cy="108" r="58" fill={C.butter} />
      <rect y="318" width="400" height="182" fill={C.oat} />
      <g opacity=".45" stroke={C.terra} stroke-width="6">
        {Array.from({ length: 11 }).map((_, i) => <line x1={i * 40 + 10} y1="318" x2={i * 40 - 30} y2="500" />)}
      </g>
      {/* jarra */}
      <ellipse cx="108" cy="340" rx="58" ry="10" fill={C.wine} opacity=".14" />
      <path d="M72 336 C 58 300, 64 250, 88 226 L 86 196 L 128 196 L 126 226 C 150 250, 156 300, 142 336 Z" fill={C.terra} />
      <path d="M140 250 C 172 248, 172 300, 146 306" stroke={C.terra} stroke-width="10" fill="none" />
      <path d="M92 250 C 88 272, 88 296, 96 318" stroke={C.blush} stroke-width="5" fill="none" stroke-linecap="round" opacity=".7" />
      {/* ramita en la jarra */}
      <path d="M106 198 C 100 150, 118 110, 140 84" stroke={C.sageD} stroke-width="4" fill="none" />
      <g fill={C.sageD}>
        <path d={leaf} transform="translate(112 150) rotate(-150) scale(.5)" />
        <path d={leaf} transform="translate(118 128) rotate(-20) scale(.5)" />
        <path d={leaf} transform="translate(130 104) rotate(-160) scale(.45)" />
      </g>
      {/* plato */}
      <ellipse cx="224" cy="398" rx="132" ry="42" fill={C.wine} opacity=".12" />
      <ellipse cx="224" cy="388" rx="128" ry="40" fill={C.paper} />
      <ellipse cx="224" cy="388" rx="92" ry="26" fill="none" stroke={C.sand} stroke-width="4" />
      {/* limón */}
      <g transform="rotate(-14 196 368)">
        <ellipse cx="196" cy="368" rx="46" ry="33" fill={C.butter} />
        <ellipse cx="148" cy="368" rx="8" ry="6" fill={C.butter} />
        <ellipse cx="244" cy="368" rx="8" ry="6" fill={C.butter} />
        <ellipse cx="184" cy="356" rx="16" ry="8" fill="#fff" opacity=".35" />
      </g>
      {/* medio limón */}
      <g transform="translate(270 384)">
        <ellipse rx="30" ry="12" fill={C.butter} />
        <ellipse rx="24" ry="9" fill="#f8e6a8" />
        <g stroke={C.butter} stroke-width="2">
          <line x1="-22" y1="0" x2="22" y2="0" /><line x1="0" y1="-8" x2="0" y2="8" />
          <line x1="-15" y1="-6" x2="15" y2="6" /><line x1="-15" y1="6" x2="15" y2="-6" />
        </g>
      </g>
      {/* pera */}
      <ellipse cx="316" cy="340" rx="42" ry="8" fill={C.wine} opacity=".14" />
      <path d="M316 232 C 302 240, 298 268, 304 282 C 276 296, 276 338, 316 340 C 356 338, 356 296, 328 282 C 334 268, 330 240, 316 232 Z" fill={C.sage} />
      <path d="M316 234 Q 318 214 330 204" stroke={C.wine} stroke-width="4" fill="none" stroke-linecap="round" />
      <path d={leaf} transform="translate(322 214) rotate(-30) scale(.42)" fill={C.sageD} />
      <path d="M296 300 C 290 314, 294 326, 304 332" stroke="#fff" stroke-width="5" fill="none" stroke-linecap="round" opacity=".35" />
    </g>
  )}

  {/* ───────────── Espejo: imagen corporal ───────────── */}
  {scene === "espejo" && (
    <g>
      <rect width="400" height="500" fill={C.sage} />
      <rect y="420" width="400" height="80" fill={C.oat} />
      <ellipse cx="200" cy="430" rx="120" ry="12" fill={C.wine} opacity=".14" />
      <ellipse cx="200" cy="232" rx="122" ry="178" fill={C.terra} />
      <ellipse cx="200" cy="232" rx="102" ry="158" fill={`url(#g2${u})`} />
      <circle cx="232" cy="176" r="46" fill={C.butter} opacity=".9" />
      {/* silueta suave reflejada */}
      <path d="M130 390 C 132 330, 160 300, 200 298 C 240 300, 268 330, 270 390 Q 200 400 130 390 Z" fill={C.lilac2} opacity=".85" />
      <circle cx="200" cy="258" r="30" fill={C.lilac2} opacity=".85" />
      <ellipse cx="200" cy="232" rx="102" ry="158" fill={`url(#g3${u})`} />
      <path d="M130 130 C 140 100, 160 86, 180 80" stroke="#fff" stroke-width="7" fill="none" stroke-linecap="round" opacity=".7" />
      {/* planta */}
      <path d="M338 500 C 330 440, 340 380, 366 340" stroke={C.wine} stroke-width="5" fill="none" />
      <g fill={C.wine}>
        <path d={leaf} transform="translate(340 440) rotate(-160) scale(.8)" />
        <path d={leaf} transform="translate(346 400) rotate(-30) scale(.75)" />
        <path d={leaf} transform="translate(360 356) rotate(-120) scale(.7)" />
      </g>
      <path d="M60 430 L 40 500 L 110 500 L 92 430 Z" fill={C.terraD} />
      <g fill={C.sageD}>
        <path d={leaf} transform="translate(76 428) rotate(-100) scale(.9)" />
        <path d={leaf} transform="translate(76 428) rotate(-60) scale(.8)" />
        <path d={leaf} transform="translate(76 428) rotate(-140) scale(.75)" />
      </g>
    </g>
  )}

  {/* ───────────── Sol sobre el mar: calma ───────────── */}
  {scene === "sol" && (
    <g>
      <rect width="400" height="500" fill={`url(#g1${u})`} />
      <circle cx="200" cy="300" r="112" fill={C.terra} />
      <path d="M0 290 Q 50 272 100 290 T 200 290 T 300 290 T 400 290 V500 H0 Z" fill={C.lilac} />
      <path d="M0 330 Q 50 312 100 330 T 200 330 T 300 330 T 400 330 V500 H0 Z" fill={C.lilac2} />
      <path d="M0 372 Q 50 354 100 372 T 200 372 T 300 372 T 400 372 V500 H0 Z" fill={C.lilacD} />
      <path d="M0 418 Q 50 400 100 418 T 200 418 T 300 418 T 400 418 V500 H0 Z" fill={C.wine} />
      <g stroke={C.terraD} stroke-width="4" fill="none" stroke-linecap="round">
        <path d="M86 110 q 10 -10 20 0 q 10 -10 20 0" />
        <path d="M130 70 q 7 -7 14 0 q 7 -7 14 0" />
        <path d="M290 132 q 8 -8 16 0 q 8 -8 16 0" />
      </g>
      <rect x="176" y="342" width="48" height="6" rx="3" fill={C.butter} opacity=".8" />
      <rect x="160" y="384" width="80" height="6" rx="3" fill={C.butter} opacity=".6" />
    </g>
  )}

  {/* ───────────── Jardín de hojas (collage) ───────────── */}
  {scene === "jardin" && (
    <g>
      <rect width="400" height="500" fill={C.wine} />
      <g>
        <path d={leaf} transform="translate(40 120) rotate(-30) scale(2.4)" fill={C.blush} />
        <path d={leaf} transform="translate(210 70) rotate(40) scale(1.8)" fill={C.sage} />
        <path d={leaf} transform="translate(360 260) rotate(160) scale(2.6)" fill={C.lilac} />
        <path d={leaf} transform="translate(60 420) rotate(-70) scale(2.2)" fill={C.butter} />
        <path d={leaf} transform="translate(250 470) rotate(-110) scale(1.9)" fill={C.terra} />
        <path d={leaf} transform="translate(140 300) rotate(15) scale(1.3)" fill={C.rose} />
      </g>
      <g fill={C.oat}>
        <circle cx="330" cy="80" r="7" /><circle cx="90" cy="250" r="5" /><circle cx="300" cy="380" r="6" />
        <circle cx="180" cy="200" r="4" /><circle cx="360" cy="450" r="5" />
      </g>
    </g>
  )}

  {/* ───────────── Abrazo: acompañamiento ───────────── */}
  {scene === "abrazo" && (
    <g>
      <rect width="400" height="500" fill={C.butter} />
      <circle cx="320" cy="92" r="40" fill={C.blush} />
      <g>
        <rect x="72" y="232" width="150" height="320" rx="75" fill={C.terra} />
        <circle cx="147" cy="170" r="48" fill={C.terra} />
        <rect x="178" y="262" width="150" height="300" rx="75" fill={C.lilac2} />
        <circle cx="253" cy="200" r="44" fill={C.lilac2} />
        <path d="M300 300 C 260 360, 170 370, 110 330" stroke={C.lilac2} stroke-width="40" fill="none" stroke-linecap="round" />
      </g>
      <g stroke={C.wine} stroke-width="3.5" fill="none" stroke-linecap="round">
        <path d="M130 170 q 6 5 12 0" /><path d="M156 170 q 6 5 12 0" />
        <path d="M238 202 q 6 5 12 0" /><path d="M262 202 q 6 5 12 0" />
      </g>
    </g>
  )}

  {/* ───────────── Pantalla: terapia online ───────────── */}
  {scene === "pantalla" && (
    <g>
      <rect width="400" height="500" fill={C.blush} />
      <rect y="360" width="400" height="140" fill={C.oat} />
      <rect x="70" y="150" width="260" height="176" rx="14" fill={C.wine} />
      <rect x="84" y="164" width="232" height="148" rx="6" fill={C.lilac} />
      <path d="M160 312 V 250 A 40 40 0 0 1 240 250 V 312 Z" fill={C.terra} />
      <circle cx="200" cy="222" r="22" fill={C.skin} />
      <path d="M176 218 C 176 196, 224 196, 224 218 C 214 206, 186 206, 176 218 Z" fill={C.wine} />
      <circle cx="286" cy="190" r="12" fill={C.butter} />
      <path d="M52 326 H 348 L 330 352 H 70 Z" fill={C.ink} />
      {/* taza */}
      <path d="M296 316 h 50 v 26 a 25 20 0 0 1 -50 0 Z" fill={C.paper} transform="translate(0 16)" />
      <path d="M346 340 c 16 0 16 18 0 18" stroke={C.paper} stroke-width="6" fill="none" />
      <g stroke={C.paper} stroke-width="4" fill="none" stroke-linecap="round" opacity=".9">
        <path d="M312 318 c -8 -12 8 -18 0 -30" /><path d="M328 318 c -8 -12 8 -18 0 -30" />
      </g>
      {/* planta */}
      <path d="M40 360 L 30 420 H 90 L 80 360 Z" fill={C.terraD} />
      <g fill={C.sageD}>
        <path d={leaf} transform="translate(60 360) rotate(-95) scale(1.1)" />
        <path d={leaf} transform="translate(60 360) rotate(-50) scale(.9)" />
        <path d={leaf} transform="translate(60 360) rotate(-140) scale(.95)" />
      </g>
    </g>
  )}

  {/* ───────────── Jarrones: todos los cuerpos ───────────── */}
  {scene === "jarrones" && (
    <g>
      <rect width="400" height="500" fill={C.sand} />
      <circle cx="84" cy="98" r="48" fill={C.blush} />
      <rect y="408" width="400" height="92" fill={C.clay} />
      <g stroke={C.sageD} stroke-width="4" fill="none" stroke-linecap="round">
        <path d="M112 300 C 108 240, 96 200, 80 170" />
        <path d="M200 206 C 200 150, 214 110, 236 80" />
        <path d="M306 330 C 312 280, 330 250, 350 230" />
      </g>
      <circle cx="78" cy="164" r="20" fill={C.terra} />
      <circle cx="78" cy="164" r="7" fill={C.butter} />
      <g fill={C.lilacD}>
        <circle cx="238" cy="76" r="12" /><circle cx="226" cy="96" r="10" /><circle cx="246" cy="98" r="9" />
      </g>
      <circle cx="352" cy="226" r="16" fill={C.butter} />
      {/* redondo */}
      <path d="M92 300 L 132 300 L 136 320 C 196 336, 200 404, 150 412 L 74 412 C 24 404, 28 336, 88 320 Z" fill={C.terra} />
      {/* esbelto */}
      <path d="M186 200 L 214 200 L 214 232 C 250 262, 240 360, 226 412 L 174 412 C 160 360, 150 262, 186 232 Z" fill={C.lilac2} />
      {/* ancho y bajo */}
      <path d="M284 330 L 330 330 L 332 344 C 392 350, 386 406, 350 412 L 264 412 C 228 406, 222 350, 282 344 Z" fill={C.sage} />
      <g fill="#fff" opacity=".28">
        <path d="M64 350 C 56 370, 58 390, 70 400 L 76 400 C 66 386, 64 368, 70 352 Z" />
        <path d="M180 260 C 170 300, 172 360, 180 400 L 186 400 C 180 360, 178 300, 186 262 Z" />
      </g>
    </g>
  )}

  {/* ───────────── Taza y libro: blog / lectura ───────────── */}
  {scene === "taza" && (
    <g>
      <rect width="400" height="500" fill={C.terra} />
      {/* libro abierto */}
      <g transform="rotate(-8 200 260)">
        <path d="M60 180 C 110 166, 160 170, 200 190 L 200 380 C 160 360, 110 356, 60 370 Z" fill={C.paper} />
        <path d="M340 180 C 290 166, 240 170, 200 190 L 200 380 C 240 360, 290 356, 340 370 Z" fill={C.oat} />
        <g stroke={C.clay} stroke-width="4" stroke-linecap="round">
          <line x1="86" y1="214" x2="176" y2="222" /><line x1="86" y1="238" x2="176" y2="246" />
          <line x1="86" y1="262" x2="160" y2="268" /><line x1="86" y1="286" x2="176" y2="294" />
          <line x1="224" y1="222" x2="314" y2="214" /><line x1="224" y1="246" x2="314" y2="238" />
          <line x1="224" y1="270" x2="300" y2="262" />
        </g>
        <path d={leaf} transform="translate(236 316) rotate(-12) scale(.9)" fill={C.sageD} />
      </g>
      {/* taza vista cenital */}
      <circle cx="300" cy="410" r="66" fill={C.oat} />
      <circle cx="300" cy="410" r="46" fill={C.paper} />
      <circle cx="300" cy="410" r="36" fill="#b8804f" />
      <circle cx="288" cy="398" r="10" fill="#fff" opacity=".25" />
      <path d="M346 386 c 30 -6 38 26 10 32" stroke={C.paper} stroke-width="12" fill="none" />
      <g fill={C.butter}><circle cx="70" cy="80" r="6" /><circle cx="330" cy="70" r="9" /><circle cx="60" cy="450" r="8" /></g>
    </g>
  )}

  {/* ───────────── Ventana: un lugar tranquilo ───────────── */}
  {scene === "ventana" && (
    <g>
      <rect width="400" height="500" fill={C.sand} />
      <path d="M80 440 V 180 A 120 120 0 0 1 320 180 V 440 Z" fill={C.terra} />
      <path d="M100 440 V 184 A 100 100 0 0 1 300 184 V 440 Z" fill={`url(#g1${u})`} />
      <circle cx="200" cy="250" r="54" fill={C.terra} opacity=".9" />
      <path d="M100 330 Q 150 310 200 330 T 300 330 V 440 H 100 Z" fill={C.sage} />
      <path d="M100 370 Q 150 352 200 370 T 300 370 V 440 H 100 Z" fill={C.sageD} />
      <rect x="196" y="84" width="8" height="356" fill={C.terra} />
      <rect x="100" y="262" width="200" height="8" fill={C.terra} />
      <rect x="60" y="436" width="280" height="18" rx="4" fill={C.wine} />
      <path d="M252 436 C 250 410, 262 392, 282 390 C 300 392, 310 410, 306 436 Z" fill={C.lilac2} />
      <path d="M280 390 C 276 360, 286 336, 302 324" stroke={C.sageD} stroke-width="4" fill="none" />
      <path d={leaf} transform="translate(288 352) rotate(-40) scale(.5)" fill={C.sageD} />
      <circle cx="302" cy="322" r="10" fill={C.rose} />
    </g>
  )}
</svg>
