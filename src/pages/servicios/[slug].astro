---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import SectionHead from "../../components/SectionHead.astro";
import ServiceCard from "../../components/ServiceCard.astro";
import Faq from "../../components/Faq.astro";
import CtaBand from "../../components/CtaBand.astro";
import Icon from "../../components/Icon.astro";
import Shape from "../../components/art/Shape.astro";
import { CONTACT, PRICES } from "../../consts";

export async function getStaticPaths() {
  const services = await getCollection("services");
  return services.map((s) => ({ params: { slug: s.id }, props: { service: s } }));
}

const { service } = Astro.props as { service: CollectionEntry<"services"> };
const d = service.data;
const { Content } = await render(service);
const others = (await getCollection("services"))
  .filter((s) => s.id !== service.id)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
const tone = ({ terracotta: "blush", blush: "blush", lilac: "lilac", sage: "sage", butter: "butter", wine: "blush" } as const)[d.accent];
---

<Base title={d.title} description={d.description}>
  <PageHero
    eyebrow={d.kicker}
    scene={d.scene}
    src={d.heroImage}
    tone={tone}
    crumbs={[{ href: "/servicios", label: "Cómo te ayudo" }, { label: d.title }]}
  >
    {d.title}
    <Fragment slot="lead">{d.short}</Fragment>
    <Fragment slot="actions">
      <a href="/contacto" class="btn">Pide tu primera cita <Icon name="arrow" class="arrow" /></a>
      <a href={CONTACT.whatsapp} class="btn ghost" target="_blank" rel="noopener"><Icon name="whatsapp" /> WhatsApp</a>
    </Fragment>
  </PageHero>

  {
    d.signs.length > 0 && (
      <section class="section signs-sec" style="padding-top:0">
        <div class="container wide">
          <SectionHead eyebrow="¿Es para ti?">
            Quizá te <em>reconozcas</em> si…
          </SectionHead>
          <ul class="signs">
            {d.signs.map((s, i) => (
              <li data-reveal style={`--d:${i % 3}`}>
                <span class="tick">
                  <Icon name="check" size={16} />
                </span>
                {s}
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="section body-sec" style="padding-top:clamp(1rem, 3vw, 2rem)">
    <div class="container wide body-grid">
      <div class="prose" data-reveal>
        <Content />
      </div>
      <aside class="side" data-reveal style="--d:1">
        <div class="card">
          <Shape name="sun" color="var(--butter)" size="4rem" class="card-sun" />
          <h2>Formato</h2>
          <ul>
            <li><Icon name="clock" size={18} /> Sesiones de 50 minutos</li>
            <li><Icon name="pin" size={18} /> Tomares, Dos Hermanas o Mairena</li>
            <li><Icon name="video" size={18} /> También online</li>
            <li><Icon name="euro" size={18} /> Desde {PRICES[1].price} la sesión</li>
          </ul>
          <a href="/contacto" class="btn">Reservar <Icon name="arrow" class="arrow" /></a>
          <a href={CONTACT.phoneHref} class="phone">o llama al {CONTACT.phone}</a>
        </div>
      </aside>
    </div>
  </section>

  {
    d.approach.length > 0 && (
      <section class="section on-dark approach">
        <div class="container wide">
          <SectionHead eyebrow="Cómo trabajamos">
            Cómo lo <em>trabajaremos</em>
          </SectionHead>
          <ol class="steps">
            {d.approach.map((a, i) => (
              <li data-reveal style={`--d:${i}`}>
                <span class="n">0{i + 1}</span>
                <h3>{a.title}</h3>
                <p>{a.text}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )
  }

  {
    d.faqs.length > 0 && (
      <section class="section">
        <div class="container narrow">
          <SectionHead eyebrow="Preguntas frecuentes" align="center">
            Dudas <em>habituales</em>
          </SectionHead>
          <Faq items={d.faqs} name={`faq-${service.id}`} />
        </div>
      </section>
    )
  }

  <section class="section others">
    <div class="container wide">
      <SectionHead eyebrow="Sigue explorando">
        También puedo <em>ayudarte con</em>
      </SectionHead>
      <div class="cards">
        {others.map((s) => <ServiceCard service={s} index={s.data.order - 1} />)}
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .signs {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .signs li {
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
    padding: 1.4rem 1.5rem;
    border-radius: var(--radius-lg);
    background: var(--paper);
    box-shadow: inset 0 0 0 1px var(--line);
    font-family: var(--serif);
    font-size: var(--step-1);
    font-weight: 350;
    line-height: 1.35;
  }
  .tick {
    flex: none;
    display: grid;
    place-items: center;
    width: 1.8rem;
    height: 1.8rem;
    border-radius: 50%;
    background: var(--terracotta);
    color: #fff;
    margin-top: 0.1rem;
  }
  .body-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }
  .body-sec .prose {
    max-width: 40rem;
  }
  .body-sec .prose > :global(p:first-child) {
    font-family: var(--serif);
    font-size: var(--step-2);
    font-weight: 330;
    line-height: 1.35;
    color: var(--ink);
  }
  .side {
    position: sticky;
    top: 7rem;
  }
  .card {
    position: relative;
    display: grid;
    gap: 1.25rem;
    padding: 2rem;
    border-radius: var(--radius-lg);
    background: #fff;
    box-shadow: var(--shadow);
  }
  .card :global(.card-sun) {
    position: absolute;
    top: -1.5rem;
    right: -1rem;
    animation: spin 40s linear infinite;
  }
  .card h2 {
    font-size: var(--step-2);
  }
  .card ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  .card li {
    display: flex;
    gap: 0.6rem;
    align-items: center;
  }
  .card li :global(.icon) {
    color: var(--terracotta-ink);
  }
  .phone {
    font-size: 0.92rem;
    color: var(--ink-2);
    text-align: center;
  }
  .approach {
    border-radius: calc(var(--radius-lg) * 1.5);
    margin-inline: clamp(0.5rem, 1.5vw, 1.5rem);
  }
  .steps {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1rem;
  }
  .steps li {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    padding: 1.75rem;
    border-radius: var(--radius-lg);
    background: color-mix(in oklab, var(--oat) 7%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--oat) 14%, transparent);
  }
  .n {
    font-family: var(--serif);
    font-style: italic;
    font-size: var(--step-3);
    color: var(--blush);
    line-height: 1;
  }
  .steps h3 {
    font-size: var(--step-1);
  }
  .steps p {
    color: color-mix(in oklab, var(--oat) 75%, transparent);
    font-size: 0.97rem;
  }
  .others .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  @media (max-width: 60rem) {
    .signs,
    .others .cards {
      grid-template-columns: 1fr 1fr;
    }
    .body-grid {
      grid-template-columns: 1fr;
    }
    .side {
      position: static;
    }
  }
  @media (max-width: 40rem) {
    .signs,
    .others .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
