---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import SectionHead from "../../components/SectionHead.astro";
import ServiceCard from "../../components/ServiceCard.astro";
import Steps from "../../components/Steps.astro";
import CtaBand from "../../components/CtaBand.astro";
import Icon from "../../components/Icon.astro";
import Shape from "../../components/art/Shape.astro";
import { PRICE, LOCATIONS } from "../../consts";

const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="Cómo te puedo ayudar"
  description="Terapia psicológica para TCA, imagen corporal, psiconutrición, ansiedad y familias. Presencial en Tomares, Dos Hermanas y Mairena, y online."
>
  <PageHero eyebrow="Servicios" scene="jarrones" tone="lilac" crumbs={[{ label: "Cómo te ayudo" }]}>
    Cómo te puedo <em>ayudar</em>
    <Fragment slot="lead">
      Cada historia es distinta, pero casi todas empiezan igual: con la sensación de que la comida o el cuerpo ocupan
      demasiado espacio. Estas son las áreas en las que trabajo.
    </Fragment>
  </PageHero>

  <section class="section" style="padding-top:0">
    <div class="container wide cards">
      {services.map((s, i) => <ServiceCard service={s} index={i} />)}
    </div>
  </section>

  <section class="section formats">
    <div class="container wide formats-grid">
      <div class="formats-copy">
        <SectionHead eyebrow="Modalidades y tarifas">
          Presencial u online, <em>tú eliges</em>
          <Fragment slot="lead">
            Una sola tarifa, sin letra pequeña: todas las sesiones cuestan lo mismo, estés donde estés.
          </Fragment>
        </SectionHead>
        <ul class="places" data-reveal>
          {
            LOCATIONS.map((l) => (
              <li>
                <Icon name={l.id === "online" ? "video" : "pin"} size={18} />
                <strong>{l.name}</strong>
                <span>{l.id === "online" ? "Videollamada" : l.lines[0]}</span>
              </li>
            ))
          }
        </ul>
        <p class="fine muted" data-reveal>
          Cancelaciones: te pido avisar con al menos 24&nbsp;h de antelación para poder ofrecer el hueco a otra persona.
        </p>
      </div>

      <article class="price" data-reveal style="--d:1" aria-label="Tarifa">
        <Shape name="sun" color="var(--butter)" size="6.5rem" class="badge" />
        <p class="kicker">Sesión individual</p>
        <p class="amount">{PRICE.amount}</p>
        <p class="time"><Icon name="clock" size={18} /> {PRICE.durationShort} de sesión</p>
        <ul class="incl">
          <li><Icon name="check" size={18} /> La primera sesión, también</li>
          <li><Icon name="check" size={18} /> Mismo precio presencial u online</li>
          <li><Icon name="check" size={18} /> Tomares, Dos Hermanas o Mairena</li>
        </ul>
        <a href="/contacto" class="btn light">Pide tu primera cita <Icon name="arrow" class="arrow" /></a>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead eyebrow="Cómo empezamos" align="center">
        Tres pasos <em>sin prisa</em>
      </SectionHead>
      <Steps />
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1rem, 2vw, 1.5rem);
  }
  .formats {
    background: var(--sand);
  }
  .formats-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }
  .formats-copy :global(.section-head) {
    margin-bottom: 2rem;
  }
  .price {
    position: relative;
    display: grid;
    gap: 1rem;
    justify-items: start;
    padding: clamp(2rem, 4vw, 3rem);
    border-radius: calc(var(--radius-lg) * 1.3);
    background: var(--ink);
    color: var(--oat);
    box-shadow: var(--shadow);
  }
  .price :global(.badge) {
    position: absolute;
    top: -2.2rem;
    right: 2rem;
    animation: spin 30s linear infinite;
  }
  .kicker {
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--blush);
  }
  .amount {
    font-family: var(--serif);
    font-size: clamp(4rem, 3rem + 5vw, 7rem);
    font-weight: 300;
    line-height: 0.9;
    letter-spacing: -0.04em;
  }
  .time {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
  }
  .incl {
    list-style: none;
    padding: 1.25rem 0 0.5rem;
    margin-top: 0.25rem;
    border-top: 1px solid color-mix(in oklab, var(--oat) 18%, transparent);
    display: grid;
    gap: 0.6rem;
    width: 100%;
  }
  .incl li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: color-mix(in oklab, var(--oat) 85%, transparent);
  }
  .incl :global(.icon) {
    color: var(--blush);
  }
  .places {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .places li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.1rem;
    border-radius: 999px;
    background: var(--paper);
    font-size: 0.95rem;
  }
  .places :global(.icon) {
    color: var(--terracotta-ink);
  }
  .places span {
    color: var(--ink-2);
  }
  .fine {
    margin-top: 1.5rem;
    font-size: 0.92rem;
  }
  @media (max-width: 60rem) {
    .cards {
      grid-template-columns: 1fr 1fr;
    }
    .formats-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 40rem) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
