---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import SectionHead from "../../components/SectionHead.astro";
import Media from "../../components/art/Media.astro";
import Steps from "../../components/Steps.astro";
import CtaBand from "../../components/CtaBand.astro";
import Icon from "../../components/Icon.astro";
import Shape from "../../components/art/Shape.astro";
import { PRICE, LOCATIONS } from "../../consts";

const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="Cómo te puedo ayudar"
  description="Terapia psicológica para ansiedad, autoestima, relaciones, TCA, imagen corporal y familias. Presencial en Tomares, Dos Hermanas y Mairena, y online."
>
  <PageHero eyebrow="Servicios" scene="jarrones" tone="lilac" crumbs={[{ label: "Cómo te ayudo" }]}>
    Cómo te puedo <em>ayudar</em>
    <Fragment slot="lead">
      Cada historia es distinta y cada proceso también. Estas son las áreas en las que trabajo; si lo tuyo no encaja del
      todo en ninguna, escríbeme y lo vemos.
    </Fragment>
  </PageHero>

  <section class="section" style="padding-top:0">
    <div class="container wide areas">
      {
        services.map((s, i) => (
          <article class="area" id={s.id} data-reveal style={`--d:${i % 2}`}>
            <Media scene={s.data.scene} src={s.data.heroImage} ratio="1 / 1" class="thumb" />
            <div class="body">
              <p class="kicker">{s.data.kicker}</p>
              <h2>{s.data.title}</h2>
              <p class="summary">{s.data.summary}</p>
              {s.data.points.length > 0 && (
                <ul class="points">
                  {s.data.points.map((pt) => (
                    <li>
                      <Icon name="check" size={16} /> {pt}
                    </li>
                  ))}
                </ul>
              )}
              {s.data.post && (
                <a class="link" href={`/blog/${s.data.post}`}>
                  Leer más en el blog <Icon name="arrow" size={16} />
                </a>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section formats">
    <div class="container wide formats-grid">
      <div class="formats-copy">
        <SectionHead eyebrow="Modalidades y tarifas">
          Presencial u online, <em>tú eliges</em>
          <Fragment slot="lead">
            Una sola tarifa, sin letra pequeña: todas las sesiones cuestan lo mismo, estés donde estés.
          </Fragment>
        </SectionHead>
        <ul class="places" data-reveal>
          {
            LOCATIONS.map((l) => (
              <li>
                <Icon name={l.id === "online" ? "video" : "pin"} size={18} />
                <strong>{l.name}</strong>
                <span>{l.id === "online" ? "Videollamada" : l.lines[0]}</span>
              </li>
            ))
          }
        </ul>
        <p class="fine muted" data-reveal>
          Cancelaciones: te pido avisar con al menos 24&nbsp;h de antelación para poder ofrecer el hueco a otra persona.
        </p>
      </div>

      <article class="price" data-reveal style="--d:1" aria-label="Tarifa">
        <Shape name="sun" color="var(--butter)" size="6.5rem" class="badge" />
        <p class="kicker">Sesión individual</p>
        <p class="amount">{PRICE.amount}</p>
        <p class="time"><Icon name="clock" size={18} /> {PRICE.durationShort} de sesión</p>
        <ul class="incl">
          <li><Icon name="check" size={18} /> La primera sesión, también</li>
          <li><Icon name="check" size={18} /> Mismo precio presencial u online</li>
          <li><Icon name="check" size={18} /> Tomares, Dos Hermanas o Mairena</li>
        </ul>
        <a href="/contacto" class="btn light">Pide tu primera cita <Icon name="arrow" class="arrow" /></a>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead eyebrow="Cómo empezamos" align="center">
        Tres pasos <em>sin prisa</em>
      </SectionHead>
      <Steps />
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .areas {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1rem, 2vw, 1.5rem);
  }
  .area {
    display: grid;
    grid-template-columns: clamp(7rem, 12vw, 10rem) 1fr;
    gap: clamp(1.25rem, 2.5vw, 2rem);
    align-items: start;
    padding: clamp(1rem, 2vw, 1.5rem);
    border-radius: calc(var(--radius-lg) + 0.5rem);
    background: var(--paper);
    box-shadow: inset 0 0 0 1px var(--line);
    scroll-margin-top: 7rem;
    transition: box-shadow 0.5s var(--ease), background-color 0.4s;
  }
  .area:hover,
  .area:target {
    background: #fff;
    box-shadow: var(--shadow);
  }
  .area :global(.thumb) {
    border-radius: var(--radius);
  }
  .body {
    display: grid;
    gap: 0.6rem;
    justify-items: start;
  }
  .area .kicker {
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--terracotta-ink);
  }
  .area h2 {
    font-size: var(--step-2);
  }
  .summary {
    color: var(--ink-2);
    font-size: 0.98rem;
  }
  .points {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.35rem;
    margin-block: 0.2rem 0.4rem;
    font-size: 0.93rem;
    font-weight: 500;
  }
  .points li {
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
  }
  .points :global(.icon) {
    color: var(--sage-ink);
    margin-top: 0.25rem;
  }
  .area .link {
    color: var(--terracotta-ink);
    font-size: 0.95rem;
  }
  .formats {
    background: var(--sand);
  }
  .formats-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }
  .formats-copy :global(.section-head) {
    margin-bottom: 2rem;
  }
  .price {
    position: relative;
    display: grid;
    gap: 1rem;
    justify-items: start;
    padding: clamp(2rem, 4vw, 3rem);
    border-radius: calc(var(--radius-lg) * 1.3);
    background: var(--ink);
    color: var(--oat);
    box-shadow: var(--shadow);
  }
  .price :global(.badge) {
    position: absolute;
    top: -2.2rem;
    right: 2rem;
    animation: spin 30s linear infinite;
  }
  .kicker {
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--blush);
  }
  .amount {
    font-family: var(--serif);
    font-size: clamp(4rem, 3rem + 5vw, 7rem);
    font-weight: 300;
    line-height: 0.9;
    letter-spacing: -0.04em;
  }
  .time {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
  }
  .incl {
    list-style: none;
    padding: 1.25rem 0 0.5rem;
    margin-top: 0.25rem;
    border-top: 1px solid color-mix(in oklab, var(--oat) 18%, transparent);
    display: grid;
    gap: 0.6rem;
    width: 100%;
  }
  .incl li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: color-mix(in oklab, var(--oat) 85%, transparent);
  }
  .incl :global(.icon) {
    color: var(--blush);
  }
  .places {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .places li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.1rem;
    border-radius: 999px;
    background: var(--paper);
    font-size: 0.95rem;
  }
  .places :global(.icon) {
    color: var(--terracotta-ink);
  }
  .places span {
    color: var(--ink-2);
  }
  .fine {
    margin-top: 1.5rem;
    font-size: 0.92rem;
  }
  @media (max-width: 60rem) {
    .areas {
      grid-template-columns: 1fr;
    }
    .formats-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 40rem) {
    .area {
      grid-template-columns: 1fr;
    }
    .area :global(.thumb) {
      aspect-ratio: 16 / 9 !important;
    }
  }
</style>
