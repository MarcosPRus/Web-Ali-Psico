---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import SectionHead from "../../components/SectionHead.astro";
import Steps from "../../components/Steps.astro";
import CtaBand from "../../components/CtaBand.astro";
import Icon from "../../components/Icon.astro";
import Silueta from "../../components/Silueta.astro";
import { PRICE, LOCATIONS } from "../../consts";

const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="Cómo te puedo ayudar"
  description="Terapia psicológica para ansiedad, autoestima, relaciones, TCA, imagen corporal y familias. Presencial en Tomares, Dos Hermanas y Mairena, y online."
>
  <PageHero eyebrow="Especialidades" crumbs={[{ label: "Cómo te ayudo" }]}>
    Cómo te puedo <em>ayudar</em>
    <Fragment slot="lead">
      Cada historia es distinta y cada proceso también. Estas son las áreas en las que trabajo; si lo tuyo no encaja del
      todo en ninguna, escríbeme y lo vemos.
    </Fragment>
  </PageHero>

  <section class="areas-sec">
    <div class="container">
      <ol class="areas">
        {
          services.map((s, i) => (
            <li class="area" id={s.id} data-reveal>
              <span class="mota-num" style={i % 2 ? "border-radius:var(--mota-b)" : undefined}>
                {String(i + 1).padStart(2, "0")}
              </span>
              <div class="area-head">
                <p class="eyebrow">{s.data.kicker}</p>
                <h2>{s.data.title}</h2>
              </div>
              <div class="area-body">
                <p class="summary">{s.data.summary}</p>
                {s.data.points.length > 0 && (
                  <ul class="points">
                    {s.data.points.map((pt) => (
                      <li>{pt}</li>
                    ))}
                  </ul>
                )}
                {s.data.post && (
                  <a class="link" href={`/blog/${s.data.post}`}>
                    Leer más en el blog <Icon name="arrow" size={16} />
                  </a>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="bloque on-cobalto tarifas" aria-labelledby="tar-title">
    <Silueta gato="maddy" class="tar-maddy" />
    <div class="container g12">
      <div class="tar-copy">
        <p class="eyebrow" data-reveal>Modalidades y tarifas</p>
        <h2 id="tar-title" data-reveal style="--d:1">Presencial u online, <em>tú eliges</em></h2>
        <p class="lead" data-reveal style="--d:2">
          Una sola tarifa, sin letra pequeña: todas las sesiones cuestan lo mismo, estés donde estés.
        </p>
        <ul class="places" data-reveal style="--d:3">
          {
            LOCATIONS.map((l) => (
              <li>
                <strong>{l.name}</strong>
                <span>{l.id === "online" ? "Videollamada segura" : l.lines[0]}</span>
              </li>
            ))
          }
        </ul>
        <p class="fine" data-reveal>
          Cancelaciones: te pido avisar con al menos 24&nbsp;h de antelación para poder ofrecer el hueco a otra persona.
        </p>
      </div>

      <article class="price" data-reveal style="--d:1" aria-label="Tarifa">
        <p class="eyebrow">Sesión individual</p>
        <p class="amount">{PRICE.amount}</p>
        <p class="time"><Icon name="clock" size={18} /> {PRICE.duration}</p>
        <ul class="incl">
          <li>La primera sesión, también</li>
          <li>Mismo precio presencial u online</li>
          <li>Tomares, Dos Hermanas o Mairena</li>
        </ul>
        <a href="/contacto" class="btn">Pide tu primera cita <Icon name="arrow" class="arrow" /></a>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead eyebrow="Cómo empezamos">
        Tres pasos <em>sin prisa</em>
      </SectionHead>
      <Steps />
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .areas {
    list-style: none;
    padding: 0;
    background: var(--trazo) 0 0 / 100% 9px no-repeat;
  }
  .area {
    display: grid;
    grid-template-columns: 4rem minmax(0, 5fr) minmax(0, 6fr);
    gap: 1rem var(--col-gap);
    padding-block: clamp(2rem, 4vw, 3rem);
    background: var(--trazo-fino) 0 100% / 100% 7px no-repeat;
    scroll-margin-top: 7rem;
  }
  .area:target {
    background-color: var(--celadon);
    -webkit-mask: var(--m-forma-2) 0 0 / 100% 100% no-repeat;
    mask: var(--m-forma-2) 0 0 / 100% 100% no-repeat;
    padding-inline: 1.25rem;
  }
  .area-head {
    display: grid;
    gap: 0.6rem;
    align-content: start;
  }
  .area h2 {
    font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.75rem);
    letter-spacing: -0.035em;
  }
  .area-body {
    display: grid;
    gap: 1.1rem;
    justify-items: start;
  }
  .summary {
    font-size: var(--t-lg);
  }
  .points {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.45rem;
    color: var(--gris);
  }
  .points li {
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
  }
  .points li::before {
    content: "";
    flex: none;
    width: 0.6rem;
    height: 0.5rem;
    border-radius: var(--mota);
    background: var(--cobalto);
    translate: 0 -0.1em;
  }

  .tarifas {
    margin-top: clamp(5rem, 9vw, 8rem);
  }
  .tarifas :global(.tar-maddy) {
    left: clamp(3rem, 10vw, 8rem);
    bottom: calc(100% - 0.4rem);
  }
  .tarifas .g12 {
    row-gap: 3rem;
    align-items: start;
  }
  .tar-copy {
    grid-column: 1 / span 6;
    display: grid;
    gap: 1.25rem;
  }
  .places {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem var(--col-gap);
    margin-top: 0.5rem;
  }
  .places li {
    display: grid;
    padding-top: 0.75rem;
    background: var(--trazo-blanco) 0 0 / 100% 9px no-repeat;
  }
  .places span {
    color: var(--cobalto-suave);
    font-size: var(--t-sm);
  }
  .fine {
    font-size: var(--t-sm);
    color: var(--cobalto-suave);
  }
  .price {
    grid-column: 8 / span 5;
    display: grid;
    gap: 0.9rem;
    justify-items: start;
    padding: clamp(1.75rem, 3vw, 2.5rem);
    background: var(--blanco);
    color: var(--tinta);
    -webkit-mask: var(--m-forma-3) 0 0 / 100% 100% no-repeat;
    mask: var(--m-forma-3) 0 0 / 100% 100% no-repeat;
  }
  .price .eyebrow {
    color: var(--cobalto);
  }
  .amount {
    font-size: clamp(4rem, 3rem + 4vw, 6.5rem);
    font-weight: 500;
    line-height: 0.9;
    letter-spacing: -0.05em;
  }
  .time {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    color: var(--gris);
  }
  .incl {
    list-style: none;
    padding: 0.9rem 0 0.5rem;
    width: 100%;
    background: var(--trazo) 0 0 / 100% 9px no-repeat;
    display: grid;
    gap: 0.4rem;
  }
  @media (max-width: 56rem) {
    .area {
      grid-template-columns: 3.25rem 1fr;
    }
    .area-body {
      grid-column: 2;
    }
    .tar-copy,
    .price {
      grid-column: 1 / -1;
    }
  }
</style>
