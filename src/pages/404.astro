---
import Base from "../layouts/Base.astro";
import Media from "../components/art/Media.astro";
import Icon from "../components/Icon.astro";
---

<Base title="Página no encontrada">
  <section class="section nf">
    <div class="container narrow wrap">
      <Media scene="ventana" shape="arch" ratio="4 / 5" class="art" />
      <p class="eyebrow">Error 404</p>
      <h1>Esta página se ha ido <em>a dar un paseo</em></h1>
      <p class="lead">No pasa nada: a veces perderse también es parte del camino. Te ayudo a volver.</p>
      <div class="btns">
        <a class="btn" href="/">Volver al inicio <Icon name="arrow" class="arrow" /></a>
        <a class="btn ghost" href="/contacto">Contactar</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .wrap {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1.25rem;
  }
  .wrap :global(.art) {
    width: 12rem;
    margin-bottom: 1rem;
  }
  h1 {
    font-size: var(--step-4);
  }
  .btns {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }
</style>
