---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Silueta from "../components/Silueta.astro";
---

<Base title="Página no encontrada">
  <section class="section nf">
    <div class="container">
      <div class="panel on-celadon sin-fondo">
        <Silueta gato="maddy" size="clamp(9rem, 18vw, 13rem)" class="nf-maddy" />
        <p class="eyebrow">Error 404</p>
        <h1>Esta página se ha quedado <em>dormida</em>.</h1>
        <p class="lead">Como Maddy en su cornisa: no hay quien la despierte. No pasa nada, a veces perderse también es parte del camino.</p>
        <div class="btns">
          <a class="btn" href="/">Volver al inicio <Icon name="arrow" class="arrow" /></a>
          <a class="btn ghost" href="/contacto">Contactar</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .panel::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--celadon);
    -webkit-mask: var(--m-forma-1) 0 0 / 100% 100% no-repeat;
    mask: var(--m-forma-1) 0 0 / 100% 100% no-repeat;
  }
  .nf {
    padding-top: clamp(7rem, 12vw, 10rem);
  }
  .panel {
    position: relative;
    display: grid;
    gap: 1.4rem;
    justify-items: start;
    padding: clamp(2.5rem, 6vw, 5rem);
    isolation: isolate;
    background: transparent;
  }
  .panel :global(.nf-maddy) {
    right: clamp(2rem, 10vw, 8rem);
    bottom: calc(100% - 0.4rem);
  }
  h1 {
    max-width: 14ch;
  }
  .btns {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
