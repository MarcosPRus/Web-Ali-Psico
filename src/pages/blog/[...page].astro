---
import { getCollection } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import type { CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import PostCard from "../../components/PostCard.astro";
import Portada from "../../components/Portada.astro";
import Icon from "../../components/Icon.astro";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = (await getCollection("blog", (p) => !p.data.draft)).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );
  return paginate(posts, { pageSize: 12 });
}) satisfies GetStaticPaths;

const { page } = Astro.props as { page: Page<CollectionEntry<"blog">> };
const [featured, ...rest] = page.currentPage === 1 ? page.data : [undefined, ...page.data];
const categories = [...new Set(page.data.map((p) => p.data.category))];
---

<Base
  title="Blog"
  description="Artículos sobre relación con la comida, imagen corporal, cultura de dieta y bienestar emocional, escritos por la psicóloga Alicia Lozano."
>
  <PageHero eyebrow="Blog" crumbs={[{ label: "Blog" }]}>
    Lecturas para <em>mirarte con más calma</em>
    <Fragment slot="lead">
      Reflexiones, herramientas y un poco de mirada crítica sobre la comida, el cuerpo y todo lo que nos cuentan de ellos.
    </Fragment>
  </PageHero>

  <section class="section" style="padding-top:0">
    <div class="container">
      {
        featured && (
          <article class="featured" data-reveal>
            <Portada src={featured.data.heroImage} alt={featured.data.title} category={featured.data.category} forma="--forma-bloque-b" class="f-img" loading="eager" />
            <div class="f-copy">
              <p class="eyebrow">Último artículo</p>
              <h2>
                <a href={`/blog/${featured.id}`}>{featured.data.title}</a>
              </h2>
              <p class="lead">{featured.data.description}</p>
              <span class="btn ghost" aria-hidden="true">
                Leer artículo <Icon name="arrow" class="arrow" />
              </span>
            </div>
          </article>
        )
      }

      <div class="filters" role="group" aria-label="Filtrar por tema" data-filters>
        <button type="button" aria-pressed="true" data-cat="*">Todos</button>
        {categories.map((c) => <button type="button" aria-pressed="false" data-cat={c}>{c}</button>)}
      </div>

      <div class="grid" data-grid>
        {
          rest.map((p, i) =>
            p ? (
              <div data-cat={p.data.category}>
                <PostCard post={p} index={i} />
              </div>
            ) : null,
          )
        }
      </div>

      {
        page.lastPage > 1 && (
          <nav class="pager" aria-label="Paginación">
            {page.url.prev ? <a class="btn ghost" href={page.url.prev}>← Más recientes</a> : <span />}
            <span class="muted">
              Página {page.currentPage} de {page.lastPage}
            </span>
            {page.url.next ? <a class="btn ghost" href={page.url.next}>Anteriores →</a> : <span />}
          </nav>
        )
      }
    </div>
  </section>
</Base>

<script>
  const wrap = document.querySelector<HTMLElement>("[data-filters]");
  const items = document.querySelectorAll<HTMLElement>("[data-grid] > [data-cat]");
  wrap?.querySelectorAll<HTMLButtonElement>("button").forEach((b) =>
    b.addEventListener("click", () => {
      const cat = b.dataset.cat;
      wrap.querySelectorAll("button").forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
      items.forEach((it) => (it.hidden = cat !== "*" && it.dataset.cat !== cat));
      // la primera vez, featured incluido: mostramos también los artículos ya revelados
      items.forEach((it) => it.querySelector("[data-reveal]")?.classList.add("is-in"));
    }),
  );
</script>

<style>
  .featured {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: 2rem;
    align-items: center;
    padding-bottom: clamp(3rem, 6vw, 4.5rem);
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
    background: var(--trazo) 0 100% / 100% 9px no-repeat;
  }
  .featured :global(.f-img) {
    grid-column: 1 / span 6;
  }
  .f-copy {
    grid-column: 8 / span 5;
    display: grid;
    gap: 1.1rem;
    justify-items: start;
  }
  .f-copy h2 {
    font-size: clamp(2rem, 1.5rem + 1.8vw, 3.25rem);
  }
  .f-copy h2 a {
    text-decoration: none;
  }
  .f-copy h2 a::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .featured:hover :global(.f-img img),
  .featured:hover :global(.f-img .etiqueta) {
    transform: scale(1.03);
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .filters button {
    min-height: 2.75rem;
    padding: 0 1.1rem;
    background: var(--o-pill-1) 0 0 / 100% 100% no-repeat, var(--bg-c, transparent);
    -webkit-mask: var(--m-pill-1) 0 0 / 100% 100% no-repeat;
    mask: var(--m-pill-1) 0 0 / 100% 100% no-repeat;
    font-size: var(--t-sm);
    font-weight: 500;
    transition: background-color 0.25s, color 0.25s;
  }
  .filters button:nth-child(3n) {
    background-image: var(--o-pill-2);
    -webkit-mask-image: var(--m-pill-2);
    mask-image: var(--m-pill-2);
  }
  .filters button:nth-child(3n + 1) {
    background-image: var(--o-pill-3);
    -webkit-mask-image: var(--m-pill-3);
    mask-image: var(--m-pill-3);
  }
  .filters button:hover {
    --bg-c: var(--hueso);
  }
  .filters button[aria-pressed="true"] {
    background-image: none;
    background-color: var(--tinta);
    color: var(--blanco);
  }
  .filters button:focus-visible {
    -webkit-mask: none;
    mask: none;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(2.5rem, 5vw, 3.5rem) var(--col-gap);
  }
  .grid > [hidden] {
    display: none;
  }
  .pager {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 4rem;
  }
  @media (max-width: 60rem) {
    .featured :global(.f-img),
    .f-copy {
      grid-column: 1 / -1;
    }
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 36rem) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
