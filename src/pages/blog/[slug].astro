---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import Media from "../../components/art/Media.astro";
import Art from "../../components/art/Art.astro";
import PostCard from "../../components/PostCard.astro";
import CtaBand from "../../components/CtaBand.astro";
import Icon from "../../components/Icon.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", (p) => !p.data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: CollectionEntry<"blog"> };
const d = post.data;
const { Content } = await render(post);
const fmt = (x: Date) => x.toLocaleDateString("es-ES", { day: "numeric", month: "long", year: "numeric" });
const minutes = Math.max(2, Math.round((post.body ?? "").split(/\s+/).length / 200));
const related = (await getCollection("blog", (p) => !p.data.draft && p.id !== post.id))
  .sort((a, b) => Number(b.data.category === d.category) - Number(a.data.category === d.category) || b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<Base title={d.title} description={d.description} type="article" image={d.heroImage}>
  <article>
    <header class="post-head">
      <div class="container narrow head">
        <nav class="crumbs" aria-label="Migas de pan" data-reveal>
          <a href="/">Inicio</a><span>/</span><a href="/blog">Blog</a>
        </nav>
        <p class="eyebrow" data-reveal>{d.category}</p>
        <h1 data-reveal style="--d:1">{d.title}</h1>
        <p class="lead" data-reveal style="--d:2">{d.description}</p>
        <p class="meta" data-reveal style="--d:3">
          <span class="by">
            <span class="avatar"><Art scene="retrato" /></span>
            Alicia Lozano
          </span>
          <span>·</span>
          <time datetime={d.pubDate.toISOString()}>{fmt(d.pubDate)}</time>
          <span>·</span>
          <span>{minutes} min de lectura</span>
        </p>
      </div>
      <div class="container cover" data-reveal style="--d:2">
        <Media scene={d.scene} src={d.heroImage} ratio="16 / 8" loading="eager" alt={d.heroImage ? d.title : ""} />
      </div>
    </header>

    <div class="container narrow">
      <div class="prose body">
        <Content />
      </div>

      <aside class="author" aria-label="Sobre la autora">
        <span class="author-img"><Art scene="retrato" /></span>
        <div>
          <p class="eyebrow">Escrito por</p>
          <p class="name">Alicia Lozano</p>
          <p class="muted">
            Psicóloga sanitaria especializada en TCA, imagen corporal y psiconutrición. Consulta en Tomares, Dos
            Hermanas, Mairena y online.
          </p>
          <a href="/sobre-mi" class="link">Conóceme <Icon name="arrow" size={16} /></a>
        </div>
      </aside>
      <p class="disclaimer muted">
        Este artículo es divulgativo y no sustituye una valoración profesional individual.
      </p>
    </div>
  </article>

  <section class="section related">
    <div class="container wide">
      <h2 class="h3" data-reveal>Seguir leyendo</h2>
      <div class="grid">
        {related.map((p, i) => <PostCard post={p} index={i} />)}
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .post-head {
    position: relative;
    margin-top: calc(-1 * var(--header-h));
    padding-top: calc(var(--header-h) + clamp(2rem, 4vw, 3.5rem));
    background: radial-gradient(50% 45% at 50% 0%, color-mix(in oklab, var(--blush) 80%, transparent), transparent 80%);
  }
  .head {
    display: grid;
    gap: 1.25rem;
    justify-items: center;
    text-align: center;
  }
  .crumbs {
    display: flex;
    gap: 0.5rem;
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  .crumbs a {
    text-decoration: none;
  }
  h1 {
    font-size: var(--step-4);
    max-width: 20ch;
  }
  .lead {
    max-width: 40ch;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  .by {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    color: var(--ink);
  }
  .avatar,
  .author-img {
    display: block;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    overflow: hidden;
    flex: none;
  }
  .avatar :global(svg),
  .author-img :global(svg) {
    width: 100%;
    height: 100%;
  }
  .cover {
    margin-top: clamp(2rem, 5vw, 3.5rem);
  }
  .cover :global(.frame) {
    border-radius: calc(var(--radius-lg) * 1.3);
  }
  .body {
    padding-block: clamp(3rem, 6vw, 5rem) 2rem;
  }
  .body > :global(p:first-child::first-letter) {
    float: left;
    font-family: var(--serif);
    font-size: 4.4em;
    line-height: 0.8;
    padding: 0.08em 0.12em 0 0;
    color: var(--terracotta);
  }
  .author {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
    margin-top: 3rem;
    padding: 2rem;
    border-radius: var(--radius-lg);
    background: var(--paper);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .author-img {
    width: 5rem;
    height: 5rem;
  }
  .author > div {
    display: grid;
    gap: 0.4rem;
    justify-items: start;
  }
  .name {
    font-family: var(--serif);
    font-size: var(--step-2);
    line-height: 1.1;
  }
  .disclaimer {
    margin-top: 1.25rem;
    font-size: 0.88rem;
    text-align: center;
  }
  .related h2 {
    margin-bottom: 2rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }
  @media (max-width: 60rem) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 40rem) {
    .grid {
      grid-template-columns: 1fr;
    }
    .author {
      flex-direction: column;
    }
  }
</style>
