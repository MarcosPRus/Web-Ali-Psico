---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import Portada from "../../components/Portada.astro";
import PostCard from "../../components/PostCard.astro";
import CtaBand from "../../components/CtaBand.astro";
import Icon from "../../components/Icon.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", (p) => !p.data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: CollectionEntry<"blog"> };
const d = post.data;
const { Content } = await render(post);
const related = (await getCollection("blog", (p) => !p.data.draft && p.id !== post.id))
  .sort((a, b) => Number(b.data.category === d.category) - Number(a.data.category === d.category) || b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<Base title={d.title} description={d.description} type="article" image={d.heroImage}>
  <article>
    <header class="post-head">
      <div class="container narrow head">
        <nav class="crumbs" aria-label="Migas de pan" data-reveal>
          <a href="/">Inicio</a><span>/</span><a href="/blog">Blog</a>
        </nav>
        <p class="eyebrow" data-reveal>{d.category}</p>
        <h1 data-reveal style="--d:1">{d.title}</h1>
        <p class="lead" data-reveal style="--d:2">{d.description}</p>
        <p class="meta" data-reveal style="--d:3">
          <span class="by">
            <img class="avatar" src="/img/ali-avatar.webp" alt="" width="32" height="32" />
            Alicia Lozano
          </span>
        </p>
      </div>
      {
        d.heroImage && (
          <div class="container cover" data-reveal style="--d:2">
            <Portada src={d.heroImage} alt={d.title} category={d.category} ratio="16 / 8" forma="--forma-bloque" loading="eager" />
          </div>
        )
      }
    </header>

    <div class="container narrow">
      <div class="prose body">
        <Content />
      </div>

      <aside class="author" aria-label="Sobre la autora">
        <img class="author-img" src="/img/ali-avatar.webp" alt="Alicia Lozano" width="80" height="80" loading="lazy" />
        <div>
          <p class="eyebrow">Escrito por</p>
          <p class="name">Alicia Lozano</p>
          <p class="muted">
            Psicóloga sanitaria especializada en TCA, imagen corporal y psiconutrición. Consulta en Tomares, Dos
            Hermanas, Mairena y online.
          </p>
          <a href="/sobre-mi" class="link">Conóceme <Icon name="arrow" size={16} /></a>
        </div>
      </aside>
      <p class="disclaimer muted">
        Este artículo es divulgativo y no sustituye una valoración profesional individual.
      </p>
    </div>
  </article>

  <section class="section related">
    <div class="container">
      <h2 class="h3" data-reveal>Seguir leyendo</h2>
      <div class="grid">
        {related.map((p, i) => <PostCard post={p} index={i} />)}
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .post-head {
    padding-top: clamp(2.5rem, 5vw, 4rem);
  }
  .head {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
    padding-bottom: clamp(2rem, 4vw, 3rem);
    background: var(--trazo) 0 100% / 100% 9px no-repeat;
  }
  .crumbs {
    display: flex;
    gap: 0.5rem;
    font-size: var(--t-sm);
    color: var(--gris);
  }
  .crumbs a {
    text-decoration: none;
  }
  .crumbs a:hover {
    text-decoration: underline;
  }
  h1 {
    font-size: clamp(2.5rem, 1.6rem + 3.4vw, 4.25rem);
    line-height: 1;
    max-width: 20ch;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--t-sm);
    color: var(--gris);
  }
  .by {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    color: var(--tinta);
  }
  .avatar {
    width: 2rem;
    height: 2rem;
    border-radius: var(--mota);
    object-fit: cover;
  }
  .cover {
    margin-top: 2.5rem;
  }
  .body {
    padding-block: clamp(2.5rem, 5vw, 4rem) 2rem;
  }
  .body > :global(p:first-child) {
    font-size: 1.2em;
    line-height: 1.55;
    color: var(--tinta);
  }
  .author {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    padding: 1.75rem;
    -webkit-mask: var(--m-forma-2) 0 0 / 100% 100% no-repeat;
    mask: var(--m-forma-2) 0 0 / 100% 100% no-repeat;
    background: var(--celadon);
  }
  .author-img {
    width: 5rem;
    height: 5rem;
    flex: none;
    border-radius: var(--mota-b);
    object-fit: cover;
  }
  .author .name {
    font-size: var(--t-h3);
    font-weight: 500;
    letter-spacing: -0.02em;
    margin-block: 0.2rem 0.4rem;
  }
  .author .muted {
    color: var(--tinta);
    margin-bottom: 0.75rem;
  }
  .disclaimer {
    font-size: var(--t-xs);
    margin-top: 1.5rem;
  }
  .related {
    padding-bottom: 0;
  }
  .related h2 {
    margin-bottom: 2rem;
    padding-top: 1rem;
    background: var(--trazo) 0 0 / 100% 9px no-repeat;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.5rem var(--col-gap);
  }
  @media (max-width: 56rem) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
