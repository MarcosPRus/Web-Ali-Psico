---
import Base from "../layouts/Base.astro";
import SectionHead from "../components/SectionHead.astro";
import CtaBand from "../components/CtaBand.astro";
import Icon from "../components/Icon.astro";
import Silueta from "../components/Silueta.astro";

const timeline = [
  { year: "2019", title: "Grado en Psicología", place: "Universidad de Sevilla" }, // PROVISIONAL: confirmar universidad
  { year: "2021", title: "Máster en Psicología General Sanitaria", place: "Universidad de Granada" },
  { year: "2022", title: "Experto en Trastornos de la Conducta Alimentaria y Obesidad", place: "Universidad Pablo de Olavide" },
  {
    year: "+",
    title: "Cursos de especialización",
    place: "Imagen corporal · Terapia de aceptación y compromiso (ACT) · Psiconutrición",
  },
  { year: "Hoy", title: "Formación continua y supervisión clínica", place: "Porque cada persona me enseña algo nuevo" },
];

const galeria = [
  { src: "/img/ali-retrato.webp", alt: "Alicia Lozano en su despacho", forma: "arco" },
  { src: "/img/taller/cuenco-flores-caladas.webp", alt: "Cuenco de cerámica verde agua con el borde ondulado y flores caladas, hecho por Alicia", forma: "mota" },
  { src: "/img/gatos/maddy-retrato.webp", alt: "Maddy, la gata blanca y negra de pelo largo de Alicia", forma: "arco-inv" },
  { src: "/img/taller/saleros-gatos.webp", alt: "Dos saleros de cerámica con forma de gato hechos por Alicia", forma: "mota-b" },
  { src: "/img/gatos/furi-bebe.webp", alt: "Furi de cachorro, un gatito negro sentado en el sofá", forma: "arco" },
];

// Detalles personales. Los que tienen `img` ocupan dos filas en la cuadrícula.
type Fact = { t: string; img?: string; alt?: string };
const facts: Fact[] = [
  {
    t: "Tengo dos gatos: Maddy, la mayor, elegante e independiente, y Furi, un gato negro que encontramos asustado en el motor de un coche. Si se cuelan en la consulta online, ya sabes quiénes son.",
    img: "/img/gatos/maddy-y-furi-siesta.webp",
    alt: "Maddy, blanca y negra de pelo largo, y Furi, negro, durmiendo juntos sobre una colcha de flores",
  },
  { t: "Desayuno sin prisa siempre que puedo. Es mi momento sagrado del día." },
  { t: "Amante del café: el primero de la mañana no se negocia." },
  {
    t: "Soy ceramista aficionada. Mancharme las manos de barro es mi forma favorita de desconectar.",
    img: "/img/taller/jarron-arco.webp",
    alt: "Jarrón de cerámica blanco con forma de arco y flores amarillas, hecho por Alicia",
  },
  { t: "Leo novelas antes de dormir y subrayo frases que luego acaban en consulta." },
  { t: "Creo que comer con quienes quieres es una de las mejores cosas de la vida." },
];
const formas = ["--forma-1", "--forma-2", "--forma-3", "--forma-4", "--forma-1", "--forma-2"];
---

<Base
  title="Sobre mí"
  description="Soy Alicia Lozano, psicóloga sanitaria especializada en TCA, imagen corporal y psiconutrición. Conoce mi historia, mi formación y cómo trabajo."
>
  <section class="intro">
    <div class="container">
      <nav aria-label="Migas de pan" class="crumbs" data-reveal><a href="/">Inicio</a> <span>/</span> <span aria-current="page">Sobre mí</span></nav>
      <h1 data-reveal style="--d:1">Soy Alicia Lozano<span class="azul">.</span></h1>
      <div class="g12 intro-grid">
        <p class="big" data-reveal style="--d:2">
          Psicóloga sanitaria, especializada en trastornos de la conducta alimentaria e imagen corporal. Y, antes que
          nada, una persona que cree que todas merecemos <em>una relación tranquila con la comida y con nuestro cuerpo</em>.
        </p>
        <div class="intro-side" data-reveal style="--d:3">
          <p class="muted">
            Acompaño a adolescentes y personas adultas en Tomares, Dos Hermanas, Mairena del Aljarafe y online. Mi
            trabajo combina rigor científico, perspectiva de género y mucha, mucha escucha.
          </p>
          <a href="/contacto" class="btn">Pide tu primera cita <Icon name="arrow" class="arrow" /></a>
        </div>
      </div>
    </div>

    <ul class="strip" aria-label="Mi día a día: consulta, taller y gatos">
      {
        galeria.map((g, i) => (
          <li class={`f-${g.forma}`} data-reveal style={`--d:${i}`}>
            <img src={g.src} alt={g.alt} loading={i < 3 ? "eager" : "lazy"} decoding="async" width="600" height="750" />
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section story">
    <div class="container g12">
      <div class="story-aside">
        <p class="eyebrow" data-reveal>Mi historia</p>
        <h2 data-reveal style="--d:1">Por qué hago <em>lo que hago</em></h2>
      </div>
      <div class="prose" data-reveal style="--d:1">
        <p>
          Siempre he sentido curiosidad por entender el <em>porqué</em> de las cosas. Por qué pensamos lo que pensamos,
          por qué sentimos lo que sentimos y por qué, a veces, hacemos cosas que nos hacen daño aunque sepamos que no nos
          convienen.
        </p>
        <p>
          Durante la carrera empecé a darme cuenta de algo que me removió: muchas de las mujeres que conocía (amigas,
          compañeras, familiares) vivían en guerra con la comida y con su cuerpo. Dietas eternas, culpa después de comer,
          fotos borradas, planes cancelados. Y casi siempre se vivía en silencio, como algo normal.
        </p>
        <blockquote>No es normal sufrir para comer. Es frecuente, que es muy distinto.</blockquote>
        <p>
          Por eso decidí especializarme en <strong>trastornos de la conducta alimentaria</strong>, imagen corporal y
          psiconutrición. Desde entonces he acompañado a muchas personas en su proceso, y cada una me ha confirmado lo
          mismo: <strong>la recuperación es posible</strong>, y se construye desde la comprensión, no desde el castigo.
        </p>
        <p>
          Hoy trabajo desde un enfoque integrador basado en la evidencia (terapia cognitivo-conductual, ACT, DBT y terapia
          centrada en la compasión) y siempre con una mirada crítica hacia la cultura de la dieta y los ideales de belleza
          que tanto nos pesan.
        </p>
        <p>
          Mi consulta quiere ser eso: un lugar tranquilo donde puedas soltar, entenderte y empezar a vivir con más espacio
          para todo lo demás.
        </p>
      </div>
    </div>
  </section>

  <section class="bloque on-cobalto formacion" aria-labelledby="form-title">
    <Silueta gato="furi" class="form-furi" />
    <div class="container g12">
      <div class="form-head">
        <p class="eyebrow" data-reveal>Formación</p>
        <h2 id="form-title" data-reveal style="--d:1">Aprender <em>nunca se acaba</em></h2>
        <p class="lead" data-reveal style="--d:2">Psicóloga General Sanitaria colegiada, nº&nbsp;AN-11007.</p>
      </div>
      <ol class="timeline">
        {
          timeline.map((t, i) => (
            <li data-reveal style={`--d:${i % 3}`}>
              <span class="year">{t.year}</span>
              <div>
                <h3>{t.title}</h3>
                <p>{t.place}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section facts">
    <div class="container">
      <SectionHead eyebrow="Fuera de consulta">
        Y si todavía quieres <em>saber más de mí</em>…
      </SectionHead>
      <ul class="facts-grid">
        {
          facts.map((f, i) => (
            <li class:list={[f.img && "has-img"]} data-reveal style={`--d:${i % 4};border-radius:var(${formas[i]})`}>
              {f.img && <img src={f.img} alt={f.alt} loading="lazy" decoding="async" />}
              <p>{f.t}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand title="¿Empezamos a conocernos?" />
</Base>

<style>
  .intro {
    padding-top: clamp(2.5rem, 5vw, 4rem);
  }
  .crumbs {
    display: flex;
    gap: 0.5rem;
    font-size: var(--t-sm);
    color: var(--gris);
    margin-bottom: 1.25rem;
  }
  .crumbs a {
    text-decoration: none;
  }
  .crumbs a:hover {
    text-decoration: underline;
  }
  h1 {
    font-size: clamp(3.25rem, 1rem + 9vw, 9rem);
    line-height: 0.9;
    letter-spacing: -0.055em;
  }
  .azul {
    color: var(--cobalto);
  }
  .intro-grid {
    margin-top: clamp(2rem, 4vw, 3rem);
    row-gap: 2rem;
    align-items: end;
  }
  .big {
    grid-column: 1 / span 7;
    font-size: clamp(1.375rem, 1.1rem + 1vw, 2rem);
    line-height: 1.3;
    letter-spacing: -0.02em;
  }
  .big em {
    font-style: normal;
    color: var(--cobalto);
  }
  .intro-side {
    grid-column: 9 / span 4;
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }
  .strip {
    list-style: none;
    padding: 0 var(--gutter);
    margin: clamp(3rem, 6vw, 5rem) auto 0;
    max-width: 96rem;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--col-gap);
    align-items: center;
  }
  .strip li {
    overflow: hidden;
    background: var(--hueso);
  }
  .strip li:nth-child(even) {
    margin-top: 3rem;
  }
  .strip img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease);
  }
  .strip li:hover img {
    transform: scale(1.05);
  }
  .f-arco {
    aspect-ratio: 3 / 4;
    clip-path: var(--arco);
  }
  .f-arco-inv {
    aspect-ratio: 3 / 4;
    clip-path: var(--arco-inv);
  }
  .f-mota {
    aspect-ratio: 1;
    border-radius: var(--mota);
  }
  .f-mota-b {
    aspect-ratio: 1;
    border-radius: var(--mota-b);
  }

  .story .g12 {
    row-gap: 2rem;
    align-items: start;
  }
  .story-aside {
    grid-column: 1 / span 4;
    position: sticky;
    top: 7rem;
    display: grid;
    gap: 1rem;
  }
  .story .prose {
    grid-column: 6 / span 7;
    max-width: 40rem;
  }

  .formacion :global(.form-furi) {
    left: clamp(3rem, 14vw, 12rem);
    bottom: calc(100% - 0.4rem);
  }
  .formacion .g12 {
    row-gap: 2.5rem;
  }
  .form-head {
    grid-column: 1 / span 5;
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }
  .timeline {
    grid-column: 7 / span 6;
    list-style: none;
    padding: 0;
    border-top: 2px solid var(--blanco);
  }
  .timeline li {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 1rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid rgb(255 255 255 / 0.3);
  }
  .year {
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--cobalto-suave);
  }
  .timeline h3 {
    font-size: var(--t-lg);
    letter-spacing: -0.01em;
  }
  .timeline p {
    color: var(--cobalto-suave);
    font-size: var(--t-sm);
    margin-top: 0.2rem;
  }

  .facts-grid {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-flow: dense;
    gap: var(--col-gap);
  }
  .facts-grid li {
    display: grid;
    align-content: space-between;
    gap: 1.25rem;
    padding: 1.6rem;
    background: var(--hueso);
    overflow: hidden;
    transition: transform 0.4s var(--ease), background-color 0.3s;
  }
  .facts-grid li:hover {
    transform: translateY(-4px) rotate(-0.5deg);
  }
  .facts-grid li.has-img {
    grid-row: span 2;
    background: var(--celadon);
  }
  .facts-grid li:not(.has-img)::before {
    content: "";
    width: 1.4rem;
    height: 1.2rem;
    border-radius: var(--mota);
    background: var(--cobalto);
  }
  .facts-grid img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--mota-b);
  }
  .facts-grid p {
    font-size: var(--t-lg);
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  @media (max-width: 60rem) {
    .big,
    .intro-side,
    .story-aside,
    .story .prose,
    .form-head,
    .timeline {
      grid-column: 1 / -1;
    }
    .story-aside {
      position: static;
    }
    .strip {
      grid-template-columns: repeat(5, 62%);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: 1rem;
    }
    .strip li {
      scroll-snap-align: center;
    }
    .facts-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 36rem) {
    .facts-grid {
      grid-template-columns: 1fr;
    }
    .facts-grid li.has-img {
      grid-row: auto;
    }
  }
</style>
