---
import Base from "../layouts/Base.astro";
import Media from "../components/art/Media.astro";
import Shape from "../components/art/Shape.astro";
import SectionHead from "../components/SectionHead.astro";
import CtaBand from "../components/CtaBand.astro";
import Icon from "../components/Icon.astro";

const timeline = [
  { year: "2019", title: "Grado en Psicología", place: "Universidad de Sevilla" }, // PROVISIONAL: confirmar universidad
  { year: "2021", title: "Máster en Psicología General Sanitaria", place: "Universidad de Granada" },
  { year: "2022", title: "Experto en Trastornos de la Conducta Alimentaria y Obesidad", place: "Universidad Pablo de Olavide" },
  {
    year: "&",
    title: "Cursos de especialización",
    place: "Imagen corporal · Terapia de aceptación y compromiso (ACT) · Psiconutrición… Distintas miradas para acompañarte mejor",
  },
  { year: "Hoy", title: "Formación continua y supervisión clínica", place: "Porque cada persona me enseña algo nuevo" },
];

// Detalles personales. Los que tienen `img` ocupan dos filas en la cuadrícula.
type Fact = { t: string; s: "sun" | "leaf" | "flower" | "blob" | "star"; c: string; img?: string; alt?: string };
const facts: Fact[] = [
  {
    t: "Tengo dos gatos, por si alguna vez se pasan a saludar durante la consulta online.",
    s: "blob",
    c: "var(--blush)",
    img: "/img/gatos.webp",
    alt: "Los dos gatos de Alicia, uno blanco y negro y otro negro, sentados en el pasillo",
  },
  { t: "Desayuno sin prisa siempre que puedo. Es mi momento sagrado del día.", s: "sun", c: "var(--butter)" },
  { t: "Amante del café: el primero de la mañana no se negocia.", s: "star", c: "var(--terracotta)" },
  {
    t: "Soy ceramista aficionada. Mancharme las manos de barro es mi forma favorita de desconectar.",
    s: "sun",
    c: "var(--sage)",
    img: "/img/tetera-ceramica.webp",
    alt: "Tetera de cerámica blanca con motas negras hecha por Alicia",
  },
  { t: "Leo novelas antes de dormir y subrayo frases que luego acaban en consulta.", s: "leaf", c: "var(--lilac-2)" },
  { t: "Creo que comer con quienes quieres es una de las mejores cosas de la vida.", s: "flower", c: "var(--rose)" },
];
---

<Base
  title="Sobre mí"
  description="Soy Alicia Lozano, psicóloga sanitaria en Sevilla y online. Acompaño en ansiedad, autoestima, relaciones y gestión emocional, con especialización en TCA e imagen corporal."
>
  <section class="intro">
    <div class="bg" aria-hidden="true"></div>
    <div class="container wide">
      <nav aria-label="Migas de pan" class="crumbs" data-reveal><a href="/">Inicio</a> <span>/</span> <span aria-current="page">Sobre mí</span></nav>
      <h1 class="hello" data-reveal style="--d:1">Soy Alicia<span class="comma">,</span></h1>
      <div class="intro-grid">
        <p class="big" data-reveal style="--d:2">
          psicóloga sanitaria. Te acompaño cuando la ansiedad, la autoexigencia, la autoestima o tus relaciones pesan
          más de la cuenta, o cuando la comida y el cuerpo se han vuelto un problema. <em
            >Sea lo que sea lo que te trae, aquí hay sitio para hablarlo con calma.</em
          >
        </p>
        <div class="intro-side" data-reveal style="--d:3">
          <p>
            Atiendo a adolescentes y personas adultas en Tomares, Dos Hermanas, Mairena del Aljarafe y online. Estoy
            especializada en trastornos de la conducta alimentaria, y trabajo con rigor científico, perspectiva de
            género y mucha, mucha escucha.
          </p>
          <a href="/contacto" class="btn">Pide tu primera cita <Icon name="arrow" class="arrow" /></a>
        </div>
      </div>
    </div>

    <div class="strip" aria-label="Fotos de Alicia">
      <Media scene="jardin" ratio="3 / 4" class="s1" loading="eager" />
      <Media src="/img/fotos/sobre-mi-2.webp" ratio="3 / 4" class="s2" alt="Alicia en su escritorio, tomando notas" loading="eager" />
      <Media scene="taza" ratio="3 / 4" class="s3" loading="eager" />
      <Media src="/img/fotos/sobre-mi-4.webp" ratio="3 / 4" class="s4" alt="Alicia leyendo en un sillón junto a la ventana" loading="eager" />
      <Media scene="ventana" ratio="3 / 4" class="s5" loading="eager" />
    </div>
  </section>

  <section class="section training on-dark">
    <div class="container wide train-grid">
      <div>
        <p class="eyebrow" data-reveal>Formación</p>
        <h2 data-reveal style="--d:1">Aprender <em>nunca se acaba</em></h2>
        <p class="lead" data-reveal style="--d:2">
          Psicóloga General Sanitaria colegiada, nº&nbsp;AN-11007.
        </p>
      </div>
      <ol class="timeline">
        {
          timeline.map((t, i) => (
            <li data-reveal style={`--d:${i % 3}`}>
              <span class="year">{t.year}</span>
              <div>
                <h3>{t.title}</h3>
                <p>{t.place}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section facts">
    <div class="container wide">
      <SectionHead eyebrow="Fuera de consulta" align="center">
        Y si todavía quieres <em>saber más de mí</em>…
      </SectionHead>
      <ul class="facts-grid">
        {
          facts.map((f, i) => (
            <li
              class:list={[f.img && "has-img"]}
              data-reveal
              style={`--d:${i % 4};--rot:${[-1.2, 1, -0.6, 1.4, -1, 0.8][i]}deg`}
            >
              {f.img ? (
                <img src={f.img} alt={f.alt} loading="lazy" decoding="async" />
              ) : (
                <Shape name={f.s} color={f.c} size="3.2rem" />
              )}
              <p>{f.t}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand title="¿Empezamos a conocernos?" />
</Base>

<style>
  .intro {
    position: relative;
    margin-top: calc(-1 * var(--header-h));
    padding-top: calc(var(--header-h) + clamp(2rem, 4vw, 3.5rem));
    padding-bottom: clamp(3rem, 7vw, 6rem);
    overflow: clip;
  }
  .intro .bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(50% 60% at 90% 10%, var(--blush), transparent 70%),
      radial-gradient(40% 50% at 5% 30%, color-mix(in oklab, var(--lilac) 60%, transparent), transparent 70%);
    z-index: -1;
  }
  .crumbs {
    display: flex;
    gap: 0.5rem;
    font-size: var(--step--1);
    color: var(--ink-2);
    margin-bottom: 1rem;
  }
  .crumbs a {
    text-decoration: none;
  }
  .hello {
    font-size: clamp(4.2rem, 1rem + 13vw, 13rem);
    font-weight: 300;
    line-height: 0.88;
    letter-spacing: -0.055em;
  }
  .comma {
    color: var(--terracotta);
    font-style: italic;
  }
  .intro-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 2rem clamp(2rem, 6vw, 6rem);
    align-items: end;
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
  }
  .big {
    font-family: var(--serif);
    font-size: var(--step-2);
    font-weight: 330;
    line-height: 1.35;
    max-width: 34ch;
  }
  .big em {
    color: var(--lilac-ink);
  }
  .intro-side {
    display: grid;
    gap: 1.4rem;
    justify-items: start;
    color: var(--ink-2);
  }
  .strip {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: clamp(0.5rem, 1.2vw, 1rem);
    padding: clamp(3rem, 6vw, 5rem) clamp(0.5rem, 1.2vw, 1rem) 0;
    align-items: end;
  }
  .strip :global(.frame) {
    border-radius: var(--radius-lg);
  }
  .strip :global(.s1) {
    border-radius: var(--arch);
  }
  .strip :global(.s2) {
    translate: 0 -2rem;
  }
  .strip :global(.s3) {
    border-radius: 50% 50% var(--radius-lg) var(--radius-lg) / 30% 30% var(--radius-lg) var(--radius-lg);
  }
  .strip :global(.s4) {
    translate: 0 -3rem;
  }
  .strip :global(.s5) {
    translate: 0 -1rem;
  }

  .training {
    border-radius: calc(var(--radius-lg) * 1.5);
    margin-inline: clamp(0.5rem, 1.5vw, 1.5rem);
  }
  .train-grid {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: clamp(2rem, 6vw, 6rem);
  }
  .train-grid h2 {
    margin-block: 1rem 1.25rem;
  }
  .timeline {
    list-style: none;
    padding: 0;
    display: grid;
  }
  .timeline li {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 1.5rem;
    padding-block: 1.5rem;
    border-top: 1px solid color-mix(in oklab, var(--oat) 18%, transparent);
  }
  .timeline li:last-child {
    border-bottom: 1px solid color-mix(in oklab, var(--oat) 18%, transparent);
  }
  .year {
    font-family: var(--serif);
    font-style: italic;
    font-size: var(--step-2);
    color: var(--blush);
    line-height: 1.1;
  }
  .timeline h3 {
    font-size: var(--step-1);
  }
  .timeline p {
    color: color-mix(in oklab, var(--oat) 70%, transparent);
    font-size: 0.95rem;
    margin-top: 0.3rem;
  }

  .facts-grid {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-flow: dense;
    gap: 1.25rem;
    align-items: stretch;
  }
  .facts-grid li.has-img {
    grid-row: span 2;
    padding: 0.75rem 0.75rem 1.5rem;
    align-content: start;
  }
  .facts-grid li.has-img p {
    padding-inline: 0.75rem;
  }
  .facts-grid img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: calc(var(--radius-lg) - 0.5rem);
  }
  .facts-grid li {
    display: grid;
    gap: 1rem;
    align-content: start;
    padding: 1.75rem;
    border-radius: var(--radius-lg);
    background: var(--paper);
    box-shadow: inset 0 0 0 1px var(--line);
    rotate: var(--rot);
    transition: rotate 0.6s var(--ease), transform 0.6s var(--ease), box-shadow 0.6s;
  }
  .facts-grid li:hover {
    rotate: 0deg;
    transform: translateY(-4px);
    box-shadow: var(--shadow);
  }
  .facts-grid p {
    font-family: var(--serif);
    font-size: var(--step-1);
    font-weight: 350;
    line-height: 1.35;
  }

  @media (max-width: 56rem) {
    .intro-grid,
    .train-grid {
      grid-template-columns: 1fr;
    }
    .strip {
      grid-template-columns: repeat(5, 42vw);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: 1rem;
      scrollbar-width: none;
    }
    .strip > :global(*) {
      scroll-snap-align: center;
      translate: none !important;
    }
    .facts-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 36rem) {
    .facts-grid {
      grid-template-columns: 1fr;
    }
    .facts-grid li.has-img {
      grid-row: auto;
    }
  }
</style>
