---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import SectionHead from "../components/SectionHead.astro";
import Locations from "../components/Locations.astro";
import Icon from "../components/Icon.astro";
import Shape from "../components/art/Shape.astro";
import { CONTACT, FORM_ACCESS_KEY, LOCATIONS } from "../consts";
---

<Base
  title="Contacto"
  description="Pide tu primera cita con Alicia Lozano, psicóloga en Tomares, Dos Hermanas, Mairena del Aljarafe y online. WhatsApp, teléfono o formulario."
>
  <PageHero
    eyebrow="Contacto"
    src="/img/fotos/contacto.webp"
    alt="Alicia con una taza junto a la ventana de su consulta"
    tone="sage"
    crumbs={[{ label: "Contacto" }]}
    compact
  >
    Hablemos. <em>Sin prisa y sin compromiso.</em>
    <Fragment slot="lead">
      Cuéntame un poco qué te trae (o solo di hola) y te responderé personalmente en menos de 48&nbsp;h laborables.
    </Fragment>
  </PageHero>

  <section class="section" style="padding-top:0">
    <div class="container wide grid">
      <div class="form-card" data-reveal>
        <Shape name="flower" color="var(--lilac)" size="5rem" class="deco float" style="--t:9s" />
        <form
          data-form
          data-key={FORM_ACCESS_KEY}
          data-email={CONTACT.email}
          action={FORM_ACCESS_KEY ? "https://api.web3forms.com/submit" : `mailto:${CONTACT.email}`}
          method="post"
        >
          <input type="hidden" name="subject" value="Nuevo mensaje desde la web" />
          <input type="checkbox" name="botcheck" class="visually-hidden" tabindex="-1" autocomplete="off" aria-hidden="true" aria-label="No marcar" />

          <div class="row">
            <label>
              <span>Nombre</span>
              <input name="nombre" type="text" autocomplete="given-name" required placeholder="¿Cómo te llamas?" />
            </label>
            <label>
              <span>Teléfono <small>(opcional)</small></span>
              <input name="telefono" type="tel" autocomplete="tel" placeholder="Por si prefieres que te llame" />
            </label>
          </div>
          <label>
            <span>Email</span>
            <input name="email" type="email" autocomplete="email" required placeholder="tu@email.com" />
          </label>

          <fieldset>
            <legend>¿Dónde te vendría mejor?</legend>
            <div class="pills">
              {
                LOCATIONS.map((l, i) => (
                  <label class="pill">
                    <input type="radio" name="modalidad" value={l.name} checked={i === 0} />
                    <span>{l.name}</span>
                  </label>
                ))
              }
              <label class="pill">
                <input type="radio" name="modalidad" value="Aún no lo sé" />
                <span>Aún no lo sé</span>
              </label>
            </div>
          </fieldset>

          <label>
            <span>Mensaje</span>
            <textarea name="mensaje" rows="5" placeholder="Puedes contarme tanto o tan poco como quieras."></textarea>
          </label>

          <label class="consent">
            <input type="checkbox" name="privacidad" required />
            <span>
              He leído y acepto la <a href="/privacidad" target="_blank">política de privacidad</a>. Tus datos solo se usarán
              para responder a tu mensaje.
            </span>
          </label>

          <button class="btn" type="submit">Enviar mensaje <Icon name="arrow" class="arrow" /></button>
          <p class="status" data-status role="status" aria-live="polite"></p>
        </form>
      </div>

      <aside class="side">
        <a class="quick wa" href={CONTACT.whatsapp} target="_blank" rel="noopener" data-reveal style="--d:1">
          <span class="ico"><Icon name="whatsapp" size={24} /></span>
          <span><strong>WhatsApp</strong><small>La forma más rápida</small></span>
          <Icon name="arrow-up-right" size={18} class="go" />
        </a>
        <a class="quick" href={CONTACT.phoneHref} data-reveal style="--d:2">
          <span class="ico"><Icon name="phone" size={22} /></span>
          <span><strong>{CONTACT.phone}</strong><small>Lunes a viernes</small></span>
          <Icon name="arrow-up-right" size={18} class="go" />
        </a>
        <a class="quick" href={`mailto:${CONTACT.email}`} data-reveal style="--d:3">
          <span class="ico"><Icon name="mail" size={22} /></span>
          <span><strong class="mail">{CONTACT.email}</strong><small>Te respondo en menos de 48 h</small></span>
          <Icon name="arrow-up-right" size={18} class="go" />
        </a>
        <div class="note" data-reveal style="--d:4">
          <p class="script">“Escribir ya es un primer paso. Y no tienes que tenerlo claro para darlo.”</p>
        </div>
      </aside>
    </div>
  </section>

  <section class="section places">
    <div class="container wide">
      <SectionHead eyebrow="Consultas">
        Ven a verme <em>o conéctate</em>
      </SectionHead>
      <Locations />
    </div>
  </section>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-form]");
  const status = document.querySelector<HTMLElement>("[data-status]");
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;
    const data = new FormData(form);
    const key = form.dataset.key;
    const btn = form.querySelector<HTMLButtonElement>("button[type=submit]")!;

    if (!key) {
      // Sin servicio de formularios: abrimos el correo con el mensaje preparado
      const body = [
        `Nombre: ${data.get("nombre")}`,
        `Email: ${data.get("email")}`,
        data.get("telefono") ? `Teléfono: ${data.get("telefono")}` : "",
        `Consulta preferida: ${data.get("modalidad")}`,
        "",
        String(data.get("mensaje") || ""),
      ]
        .filter((l) => l !== "")
        .join("\n");
      window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(
        "Primera cita · " + data.get("nombre"),
      )}&body=${encodeURIComponent(body)}`;
      if (status) status.textContent = "Se abrirá tu aplicación de correo con el mensaje preparado. Solo tienes que enviarlo.";
      return;
    }

    data.append("access_key", key);
    btn.disabled = true;
    if (status) status.textContent = "Enviando…";
    try {
      const res = await fetch("https://api.web3forms.com/submit", { method: "POST", body: data });
      const json = await res.json();
      if (!json.success) throw new Error();
      form.reset();
      form.classList.add("sent");
      if (status) status.textContent = "¡Mensaje enviado! Te responderé muy pronto. Gracias por la confianza.";
    } catch {
      if (status) status.textContent = "Vaya, algo ha fallado. Puedes escribirme directamente por WhatsApp o email.";
    } finally {
      btn.disabled = false;
    }
  });
</script>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: start;
  }
  .form-card {
    position: relative;
    padding: clamp(1.5rem, 4vw, 3rem);
    border-radius: calc(var(--radius-lg) * 1.3);
    background: #fff;
    box-shadow: var(--shadow);
  }
  .form-card :global(.deco) {
    position: absolute;
    right: -1.5rem;
    top: -2rem;
  }
  form {
    display: grid;
    gap: 1.25rem;
  }
  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }
  label:not(.pill):not(.consent) {
    display: grid;
    gap: 0.45rem;
  }
  label > span,
  legend {
    font-size: 0.9rem;
    font-weight: 600;
  }
  small {
    font-weight: 400;
    color: var(--ink-2);
  }
  input[type="text"],
  input[type="email"],
  input[type="tel"],
  textarea {
    width: 100%;
    padding: 0.9rem 1.1rem;
    border: 0;
    border-radius: 0.9rem;
    background: var(--oat);
    box-shadow: inset 0 0 0 1px var(--line);
    transition: box-shadow 0.3s, background-color 0.3s;
    font-size: 1rem;
  }
  textarea {
    resize: vertical;
    min-height: 8rem;
  }
  input::placeholder,
  textarea::placeholder {
    color: color-mix(in oklab, var(--ink-2) 75%, transparent);
  }
  input:focus,
  textarea:focus {
    outline: none;
    background: #fff;
    box-shadow: inset 0 0 0 2px var(--terracotta);
  }
  fieldset {
    border: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .pill {
    position: relative;
  }
  .pill input {
    position: absolute;
    opacity: 0;
    inset: 0;
    cursor: pointer;
  }
  .pill span {
    display: inline-block;
    padding: 0.6rem 1.05rem;
    border-radius: 999px;
    background: var(--oat);
    box-shadow: inset 0 0 0 1px var(--line);
    font-size: 0.92rem;
    font-weight: 500;
    transition: background-color 0.3s, color 0.3s;
  }
  .pill input:checked + span {
    background: var(--ink);
    color: var(--oat);
  }
  .pill input:focus-visible + span {
    outline: 2px solid var(--terracotta-ink);
    outline-offset: 2px;
  }
  .consent {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    font-size: 0.9rem;
    color: var(--ink-2);
  }
  .consent input {
    margin-top: 0.25rem;
    width: 1.1rem;
    height: 1.1rem;
    flex: none;
  }
  .consent a {
    color: var(--terracotta-ink);
  }
  form .btn {
    justify-self: start;
  }
  .status {
    min-height: 1.5em;
    font-weight: 500;
    color: var(--sage-ink);
  }
  .side {
    display: grid;
    gap: 0.9rem;
  }
  .quick {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem 1.25rem;
    border-radius: var(--radius-lg);
    background: var(--paper);
    box-shadow: inset 0 0 0 1px var(--line);
    text-decoration: none;
    transition: transform 0.5s var(--ease), box-shadow 0.5s, background-color 0.3s;
  }
  .quick:hover {
    transform: translateY(-3px);
    background: #fff;
    box-shadow: var(--shadow);
  }
  .quick > span:nth-child(2) {
    display: grid;
    flex: 1;
    min-width: 0;
  }
  .quick small {
    font-size: 0.85rem;
  }
  .mail {
    overflow-wrap: anywhere;
    font-size: 0.95rem;
  }
  .ico {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: var(--blush);
    color: var(--terracotta-ink);
    flex: none;
  }
  .wa {
    background: var(--ink);
    color: var(--oat);
  }
  .wa:hover {
    background: var(--wine);
  }
  .wa small {
    color: color-mix(in oklab, var(--oat) 70%, transparent);
  }
  .wa .ico {
    background: var(--terracotta);
    color: #fff;
  }
  .quick :global(.go) {
    opacity: 0.6;
  }
  .note {
    margin-top: 0.75rem;
    padding: 1.5rem;
    border-radius: var(--radius-lg);
    background: var(--lilac);
    font-size: var(--step-1);
    line-height: 1.35;
  }
  .places {
    background: var(--sand);
  }
  @media (max-width: 60rem) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 36rem) {
    .row {
      grid-template-columns: 1fr;
    }
  }
</style>
