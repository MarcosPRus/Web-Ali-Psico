---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import SectionHead from "../components/SectionHead.astro";
import Locations from "../components/Locations.astro";
import Icon from "../components/Icon.astro";
import Silueta from "../components/Silueta.astro";
import { CONTACT, FORM_ACCESS_KEY, LOCATIONS } from "../consts";
---

<Base
  title="Contacto"
  description="Pide tu primera cita con Alicia Lozano, psicóloga en Tomares, Dos Hermanas, Mairena del Aljarafe y online. WhatsApp, teléfono o formulario."
>
  <PageHero eyebrow="Contacto" crumbs={[{ label: "Contacto" }]}>
    Hablemos. <em>Sin prisa y sin compromiso.</em>
    <Fragment slot="lead">
      Cuéntame un poco qué te trae (o solo di hola) y te responderé personalmente en menos de 48&nbsp;h laborables.
    </Fragment>
  </PageHero>

  <section class="section" style="padding-top:0">
    <div class="container wide grid">
      <div class="form-card" data-reveal>
        <Silueta gato="furi" pose="asomado" size="clamp(4.5rem, 8vw, 5.5rem)" class="deco" />
        <form
          data-form
          data-key={FORM_ACCESS_KEY}
          data-email={CONTACT.email}
          action={FORM_ACCESS_KEY ? "https://api.web3forms.com/submit" : `mailto:${CONTACT.email}`}
          method="post"
        >
          <input type="hidden" name="subject" value="Nuevo mensaje desde la web" />
          <input type="checkbox" name="botcheck" class="visually-hidden" tabindex="-1" autocomplete="off" aria-hidden="true" aria-label="No marcar" />

          <div class="row">
            <label>
              <span>Nombre</span>
              <input name="nombre" type="text" autocomplete="given-name" required placeholder="¿Cómo te llamas?" />
            </label>
            <label>
              <span>Teléfono <small>(opcional)</small></span>
              <input name="telefono" type="tel" autocomplete="tel" placeholder="Por si prefieres que te llame" />
            </label>
          </div>
          <label>
            <span>Email</span>
            <input name="email" type="email" autocomplete="email" required placeholder="tu@email.com" />
          </label>

          <fieldset>
            <legend>¿Dónde te vendría mejor?</legend>
            <div class="pills">
              {
                LOCATIONS.map((l, i) => (
                  <label class="pill">
                    <input type="radio" name="modalidad" value={l.name} checked={i === 0} />
                    <span>{l.name}</span>
                  </label>
                ))
              }
              <label class="pill">
                <input type="radio" name="modalidad" value="Aún no lo sé" />
                <span>Aún no lo sé</span>
              </label>
            </div>
          </fieldset>

          <label>
            <span>Mensaje</span>
            <textarea name="mensaje" rows="5" placeholder="Puedes contarme tanto o tan poco como quieras."></textarea>
          </label>

          <label class="consent">
            <input type="checkbox" name="privacidad" required />
            <span>
              He leído y acepto la <a href="/privacidad" target="_blank">política de privacidad</a>. Tus datos solo se usarán
              para responder a tu mensaje.
            </span>
          </label>

          <button class="btn" type="submit">Enviar mensaje <Icon name="arrow" class="arrow" /></button>
          <p class="status" data-status role="status" aria-live="polite"></p>
        </form>
      </div>

      <aside class="side">
        <a class="quick wa" href={CONTACT.whatsapp} target="_blank" rel="noopener" data-reveal style="--d:1">
          <span class="ico"><Icon name="whatsapp" size={24} /></span>
          <span><strong>WhatsApp</strong><small>La forma más rápida</small></span>
          <Icon name="arrow-up-right" size={18} class="go" />
        </a>
        <a class="quick" href={CONTACT.phoneHref} data-reveal style="--d:2">
          <span class="ico"><Icon name="phone" size={22} /></span>
          <span><strong>{CONTACT.phone}</strong><small>Lunes a viernes</small></span>
          <Icon name="arrow-up-right" size={18} class="go" />
        </a>
        <a class="quick" href={`mailto:${CONTACT.email}`} data-reveal style="--d:3">
          <span class="ico"><Icon name="mail" size={22} /></span>
          <span><strong class="mail">{CONTACT.email}</strong><small>Te respondo en menos de 48 h</small></span>
          <Icon name="arrow-up-right" size={18} class="go" />
        </a>
        <div class="note" data-reveal style="--d:4">
          <p>«Escribir ya es un primer paso. Y no tienes que tenerlo claro para darlo.»</p>
          <p class="firma">— Alicia (y Furi, que también es tímido)</p>
        </div>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container wide">
      <SectionHead eyebrow="Consultas">
        Ven a verme <em>o conéctate</em>
      </SectionHead>
      <Locations />
    </div>
  </section>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-form]");
  const status = document.querySelector<HTMLElement>("[data-status]");
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;
    const data = new FormData(form);
    const key = form.dataset.key;
    const btn = form.querySelector<HTMLButtonElement>("button[type=submit]")!;

    if (!key) {
      // Sin servicio de formularios: abrimos el correo con el mensaje preparado
      const body = [
        `Nombre: ${data.get("nombre")}`,
        `Email: ${data.get("email")}`,
        data.get("telefono") ? `Teléfono: ${data.get("telefono")}` : "",
        `Consulta preferida: ${data.get("modalidad")}`,
        "",
        String(data.get("mensaje") || ""),
      ]
        .filter((l) => l !== "")
        .join("\n");
      window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(
        "Primera cita · " + data.get("nombre"),
      )}&body=${encodeURIComponent(body)}`;
      if (status) status.textContent = "Se abrirá tu aplicación de correo con el mensaje preparado. Solo tienes que enviarlo.";
      return;
    }

    data.append("access_key", key);
    btn.disabled = true;
    if (status) status.textContent = "Enviando…";
    try {
      const res = await fetch("https://api.web3forms.com/submit", { method: "POST", body: data });
      const json = await res.json();
      if (!json.success) throw new Error();
      form.reset();
      form.classList.add("sent");
      if (status) status.textContent = "¡Mensaje enviado! Te responderé muy pronto. Gracias por la confianza.";
    } catch {
      if (status) status.textContent = "Vaya, algo ha fallado. Puedes escribirme directamente por WhatsApp o email.";
    } finally {
      btn.disabled = false;
    }
  });
</script>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .form-card {
    position: relative;
    margin-top: 3rem;
    padding: clamp(1.5rem, 4vw, 3rem);
    border-radius: var(--forma-bloque-b);
    background: var(--hueso);
  }
  /* Furi se asoma por el borde del formulario: escribir da un poco de miedo, también a él */
  .form-card :global(.deco) {
    right: clamp(2rem, 6vw, 4rem);
    bottom: calc(100% - 0.35rem);
  }
  form {
    display: grid;
    gap: 1.25rem;
  }
  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }
  label:not(.pill):not(.consent) {
    display: grid;
    gap: 0.45rem;
  }
  label > span,
  legend {
    font-size: var(--t-sm);
    font-weight: 700;
  }
  small {
    font-weight: 400;
    color: var(--gris);
  }
  input[type="text"],
  input[type="email"],
  input[type="tel"],
  textarea {
    width: 100%;
    min-height: 3.375rem;
    padding: 0.9rem 1.1rem;
    border: 0;
    border-radius: var(--forma-campo);
    background: var(--blanco);
    box-shadow: inset 0 0 0 1.5px transparent;
    transition: box-shadow 0.25s;
    font-size: 1rem;
  }
  textarea {
    resize: vertical;
    min-height: 8rem;
  }
  input::placeholder,
  textarea::placeholder {
    color: #757575;
  }
  input:focus,
  textarea:focus {
    outline: none;
    box-shadow: inset 0 0 0 2px var(--cobalto);
  }
  fieldset {
    border: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .pill {
    position: relative;
  }
  .pill input {
    position: absolute;
    opacity: 0;
    inset: 0;
    cursor: pointer;
  }
  .pill span {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 1.1rem;
    border-radius: var(--forma-pill);
    background: var(--blanco);
    box-shadow: inset 0 0 0 1.5px var(--tinta);
    font-size: var(--t-sm);
    font-weight: 500;
    transition: background-color 0.25s, color 0.25s;
  }
  .pill input:checked + span {
    background: var(--tinta);
    color: var(--blanco);
  }
  .pill input:focus-visible + span {
    outline: 3px solid var(--cobalto);
    outline-offset: 2px;
  }
  .consent {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    font-size: var(--t-sm);
    color: var(--gris);
  }
  .consent input {
    margin-top: 0.2rem;
    width: 1.1rem;
    height: 1.1rem;
    flex: none;
  }
  .consent a {
    color: var(--cobalto);
  }
  form .btn {
    justify-self: start;
  }
  .status {
    min-height: 1.5em;
    font-weight: 700;
    color: var(--celadon-ink);
  }
  .side {
    display: grid;
    gap: 0.75rem;
    margin-top: 3rem;
  }
  .quick {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 4.5rem;
    padding: 1rem 1.25rem;
    border-radius: var(--forma-1);
    box-shadow: inset 0 0 0 1.5px var(--tinta);
    text-decoration: none;
    transition: background-color 0.25s, transform 0.4s var(--ease);
  }
  .quick:nth-child(3) {
    border-radius: var(--forma-3);
  }
  .quick:hover {
    background: var(--hueso);
    transform: translateY(-2px);
  }
  .quick > span:nth-child(2) {
    display: grid;
    flex: 1;
    min-width: 0;
  }
  .quick small {
    font-size: var(--t-xs);
  }
  .mail {
    overflow-wrap: anywhere;
    font-size: var(--t-sm);
  }
  .ico {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 2.8rem;
    border-radius: var(--mota);
    background: var(--hueso);
    flex: none;
  }
  .wa {
    background: var(--cobalto);
    color: var(--blanco);
    box-shadow: none;
    border-radius: var(--forma-2);
  }
  .wa:hover {
    background: var(--cobalto-hondo);
  }
  .wa small {
    color: var(--cobalto-suave);
  }
  .wa .ico {
    background: var(--blanco);
    color: var(--cobalto);
  }
  .quick :global(.go) {
    opacity: 0.7;
  }
  .note {
    margin-top: 0.75rem;
    padding: 1.5rem;
    border-radius: var(--forma-4);
    background: var(--celadon);
    font-size: var(--t-lg);
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }
  .firma {
    margin-top: 0.75rem;
    font-size: var(--t-sm);
    font-weight: 400;
    color: var(--celadon-ink);
  }
  @media (max-width: 60rem) {
    .grid {
      grid-template-columns: 1fr;
    }
    .side {
      margin-top: 0;
    }
  }
  @media (max-width: 34rem) {
    .row {
      grid-template-columns: 1fr;
    }
  }
</style>
